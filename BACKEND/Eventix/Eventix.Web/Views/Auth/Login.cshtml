@model Eventix.Share.Auth.LoginRequest

@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<main class="auth-page">
    <section class="auth-card">
        <h1>Welcome back</h1>
        <p class="subtitle">Login to continue with Eventix</p>

        <form asp-controller="Auth" asp-action="Login" method="post">
            <div asp-validation-summary="All" class="validation"></div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" type="email" placeholder="Enter your email" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input asp-for="Password" type="password" placeholder="Enter your password" />
            </div>

            <div class="auth-link-row">
                <a asp-controller="Auth" asp-action="ForgotPassword">Forgot password?</a>
            </div>

            <button type="submit" class="auth-btn">Login</button>

            <p class="bottom-text">
                Don't have an account?
                <a asp-controller="Auth" asp-action="Register">Register</a>
            </p>
        </form>
    </section>
</main>