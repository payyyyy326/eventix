@model Eventix.Share.Auth.LoginRequest;

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đăng nhập - Eventix</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <main class="login-page">
        <section class="login-card">
            <h1>Eventix</h1>
            <p class="subtitle">Đăng nhập để quản lý và đặt vé sự kiện</p>

            <form asp-controller="Auth" asp-action="Login" method="post">
                <div asp-validation-summary="All" class="validation"></div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" placeholder="Nhập email" />
                </div>

                <div class="form-group">
                    <label asp-for="Password">Mật khẩu</label>
                    <input asp-for="Password" type="password" placeholder="Nhập mật khẩu" />
                </div>

                <button type="submit" class="login-btn">Đăng nhập</button>

                <p class="register-text">
                    Chưa có tài khoản?
                    <a asp-controller="Auth" asp-action="Register">Đăng ký ngay</a>
                </p>
            </form>
        </section>
    </main>
</body>
</html>