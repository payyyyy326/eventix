@model Eventix.Share.Auth.VerifyOtpRequest;

@{
    ViewData["Title"] = "Xác thực OTP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Xác thực OTP - Eventix</title>
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <main class="login-page">
        <section class="login-card">
            <h1>Xác thực Email</h1>
            <p class="subtitle">
                Vui lòng nhập mã OTP đã được gửi đến email của bạn
            </p>

            <form asp-controller="Auth" asp-action="VerifyOtp" method="post">
                <div asp-validation-summary="All" class="validation"></div>

                <input asp-for="Email" type="hidden" />

                <div class="form-group">
                    <label>Email</label>
                    <input value="@Model.Email" disabled />
                </div>

                <div class="form-group">
                    <label asp-for="OtpCode">Mã OTP</label>
                    <input asp-for="OtpCode" placeholder="Nhập mã OTP" />
                </div>

                <button type="submit" class="login-btn">
                    Xác thực
                </button>

                <p class="register-text">
                    Đã có tài khoản?
                    <a asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                </p>
            </form>
        </section>
    </main>
</body>
</html>