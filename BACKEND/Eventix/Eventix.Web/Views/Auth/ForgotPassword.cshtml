@model Eventix.Share.Auth.ForgetPasswordRequest

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<main class="auth-page">
    <section class="auth-card">
        <h1>Forgot password</h1>
        <p class="subtitle">Enter your email to receive a reset code</p>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="All" class="validation"></div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" type="email" placeholder="Enter your email" />
            </div>

            <button type="submit" class="auth-btn">Send code</button>

            <p class="bottom-text">
                Remember your password?
                <a asp-controller="Auth" asp-action="Login">Login</a>
            </p>
        </form>
    </section>
</main>