@model Eventix.Share.Admin.AdminDashboardStats
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";

    string Fmt(decimal v) => v >= 1_000_000_000
        ? (v / 1_000_000_000m).ToString("N1") + "B"
        : v >= 1_000_000
            ? (v / 1_000_000m).ToString("N1") + "M"
            : v.ToString("#,##0");
}

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <h1>Dashboard</h1>
            <p>Tổng quan hệ thống Eventix</p>
        </div>
    </div>

    @* ── Stat cards row 1: Users ───────────────────────────────── *@
    <div class="admin-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8Z"/>
            <path d="M1 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H1Z"/>
            <path fill-rule="evenodd" d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
        </svg>
        Người dùng
    </div>
    <div class="admin-stats-grid">
        <div class="stat-card stat-blue">
            <div class="stat-value">@Model.TotalUsers.ToString("N0")</div>
            <div class="stat-label">Tổng Users</div>
        </div>
        <div class="stat-card stat-green">
            <div class="stat-value">@Model.ActiveUsers.ToString("N0")</div>
            <div class="stat-label">Đang hoạt động</div>
        </div>
        <div class="stat-card stat-red">
            <div class="stat-value">@Model.BannedUsers.ToString("N0")</div>
            <div class="stat-label">Đã bị ban</div>
        </div>
        <div class="stat-card stat-purple">
            <div class="stat-value">@Model.NewUsersThisMonth.ToString("N0")</div>
            <div class="stat-label">Mới tháng này</div>
        </div>
    </div>

    @* ── Organizers ───────────────────────────────────────────── *@
    <div class="admin-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3Z"/>
        </svg>
        Organizer
    </div>
    <div class="admin-stats-grid">
        <div class="stat-card stat-blue">
            <div class="stat-value">@Model.TotalOrganizers.ToString("N0")</div>
            <div class="stat-label">Tổng Organizer</div>
        </div>
        <div class="stat-card stat-yellow">
            <div class="stat-value">@Model.PendingOrganizers.ToString("N0")</div>
            <div class="stat-label">Chờ duyệt</div>
            @if (Model.PendingOrganizers > 0)
            {
                <a class="stat-cta" asp-controller="Admin" asp-action="OrganizerRequests" asp-route-status="Pending">
                    Xét duyệt ngay →
                </a>
            }
        </div>
        <div class="stat-card stat-green">
            <div class="stat-value">@Model.ApprovedOrganizers.ToString("N0")</div>
            <div class="stat-label">Đã duyệt</div>
        </div>
        <div class="stat-card stat-red">
            <div class="stat-value">@Model.RejectedOrganizers.ToString("N0")</div>
            <div class="stat-label">Từ chối</div>
        </div>
    </div>

    @* ── Events ───────────────────────────────────────────────── *@
    <div class="admin-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
        </svg>
        Sự kiện
    </div>
    <div class="admin-stats-grid">
        <div class="stat-card stat-blue">
            <div class="stat-value">@Model.TotalEvents.ToString("N0")</div>
            <div class="stat-label">Tổng sự kiện</div>
        </div>
        <div class="stat-card stat-green">
            <div class="stat-value">@Model.PublishedEvents.ToString("N0")</div>
            <div class="stat-label">Đã công bố</div>
        </div>
        <div class="stat-card stat-purple">
            <div class="stat-value">@Model.OngoingEvents.ToString("N0")</div>
            <div class="stat-label">Đang diễn ra</div>
        </div>
        <div class="stat-card stat-gray">
            <div class="stat-value">@Model.CompletedEvents.ToString("N0")</div>
            <div class="stat-label">Đã kết thúc</div>
        </div>
    </div>

    @* ── Revenue ──────────────────────────────────────────────── *@
    <div class="admin-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-3zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V2z"/>
        </svg>
        Doanh thu & Vé
    </div>
    <div class="admin-stats-grid admin-stats-grid--wide">
        <div class="stat-card stat-green stat-card--lg">
            <div class="stat-value">@Fmt(Model.TotalRevenue) ₫</div>
            <div class="stat-label">Tổng doanh thu</div>
        </div>
        <div class="stat-card stat-blue stat-card--lg">
            <div class="stat-value">@Fmt(Model.RevenueThisMonth) ₫</div>
            <div class="stat-label">Doanh thu tháng này</div>
        </div>
        <div class="stat-card stat-purple stat-card--lg">
            <div class="stat-value">@Model.TotalTicketsSold.ToString("N0")</div>
            <div class="stat-label">Vé đã bán</div>
        </div>
        <div class="stat-card stat-yellow stat-card--lg">
            <div class="stat-value">@Model.TotalOrders.ToString("N0")</div>
            <div class="stat-label">Đơn hàng thành công</div>
        </div>
    </div>

    @* ── Quick actions ────────────────────────────────────────── *@
    <div class="admin-quick-actions">
        <a asp-controller="Admin" asp-action="Users" class="admin-action-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8Z"/><path d="M1 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H1Z"/><path fill-rule="evenodd" d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
            </svg>
            Quản lý Users
        </a>
        <a asp-controller="Admin" asp-action="OrganizerRequests" asp-route-status="Pending" class="admin-action-btn admin-action-btn--warn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12z"/>
            </svg>
            Duyệt đơn đăng ký (@Model.PendingOrganizers chờ)
        </a>
        <a asp-controller="Admin" asp-action="Organizers" class="admin-action-btn admin-action-btn--info">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-3zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V2z"/>
            </svg>
            Thống kê Organizer
        </a>
    </div>

</div>
