@model Eventix.Share.TicketType.UpdateTicketTypeRequest

@{
    ViewData["Title"] = "Edit Ticket Type";
    Layout = "_OrganizerLayout";

    var eventId        = (Guid)ViewBag.EventId;
    var ticketTypeId   = (Guid)ViewBag.TicketTypeId;
    var sectionName    = ViewBag.Section as string ?? "N/A";
    var isSeatRequired = ViewBag.IsSeatRequired is bool sr && sr;
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <a class="wizard-back-link"
               asp-controller="Organizer"
               asp-action="TicketTypes"
               asp-route-eventId="@eventId">
                ← Back to Ticket Types
            </a>

            <div class="wizard-title">
                <span>Event Management</span>
                <h1>Edit Ticket Type</h1>
                <p>Update ticket information. Zone and seat settings cannot be changed after creation.</p>
            </div>
        </div>

        <div class="wizard-panel">

            <div class="ticket-type-card mb-4">
                <div class="ticket-type-card-header">
                    <div>
                        <h4>Ticket Configuration</h4>
                        <div class="wizard-meta" style="margin-top:10px;">
                            <span class="wizard-pill neutral">Section: @sectionName</span>
                            <span class="wizard-pill @(isSeatRequired ? "" : "info")">
                                @(isSeatRequired ? "Assigned Seating" : "General Admission")
                            </span>
                        </div>
                        <small class="text-muted">Zone and seat settings cannot be changed after creation.</small>
                    </div>
                </div>
            </div>

            <form asp-controller="TicketType"
                  asp-action="Edit"
                  asp-route-id="@ticketTypeId"
                  asp-route-eventId="@eventId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation mb-4"></div>

                <div class="wizard-card ticket-form-section mb-4">
                    <div class="ticket-form-heading">
                        <h4>Basic Information</h4>
                        <p>Update name, price and available quantity.</p>
                    </div>

                    <div class="wizard-grid-2 mt-3">

                        <div class="form-group">
                            <label asp-for="Name">Ticket Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Price">Price</label>
                            <div class="ticket-price-input">
                                <input asp-for="Price"
                                       type="number"
                                       min="0"
                                       step="1000"
                                       class="form-control" />
                                <span>VND</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                    </div>

                    <div class="wizard-grid-2 mt-3">

                        <div class="form-group">
                            <label asp-for="Quantity">Quantity</label>
                            <input asp-for="Quantity"
                                   type="number"
                                   min="1"
                                   class="form-control" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="SectionColor">Section Color</label>
                            <div class="d-flex align-items-center gap-2">
                                <input asp-for="SectionColor"
                                       type="color"
                                       class="form-control"
                                       style="width:3rem;height:2.5rem;padding:.2rem;" />
                                <small class="text-muted">Color displayed on the venue map.</small>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="wizard-card ticket-form-section mb-4">
                    <div class="ticket-form-heading">
                        <h4>Sales Period</h4>
                        <p>Define when customers can purchase this ticket.</p>
                    </div>

                    <div class="wizard-grid-2 mt-3">

                        <div class="form-group">
                            <label asp-for="SaleStartTime">Sale Start</label>
                            <input asp-for="SaleStartTime"
                                   type="datetime-local"
                                   class="form-control" />
                            <span asp-validation-for="SaleStartTime" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="SaleEndTime">Sale End</label>
                            <input asp-for="SaleEndTime"
                                   type="datetime-local"
                                   class="form-control" />
                            <span asp-validation-for="SaleEndTime" class="text-danger"></span>
                        </div>

                    </div>
                </div>

                <div class="wizard-card ticket-form-section mb-4">
                    <div class="ticket-form-heading">
                        <h4>Description</h4>
                        <p>Describe benefits, access rules or ticket conditions.</p>
                    </div>

                    <div class="form-group mt-3">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description"
                                  rows="5"
                                  class="form-control"
                                  placeholder="Describe this ticket type..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="wizard-actions">
                    <a asp-controller="Organizer"
                       asp-action="TicketTypes"
                       asp-route-eventId="@eventId"
                       class="wizard-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="wizard-btn-primary">
                        Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
