@model Eventix.Share.TicketType.UpdateTicketTypeRequest

@{
    ViewData["Title"] = "Edit Ticket Type";
    Layout = "_OrganizerLayout";

    var eventId = (Guid)ViewBag.EventId;
    var ticketTypeId = (Guid)ViewBag.TicketTypeId;

    var seatSection = ViewBag.Section as string ?? "N/A";
    var isSeatRequired = ViewBag.IsSeatRequired is bool value && value;
}

<section class="organizer-page">

    <div class="dashboard-header">
        <div class="page-heading">
            <a class="back-link"
               asp-controller="Organizer"
               asp-action="TicketTypes"
               asp-route-eventId="@eventId">
                ← Back to Ticket Types
            </a>

            <span>Event Management</span>
            <h1>Edit Ticket Type</h1>
            <p>Update ticket information. Seat settings cannot be changed after creation.</p>
        </div>
    </div>

    <div class="dashboard-panel">

        <div class="ticket-info-readonly">
            <div>
                <span>Section</span>
                <strong>@seatSection</strong>
            </div>

            <div>
                <span>Seat Required</span>
                <strong>@(isSeatRequired ? "Yes" : "No")</strong>
            </div>
        </div>

        <form asp-controller="TicketType"
              asp-action="Edit"
              asp-route-id="@ticketTypeId"
              asp-route-eventId="@eventId"
              method="post"
              class="ticket-form">

            <div asp-validation-summary="ModelOnly"
                 class="validation">
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Name">Ticket Name</label>
                    <input asp-for="Name" />
                    <span asp-validation-for="Name"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Price">Price</label>
                    <input asp-for="Price"
                           type="number"
                           min="0"
                           step="1000" />
                    <span asp-validation-for="Price"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Quantity">Quantity</label>
                    <input asp-for="Quantity"
                           type="number"
                           min="1" />
                    <span asp-validation-for="Quantity"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SaleStartTime">Sale Start Time</label>
                    <input asp-for="SaleStartTime"
                           type="datetime-local" />
                    <span asp-validation-for="SaleStartTime"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SaleEndTime">Sale End Time</label>
                    <input asp-for="SaleEndTime"
                           type="datetime-local" />
                    <span asp-validation-for="SaleEndTime"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>

                <textarea asp-for="Description"
                          rows="5"
                          placeholder="Describe this ticket type..."></textarea>

                <span asp-validation-for="Description"></span>
            </div>

            <div class="form-actions">
                <button type="submit"
                        class="dashboard-create-btn">
                    Save Changes
                </button>

                <a class="secondary-btn"
                   asp-controller="Organizer"
                   asp-action="TicketTypes"
                   asp-route-eventId="@eventId">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</section>

<partial name="_ValidationScriptsPartial" />