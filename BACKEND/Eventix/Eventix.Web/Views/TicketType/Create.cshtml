@using Eventix.Share.TicketType
@model CreateTicketTypeRequest

@{
    ViewData["Title"] = "Create Ticket Type";
    Layout = "_OrganizerLayout";

    var eventId = (Guid)ViewBag.EventId;
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <a class="wizard-back-link"
               asp-controller="Organizer"
               asp-action="TicketTypes"
               asp-route-eventId="@eventId">
                ← Back to Ticket Types
            </a>

            <div class="wizard-title">
                <span>Event Management</span>
                <h1>Create Ticket Type</h1>
                <p>Set the ticket name, type, price and sale period.</p>
            </div>
        </div>

        <div class="wizard-panel">

            <form asp-controller="TicketType"
                  asp-action="Create"
                  asp-route-eventId="@eventId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation mb-4"></div>

                @* Basic Info *@
                <div class="wizard-card ticket-form-section mb-4">
                    <div class="ticket-form-heading">
                        <h4>Basic Information</h4>
                        <p>Name, ticket type and quantity.</p>
                    </div>

                    <div class="wizard-grid-2 mt-3">

                        <div class="form-group">
                            <label asp-for="Name">Ticket Name</label>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="VIP, Standard, Early Bird..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Quantity">Quantity</label>
                            <input asp-for="Quantity"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="100" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                    </div>

                    <div class="form-group mt-3">
                        <label>Admission Type</label>
                        <div class="d-flex gap-4 mt-2">
                            <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                                <input asp-for="IsSeatRequired"
                                       type="radio"
                                       value="false"
                                       id="radioStanding"
                                       checked="checked" />
                                <div>
                                    <strong>🧍 Standing</strong>
                                    <small class="d-block text-muted">General admission — no seat assignment</small>
                                </div>
                            </label>
                            <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                                <input asp-for="IsSeatRequired"
                                       type="radio"
                                       value="true"
                                       id="radioSeated" />
                                <div>
                                    <strong>💺 Seated</strong>
                                    <small class="d-block text-muted">Seats auto-generated from quantity</small>
                                </div>
                            </label>
                        </div>
                    </div>

                </div>

                @* Price *@
                <div class="wizard-card ticket-form-section mb-4">
                    <div class="ticket-form-heading">
                        <h4>Pricing</h4>
                        <p>Set the ticket price. Enter 0 for free events.</p>
                    </div>

                    <div class="wizard-grid-2 mt-3">
                        <div class="form-group">
                            <label asp-for="Price">Price</label>
                            <div class="ticket-price-input">
                                <input asp-for="Price"
                                       type="number"
                                       min="0"
                                       step="1000"
                                       class="form-control"
                                       placeholder="500000" />
                                <span>VND</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="SectionColor">Section Color</label>
                            <div class="d-flex align-items-center gap-2">
                                <input asp-for="SectionColor"
                                       type="color"
                                       class="form-control"
                                       style="width:3rem;height:2.5rem;padding:.2rem;"
                                       value="#3B82F6" />
                                <small class="text-muted">Color displayed on the venue map.</small>
                            </div>
                        </div>
                    </div>
                </div>

                @* Sale Period *@
                <div class="wizard-card ticket-form-section mb-4">
                    <div class="ticket-form-heading">
                        <h4>Sales Period</h4>
                        <p>Define when customers can purchase this ticket.</p>
                    </div>

                    <div class="wizard-grid-2 mt-3">
                        <div class="form-group">
                            <label asp-for="SaleStartTime">Sale Start</label>
                            <input asp-for="SaleStartTime"
                                   type="datetime-local"
                                   class="form-control" />
                            <span asp-validation-for="SaleStartTime" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="SaleEndTime">Sale End</label>
                            <input asp-for="SaleEndTime"
                                   type="datetime-local"
                                   class="form-control" />
                            <span asp-validation-for="SaleEndTime" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                @* Description *@
                <div class="wizard-card ticket-form-section mb-4">
                    <div class="ticket-form-heading">
                        <h4>Description</h4>
                        <p>Optional details about this ticket type.</p>
                    </div>

                    <div class="form-group mt-3">
                        <textarea asp-for="Description"
                                  rows="4"
                                  class="form-control"
                                  placeholder="Describe benefits, access rules or ticket conditions..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="wizard-actions">
                    <a asp-controller="Organizer"
                       asp-action="TicketTypes"
                       asp-route-eventId="@eventId"
                       class="wizard-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="wizard-btn-primary">
                        + Create Ticket Type
                    </button>
                </div>

            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
