@model Eventix.Share.TicketType.CreateTicketTypeRequest

@{
    ViewData["Title"] = "Create Ticket Type";
    Layout = "_OrganizerLayout";

    var eventId = (Guid)ViewBag.EventId;
    var sections = ViewBag.Sections as List<string> ?? new List<string>();
    var hasSections = sections.Any();
}

<section class="organizer-page">

    <div class="dashboard-header">
        <div class="page-heading">
            <a class="back-link"
               asp-controller="Organizer"
               asp-action="TicketTypes"
               asp-route-eventId="@eventId">
                ← Back to Ticket Types
            </a>

            <span>Event Management</span>
            <h1>Create Ticket Type</h1>
            <p>Create a new ticket type for this event.</p>
        </div>
    </div>

    <div class="dashboard-panel">

        <form asp-controller="TicketType"
              asp-action="Create"
              asp-route-eventId="@eventId"
              method="post"
              class="ticket-form">

            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Name">Ticket Name</label>
                    <input asp-for="Name" placeholder="VIP, Standard, Early Bird..." />
                    <span asp-validation-for="Name"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Price">Price</label>
                    <input asp-for="Price" type="number" min="0" step="1000" />
                    <span asp-validation-for="Price"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Quantity">Quantity</label>
                    <input asp-for="Quantity" type="number" min="1" />
                    <span asp-validation-for="Quantity"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SaleStartTime">Sale Start Time</label>
                    <input asp-for="SaleStartTime" type="datetime-local" />
                    <span asp-validation-for="SaleStartTime"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SaleEndTime">Sale End Time</label>
                    <input asp-for="SaleEndTime" type="datetime-local" />
                    <span asp-validation-for="SaleEndTime"></span>
                </div>

                <div class="form-group" id="sectionGroup">
                    <label asp-for="Section">Section</label>

                    <select asp-for="Section"
                            disabled="@(!hasSections)">
                        <option value="">-- Select section --</option>

                        @foreach (var seatSection in sections)
                        {
                            <option value="@seatSection">@seatSection</option>
                        }
                    </select>

                    <span asp-validation-for="Section"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description"
                          placeholder="Describe this ticket type..."></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="checkbox-group">
                <input asp-for="IsSeatRequired"
                       disabled="@(!hasSections)" />

                <label asp-for="IsSeatRequired">
                    Require seat selection
                </label>
            </div>

            @if (!hasSections)
            {
                <div class="warning-box">
                    Venue này chưa có sơ đồ ghế. Bạn cần import Seat trước khi tạo Ticket Type có chọn ghế.
                </div>
            }

            <div class="form-actions">
                <button type="submit" class="dashboard-create-btn">
                    Create Ticket Type
                </button>

                <a class="secondary-btn"
                   asp-controller="Organizer"
                   asp-action="TicketTypes"
                   asp-route-eventId="@eventId">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</section>

<script>
    const hasSections = @hasSections.ToString().ToLower();
    const seatCheckbox = document.getElementById("IsSeatRequired");
    const sectionGroup = document.getElementById("sectionGroup");

    function toggleSection() {
        if (!seatCheckbox || !sectionGroup) return;

        if (!hasSections) {
            sectionGroup.style.display = "none";
            return;
        }

        sectionGroup.style.display = seatCheckbox.checked ? "flex" : "none";
    }

    seatCheckbox?.addEventListener("change", toggleSection);
    toggleSection();
</script>