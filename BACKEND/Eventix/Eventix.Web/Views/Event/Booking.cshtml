@model Eventix.Web.Models.BookingViewModel

@{
    ViewData["Title"] = "Đặt vé";
    var ticketZones = Model.Event.TicketTypes.OrderBy(ticket => ticket.Price).ToList();
    var selectedTicket = ticketZones.FirstOrDefault(ticket => ticket.Id == Model.Request.TicketTypeId)
        ?? ticketZones.FirstOrDefault();
    var selectedAdmissionType = selectedTicket?.IsSeatRequired == true ? "seated" : "standing";
    var hasStandingZones = ticketZones.Any(ticket => !ticket.IsSeatRequired);
    var hasSeatedZones = ticketZones.Any(ticket => ticket.IsSeatRequired);
}

<main class="booking-page">
    <section class="booking-event-card">
        <img src="@Model.Event.BannerUrl" alt="@Model.Event.Title" />
        <div>
            <span class="booking-eyebrow">ĐẶT VÉ SỰ KIỆN</span>
            <h1>@Model.Event.Title</h1>
            <p>@Model.Event.StartTime.ToString("dd/MM/yyyy HH:mm")</p>
            <p>@Model.Event.Venue.Name — @Model.Event.Venue.Address, @Model.Event.Venue.City</p>
        </div>
    </section>

    <form asp-action="Book" method="post" class="booking-form" id="booking-form">
        @Html.AntiForgeryToken()
        <input asp-for="Request.EventId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="booking-error"></div>

        <section class="booking-panel">
            <div class="booking-step-heading">
                <span>1</span>
                <div><h2>Chọn loại vé</h2><p>Chọn hình thức tham dự phù hợp với bạn.</p></div>
            </div>
            <div class="booking-admission-grid">
                <label class="booking-admission @(!hasStandingZones ? "disabled" : "")">
                    <input type="radio" name="AdmissionType" value="standing"
                           checked="@(selectedAdmissionType == "standing")" disabled="@(!hasStandingZones)" />
                    <span class="booking-admission-icon">♟</span>
                    <strong>Vé đứng</strong>
                    <small>Chọn khu và số lượng vé</small>
                    @if (!hasStandingZones) { <em>Sự kiện chưa có khu đứng</em> }
                </label>
                <label class="booking-admission @(!hasSeatedZones ? "disabled" : "")">
                    <input type="radio" name="AdmissionType" value="seated"
                           checked="@(selectedAdmissionType == "seated")" disabled="@(!hasSeatedZones)" />
                    <span class="booking-admission-icon">▣</span>
                    <strong>Vé ngồi</strong>
                    <small>Chọn khu và ghế cụ thể</small>
                    @if (!hasSeatedZones) { <em>Sự kiện chưa có khu ghế</em> }
                </label>
            </div>
        </section>

        <section class="booking-panel" id="booking-zone-panel">
            <div class="booking-step-heading">
                <span>2</span>
                <div><h2>Chọn khu vé</h2><p id="booking-zone-hint">Chỉ hiển thị các khu thuộc loại vé đã chọn.</p></div>
            </div>
            <div class="booking-venue-map">
                <div class="booking-venue-map-header">
                    <div><strong>Sơ đồ tổng khu vực</strong><small>Toàn bộ sơ đồ đã được tạo bởi Organizer. Bấm một khu để chọn vé.</small></div>
                    <span id="booking-map-selection">Chưa chọn khu</span>
                </div>
                @if (Model.SeatMapLayouts.Any())
                {
                    <div class="booking-venue-map-scroll">
                        <div class="booking-map-stage-label">SÂN KHẤU</div>
                        <div class="booking-map-canvas">
                            @foreach (var layout in Model.SeatMapLayouts)
                            {
                                <button type="button" class="booking-map-zone" data-ticket-type="@layout.TicketTypeId" data-admission-type="@(layout.IsSeatRequired ? "seated" : "standing")" data-section="@layout.Section" style="left:@(layout.X)px;top:@(layout.Y)px;width:@(layout.Width)px;height:@(layout.Height)px;background:@layout.Color;">
                                    <strong>@layout.Section</strong><span>@(layout.IsSeatRequired ? $"{layout.AvailableSeats ?? 0} / {layout.TotalSeats ?? 0} ghế trống" : $"{layout.AvailableSeats ?? 0} vé còn")</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="booking-map-legend"><span><i></i>Khu có thể chọn</span><span><i class="selected"></i>Khu đang chọn</span><span><i class="muted"></i>Bấm khu để chuyển loại vé</span></div>
                }
                else { <div class="booking-map-unavailable">Sự kiện này chưa được cấu hình sơ đồ khu vực.</div> }
            </div>
            <div class="booking-zone-grid booking-zone-ticket-grid">
                @foreach (var ticket in ticketZones)
                {
                    var available = ticket.Quantity - ticket.SoldQuantity - ticket.ReservedQuantity;
                    var zoneName = ticket.Section ?? ticket.Name;
                    var selected = selectedTicket?.Id == ticket.Id;
                    <label class="booking-zone booking-zone-ticket @(available <= 0 ? "disabled" : "")"
                           data-admission-type="@(ticket.IsSeatRequired ? "seated" : "standing")">
                        <input asp-for="Request.TicketTypeId" type="radio" value="@ticket.Id"
                               checked="@selected" disabled="@(available <= 0)"
                               data-seat-required="@ticket.IsSeatRequired.ToString().ToLowerInvariant()"
                               data-price="@ticket.Price" />
                        <span class="booking-zone-name">@zoneName</span>
                        @if (!string.Equals(zoneName, ticket.Name, StringComparison.OrdinalIgnoreCase))
                        {
                            <small class="booking-zone-tier">@ticket.Name</small>
                        }
                        <span class="booking-zone-price">@ticket.Price.ToString("#,##0") VND</span>
                        <small>@(ticket.IsSeatRequired ? "Khu ghế ngồi · Chọn ghế" : "Khu đứng · Tự do")</small>
                        <strong class="booking-zone-availability">Còn @available vé</strong>
                    </label>
                }
            </div>
            <div id="booking-zone-empty" class="booking-seat-empty" hidden>Không có khu vé phù hợp với loại vé đã chọn.</div>
            <span asp-validation-for="Request.TicketTypeId" class="booking-error"></span>
        </section>

        <section class="booking-panel">
            <div class="booking-step-heading">
                <span>3</span>
                <div><h2>Số lượng và chỗ ngồi</h2><p>Vé đứng chọn số lượng; vé ngồi chọn trực tiếp trên sơ đồ.</p></div>
            </div>
            <div class="booking-fields">
                <label id="quantity-field">
                    Số lượng
                    <input asp-for="Request.Quantity" min="1" max="10" id="booking-quantity" />
                </label>

                <div id="seat-field" class="booking-seat-field" hidden>
                    <div class="booking-seat-heading">
                        <div><strong>Chọn số ghế</strong><small>Chỉ các ghế thuộc khu vừa chọn được hiển thị.</small></div>
                        <span id="selected-seat-label">Chưa chọn ghế</span>
                    </div>
                    <div class="booking-stage"><span>SÂN KHẤU</span></div>
                    <div id="booking-seat-map" class="booking-seat-map">
                        @foreach (var rowGroup in Model.Event.Seats.OrderBy(s => s.Section).ThenBy(s => s.Row)
                            .ThenBy(s => s.XPosition).ThenBy(s => s.Number).GroupBy(s => new { s.Section, s.Row }))
                        {
                            <div class="booking-seat-row">
                                <strong class="booking-row-label">@(rowGroup.Key.Row ?? rowGroup.Key.Section)</strong>
                                <div class="booking-row-seats">
                                    @foreach (var seat in rowGroup)
                                    {
                                        var selectedSeat = Model.Request.SeatIds.Contains(seat.SeatId);
                                        var availableSeat = seat.Status == "Available";
                                        <label class="booking-seat-option @(!availableSeat ? "unavailable" : "")"
                                               data-ticket-type="@seat.TicketTypeId" data-seat-label="@seat.Label"
                                               data-available="@availableSeat.ToString().ToLowerInvariant()" title="@seat.Label">
                                            <input name="Request.SeatIds" type="checkbox" value="@seat.SeatId"
                                                   checked="@(selectedSeat && availableSeat)" disabled="@(!availableSeat)" />
                                            <span class="booking-seat-number">@seat.Number</span>
                                            @if (!availableSeat) { <span class="booking-seat-lock">×</span> }
                                        </label>
                                    }
                                </div>
                                <strong class="booking-row-label">@(rowGroup.Key.Row ?? rowGroup.Key.Section)</strong>
                            </div>
                        }
                    </div>
                    <div id="booking-seat-empty" class="booking-seat-empty" hidden>Khu vé này chưa được cấu hình ghế.</div>
                    <div class="booking-seat-legend">
                        <span><i class="legend-available"></i> Ghế còn trống</span>
                        <span><i class="legend-selected"></i> Ghế bạn chọn</span>
                        <span><i class="legend-unavailable"></i> Ghế không khả dụng</span>
                    </div>
                </div>
            </div>
            <span asp-validation-for="Request.Quantity" class="booking-error"></span>
            <span asp-validation-for="Request.SeatIds" class="booking-error"></span>
        </section>

        <section class="booking-summary">
            <div><span>Tạm tính</span><strong id="booking-total">0 VND</strong></div>
            <p>Vé được giữ trong 15 phút. Sau thời gian này hệ thống sẽ tự động giải phóng.</p>
            <button type="submit">Xác nhận đặt vé</button>
        </section>
    </form>
</main>

@section Scripts {
<script>
(() => {
    const admissionRadios = [...document.querySelectorAll('input[name="AdmissionType"]')];
    const zoneRadios = [...document.querySelectorAll('input[name="Request.TicketTypeId"]')];
    const zoneCards = [...document.querySelectorAll('.booking-zone-ticket')];
    const mapZones = [...document.querySelectorAll('.booking-map-zone')];
    const mapSelection = document.getElementById('booking-map-selection');
    const zoneEmpty = document.getElementById('booking-zone-empty');
    const quantity = document.getElementById('booking-quantity');
    const quantityField = document.getElementById('quantity-field');
    const seatField = document.getElementById('seat-field');
    const seatMap = document.getElementById('booking-seat-map');
    const seatEmpty = document.getElementById('booking-seat-empty');
    const selectedSeatLabel = document.getElementById('selected-seat-label');
    const total = document.getElementById('booking-total');
    const allSeats = [...seatMap.querySelectorAll('.booking-seat-option')];

    function selectedSeats() {
        return allSeats.filter(seat => {
            const input = seat.querySelector('input');
            return input.checked && !input.disabled;
        });
    }

    function refreshSeatLabel() {
        const seats = selectedSeats();
        selectedSeatLabel.textContent = seats.length
            ? `Đã chọn ${seats.length}: ${seats.map(seat => seat.dataset.seatLabel).join(', ')}`
            : 'Chưa chọn ghế';
    }

    function refresh() {
        const admission = admissionRadios.find(radio => radio.checked)?.value;
        let visibleZoneCount = 0;
        zoneCards.forEach(card => {
            const radio = card.querySelector('input[name="Request.TicketTypeId"]');
            const visible = card.dataset.admissionType === admission;
            card.hidden = !visible;
            radio.disabled = !visible || card.classList.contains('disabled');
            if (!visible) radio.checked = false;
            if (visible && !card.classList.contains('disabled')) visibleZoneCount++;
        });
        zoneEmpty.hidden = visibleZoneCount > 0;
        mapZones.forEach(zone => zone.disabled = !zone.dataset.ticketType);


        let selected = zoneRadios.find(radio => radio.checked && !radio.disabled);
        if (!selected) {
            selected = zoneRadios.find(radio => !radio.disabled);
            if (selected) selected.checked = true;
        }
        if (!selected) {
            seatField.hidden = true;
            total.textContent = '0 VND';
            return;
        }

        mapZones.forEach(zone => zone.classList.toggle('is-selected', zone.dataset.ticketType === selected.value));
        const selectedMapZone = mapZones.find(zone => zone.dataset.ticketType === selected.value);
        if (mapSelection) mapSelection.textContent = selectedMapZone?.dataset.section || selected.closest('.booking-zone-ticket')?.querySelector('.booking-zone-name')?.textContent || 'Đã chọn khu';

        const seatRequired = selected.dataset.seatRequired === 'true';
        seatField.hidden = !seatRequired;
        quantityField.hidden = seatRequired;
        quantity.readOnly = seatRequired;
        if (!seatRequired) {
            allSeats.forEach(seat => seat.querySelector('input').checked = false);
            if (Number(quantity.value) < 1) quantity.value = 1;
        }

        let availableSeatCount = 0;
        allSeats.forEach(seat => {
            const input = seat.querySelector('input');
            const visible = seat.dataset.ticketType === selected.value;
            seat.hidden = !visible;
            input.disabled = !visible || seat.dataset.available !== 'true';
            if (!visible) input.checked = false;
            if (visible && seat.dataset.available === 'true') availableSeatCount++;
        });
        seatMap.querySelectorAll('.booking-seat-row').forEach(row => {
            row.hidden = ![...row.querySelectorAll('.booking-seat-option')].some(seat => !seat.hidden);
        });
        seatEmpty.hidden = !seatRequired || availableSeatCount > 0;
        seatMap.hidden = seatRequired && availableSeatCount === 0;
        if (seatRequired) quantity.value = selectedSeats().length;
        refreshSeatLabel();
        const amount = Number(selected.dataset.price) * Number(quantity.value || 0);
        total.textContent = new Intl.NumberFormat('vi-VN').format(amount) + ' VND';
    }

    admissionRadios.forEach(radio => radio.addEventListener('change', refresh));
    mapZones.forEach(zone => zone.addEventListener('click', () => {
        const admissionRadio = admissionRadios.find(item => item.value === zone.dataset.admissionType && !item.disabled);
        if (admissionRadio) admissionRadio.checked = true;
        refresh();
        const radio = zoneRadios.find(item => item.value === zone.dataset.ticketType && !item.disabled);
        if (radio) { radio.checked = true; refresh(); }
    }));
    zoneRadios.forEach(radio => radio.addEventListener('change', refresh));
    allSeats.forEach(seat => seat.querySelector('input').addEventListener('change', () => {
        if (selectedSeats().length > 10) {
            seat.querySelector('input').checked = false;
            alert('Bạn chỉ có thể chọn tối đa 10 ghế trong một lần đặt.');
        }
        refresh();
    }));
    quantity.addEventListener('input', refresh);
    refresh();
})();
</script>
}