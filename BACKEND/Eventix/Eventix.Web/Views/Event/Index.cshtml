@model Eventix.Web.Models.EventViewModel

@{
    ViewData["Title"] = "Events";
    Layout = "_Layout";
}

<section class="events-page">
    <div class="events-layout">

        <aside class="filter-panel">
            <h2>Filter Events</h2>

            <form asp-controller="Event" asp-action="Index" method="get">

                <div class="filter-group">
                    <label>Search</label>
                    <input name="Search"
                           value="@Model.Filter.Search"
                           placeholder="Search event..." />
                </div>

                <div class="filter-group">
                    <label>From date</label>
                    <input name="FromDate"
                           type="date"
                           value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="filter-group">
                    <label>To date</label>
                    <input name="ToDate"
                           type="date"
                           value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="filter-group">
                    <label>Min price</label>
                    <input name="MinPrice"
                           type="number"
                           value="@Model.Filter.MinPrice"
                           placeholder="0" />
                </div>

                <div class="filter-group">
                    <label>Max price</label>
                    <input name="MaxPrice"
                           type="number"
                           value="@Model.Filter.MaxPrice"
                           placeholder="1000000" />
                </div>

                <div class="filter-group">
                    <label>Sort by</label>
                    <select name="SortBy">
                        <option value="">Latest</option>
                        <option value="view" selected="@(Model.Filter.SortBy == "view")">Most viewed</option>
                        <option value="upcoming" selected="@(Model.Filter.SortBy == "upcoming")">Upcoming</option>
                    </select>
                </div>

                <input type="hidden" name="CurrentPage" value="1" />
                <input type="hidden" name="PageSize" value="@Model.Filter.PageSize" />

                <button type="submit" class="filter-btn">
                    Apply Filter
                </button>

                <a asp-controller="Event"
                   asp-action="Index"
                   class="clear-filter-btn">
                    Clear
                </a>
            </form>
        </aside>

        <div class="events-content">
            <div class="events-title-row">
                <div>
                    <h1>Events</h1>
                    <p>@Model.Events.TotalRows events found</p>
                </div>
            </div>

            @if (Model.Events.DataList == null || !Model.Events.DataList.Any())
            {
                <p class="empty-text">No events found.</p>
            }
            else
            {
                <div class="event-grid">
                    @foreach (var item in Model.Events.DataList)
                    {
                        <a class="event-card"
                           asp-controller="Event"
                           asp-action="Details"
                           asp-route-id="@item.Id">

                            <img src="@MediaUrl.Img(item.ImageUrl)"
                                 alt="@item.Title" />

                            <div class="event-card-body">
                                <span>@item.CategoryName</span>

                                <h3>@item.Title</h3>

                                <p>@item.VenueName • @item.VenueCity</p>

                                <p>@item.StartTime.ToString("dd/MM/yyyy HH:mm")</p>

                                @if (item.MinPrice.HasValue)
                                {
                                    <p class="event-price">
                                        From @item.MinPrice.Value.ToString("N0") VND
                                    </p>
                                }
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

    </div>
</section>