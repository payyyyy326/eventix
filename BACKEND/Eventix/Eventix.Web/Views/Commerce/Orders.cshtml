@model List<Eventix.Share.Commerce.OrderResponse>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<main class="commerce-page"><h1>Đơn hàng của tôi</h1>
@if (Model.Count == 0) { <p>Bạn chưa có đơn hàng.</p> }
@foreach (var order in Model) {
    <section class="commerce-card">
        <div class="commerce-row"><strong>@order.OrderCode</strong><span class="commerce-status">@order.Status</span></div>
        @foreach (var item in order.Items) { <p>@item.EventTitle · @item.TicketTypeName · @item.Quantity vé</p> }
        <div class="commerce-total"><span>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span><strong>@order.TotalAmount.ToString("#,##0") VND</strong></div>
    </section>
}
</main>
