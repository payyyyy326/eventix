@model Eventix.Web.Models.MyTicketsViewModel

@{
    ViewData["Title"] = "Vé của tôi";

    var activeTab = ViewBag.ActiveTab as string ?? "bookings";
    var now = DateTime.UtcNow;

    DateTime ToUtc(DateTime value)
    {
        return value.Kind switch
        {
            DateTimeKind.Utc => value,
            DateTimeKind.Local => value.ToUniversalTime(),
            _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
        };
    }

    // Chỉ lấy các lượt giữ vé đang hoạt động và chưa hết hạn
    var activeBookings = Model.Bookings
        .Where(x =>
            string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase) &&
            ToUtc(x.ExpiresAt) > now)
        .OrderBy(x => x.ExpiresAt)
        .ToList();

    var activeBookingCount = activeBookings.Count;
    var ticketCount = Model.TotalTicketCount;
}

<main class="commerce-page my-tickets-page">

    <header class="my-tickets-header my-tickets-hero">
        <div class="my-tickets-hero-copy">
            <span class="my-tickets-kicker">TRUNG TÂM VÉ</span>
            <h1>Vé của tôi</h1>
            <p>Theo dõi vé đang giữ, quản lý vé điện tử và mở mã QR khi tham dự sự kiện.</p>
        </div>
        <div class="my-tickets-stats">
            <div><span>Đang giữ</span><strong>@activeBookingCount</strong></div>
            <div><span>Vé đã mua</span><strong>@ticketCount</strong></div>
        </div>
    </header>
    <nav class="my-tickets-tabs">
        <a class="my-tab-btn @(activeTab == "bookings" ? "active" : "")"
           asp-action="MyTickets"
           asp-route-tab="bookings">

            <span>Vé đang giữ</span>

            @if (activeBookingCount > 0)
            {
                <span id="booking-tab-badge"
                      class="tab-badge">
                    @activeBookingCount
                </span>
            }
        </a>

        <a class="my-tab-btn @(activeTab == "tickets" ? "active" : "")"
           asp-action="MyTickets"
           asp-route-tab="tickets">

            <span>Vé đã mua</span>

            @if (ticketCount > 0)
            {
                <span class="tab-badge">
                    @ticketCount
                </span>
            }
        </a>
    </nav>

    <div class="my-tickets-content">

        @* ==================== VÉ ĐANG GIỮ ==================== *@
        @if (activeTab == "bookings")
        {
            if (activeBookingCount == 0)
            {
                <section id="booking-empty-state"
                         class="commerce-empty-state">

                    <div class="empty-state-icon">🎟️</div>

                    <h2>Không có vé đang giữ</h2>

                    <p>
                        Bạn chưa có lượt giữ vé nào hoặc các lượt giữ vé
                        trước đó đã hết hạn.
                    </p>

                    <a class="commerce-button"
                       asp-controller="Event"
                       asp-action="Index">
                        Khám phá sự kiện
                    </a>
                </section>
            }
            else
            {
                <div id="booking-list" class="booking-list">

                    @foreach (var booking in activeBookings)
                    {
                        var expiresAtUtc = ToUtc(booking.ExpiresAt);

                        <section class="commerce-card booking-card booking-hold"
                                 data-expires="@expiresAtUtc.ToString("O")">

                            <div class="booking-card-header">

                                <div class="booking-event-info">
                                    <div class="booking-status-row">
                                        <span class="commerce-status status-active">
                                            Đang giữ vé
                                        </span>
                                    </div>

                                    <h2>@booking.EventTitle</h2>

                                    <div class="booking-meta">
                                        <span>
                                            <span class="meta-icon">🎫</span>
                                            @booking.TicketTypeName
                                        </span>

                                        <span>
                                            <span class="meta-icon">×</span>
                                            @booking.Quantity vé
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(booking.SeatLabel))
                                    {
                                        <p class="booking-seat">
                                            Ghế:
                                            <strong>@booking.SeatLabel</strong>
                                        </p>
                                    }
                                </div>

                                <div class="booking-time-box">
                                    <span class="booking-time-label">
                                        Thời gian giữ vé
                                    </span>

                                    <strong class="booking-countdown">
                                        Đang tính...
                                    </strong>
                                </div>

                            </div>

                            <div class="booking-card-footer">

                                <div class="booking-price">
                                    <span>Tổng thanh toán</span>

                                    <strong>
                                        @booking.TotalAmount.ToString("#,##0") VND
                                    </strong>
                                </div>

                                <div class="booking-actions">

                                    <form asp-action="CancelBooking"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@booking.Id" />

                                        <button class="commerce-button commerce-button-secondary"
                                                type="submit"
                                                onclick="return confirm('Bạn muốn huỷ lượt giữ vé này?')">
                                            Huỷ giữ vé
                                        </button>
                                    </form>

                                    <a class="commerce-button"
                                       asp-action="Checkout"
                                       asp-route-reservationIds="@booking.Id">
                                        Thanh toán ngay
                                    </a>

                                </div>

                            </div>

                        </section>
                    }

                </div>
            }
        }

        @* ==================== VÉ ĐÃ MUA ==================== *@
        @if (activeTab == "tickets")
        {
            <section class="ticket-table-panel">
                <form class="ticket-filters" asp-action="MyTickets" method="get">
                    <input type="hidden" name="tab" value="tickets" />
                    <div class="ticket-filter-search">
                        <label for="ticketSearch">Tìm kiếm</label>
                        <input id="ticketSearch" name="search" value="@Model.Search"
                               placeholder="Tên sự kiện, mã vé, loại vé, địa điểm..." />
                    </div>
                    <div>
                        <label for="ticketStatus">Trạng thái</label>
                        <select id="ticketStatus" name="status">
                            <option value="">Tất cả trạng thái</option>
                            @foreach (var statusOption in Model.TicketStatuses)
                            {
                                <option value="@statusOption" selected="@(string.Equals(Model.Status, statusOption, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                    @statusOption
                                </option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="fromDate">Từ ngày</label>
                        <input id="fromDate" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label for="toDate">Đến ngày</label>
                        <input id="toDate" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label for="ticketPageSize">Số dòng</label>
                        <select id="ticketPageSize" name="pageSize">
                            @foreach (var size in new[] { 5, 10, 20, 50 })
                            {
                                <option value="@size" selected="@(Model.TicketPageSize == size ? "selected" : null)">@size</option>
                            }
                        </select>
                    </div>
                    <div class="ticket-filter-actions">
                        <button class="commerce-button" type="submit">Lọc vé</button>
                        <a class="ticket-filter-reset" asp-action="MyTickets" asp-route-tab="tickets">Xóa lọc</a>
                    </div>
                </form>

                <div class="ticket-table-summary">
                    <span>Hiển thị <strong>@Model.Tickets.Count</strong> / <strong>@Model.FilteredTicketCount</strong> vé phù hợp</span>
                    @if (Model.FilteredTicketCount != Model.TotalTicketCount)
                    {
                        <span>Tổng số vé: @Model.TotalTicketCount</span>
                    }
                </div>

                @if (Model.TotalTicketCount == 0)
                {
                    <section class="commerce-empty-state">
                        <div class="empty-state-icon">🎫</div>
                        <h2>Bạn chưa có vé điện tử</h2>
                        <p>Vé đã thanh toán thành công sẽ được hiển thị tại đây.</p>
                        <a class="commerce-button" asp-controller="Event" asp-action="Index">Tìm sự kiện</a>
                    </section>
                }
                else if (Model.FilteredTicketCount == 0)
                {
                    <section class="commerce-empty-state ticket-filter-empty">
                        <div class="empty-state-icon">🔎</div>
                        <h2>Không tìm thấy vé phù hợp</h2>
                        <p>Hãy thay đổi từ khóa, trạng thái hoặc khoảng ngày.</p>
                        <a class="commerce-button" asp-action="MyTickets" asp-route-tab="tickets">Xóa bộ lọc</a>
                    </section>
                }
                else
                {
                    <div class="ticket-table-scroll">
                        <table class="ticket-data-table">
                            <thead>
                                <tr>
                                    <th>Mã vé</th>
                                    <th>Sự kiện</th>
                                    <th>Loại vé / Ghế</th>
                                    <th>Thời gian</th>
                                    <th>Địa điểm</th>
                                    <th>Trạng thái</th>
                                    <th class="ticket-action-column">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.Tickets)
                                {
                                    var statusClass = ticket.Status?.ToLowerInvariant() switch
                                    {
                                        "confirmed" => "status-confirmed",
                                        "used" => "status-used",
                                        "cancelled" => "status-cancelled",
                                        "expired" => "status-expired",
                                        _ => "status-default"
                                    };
                                    var statusText = ticket.Status?.ToLowerInvariant() switch
                                    {
                                        "confirmed" => "Có hiệu lực",
                                        "used" => "Đã sử dụng",
                                        "cancelled" => "Đã hủy",
                                        "expired" => "Đã hết hạn",
                                        _ => ticket.Status
                                    };
                                    <tr>
                                        <td><strong class="ticket-code-cell">@ticket.TicketCode</strong></td>
                                        <td><strong>@ticket.EventTitle</strong></td>
                                        <td>
                                            <span>@ticket.TicketTypeName</span>
                                            @if (!string.IsNullOrWhiteSpace(ticket.SeatLabel))
                                            {
                                                <small>Ghế: @ticket.SeatLabel</small>
                                            }
                                        </td>
                                        <td><time>@ticket.EventStartTime.ToString("HH:mm dd/MM/yyyy")</time></td>
                                        <td>@ticket.VenueName</td>
                                        <td><span class="commerce-status @statusClass">@statusText</span></td>
                                        <td class="ticket-action-column">
                                            <a class="ticket-view-button" asp-action="Ticket" asp-route-id="@ticket.Id">Xem vé</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.TicketTotalPages > 1)
                    {
                        var firstPage = Math.Max(1, Model.TicketPage - 2);
                        var lastPage = Math.Min(Model.TicketTotalPages, Model.TicketPage + 2);
                        <nav class="ticket-pagination" aria-label="Phân trang vé">
                            <a class="ticket-page-link @(Model.TicketPage == 1 ? "disabled" : "")"
                               asp-action="MyTickets" asp-route-tab="tickets" asp-route-search="@Model.Search"
                               asp-route-status="@Model.Status" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageSize="@Model.TicketPageSize"
                               asp-route-page="@(Model.TicketPage - 1)">‹ Trước</a>
                            @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                            {
                                <a class="ticket-page-link @(pageNumber == Model.TicketPage ? "active" : "")"
                                   asp-action="MyTickets" asp-route-tab="tickets" asp-route-search="@Model.Search"
                                   asp-route-status="@Model.Status" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageSize="@Model.TicketPageSize"
                                   asp-route-page="@pageNumber">@pageNumber</a>
                            }
                            <a class="ticket-page-link @(Model.TicketPage == Model.TicketTotalPages ? "disabled" : "")"
                               asp-action="MyTickets" asp-route-tab="tickets" asp-route-search="@Model.Search"
                               asp-route-status="@Model.Status" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageSize="@Model.TicketPageSize"
                               asp-route-page="@(Model.TicketPage + 1)">Sau ›</a>
                        </nav>
                    }
                }
            </section>
        }

    </div>

</main>

<script>
    function updateBookingBadge() {
        const activeCards = document.querySelectorAll(
            ".booking-hold:not([data-expired='true'])"
        );

        const badge = document.getElementById("booking-tab-badge");

        if (activeCards.length === 0) {
            badge?.remove();
            return;
        }

        if (badge) {
            badge.textContent = activeCards.length;
        }
    }

    function showEmptyBookingState() {
        const bookingList = document.getElementById("booking-list");

        if (!bookingList) {
            return;
        }

        const activeCards = bookingList.querySelectorAll(
            ".booking-hold:not([data-expired='true'])"
        );

        if (activeCards.length > 0) {
            return;
        }

        bookingList.innerHTML = `
            <section class="commerce-empty-state">
                <div class="empty-state-icon">🎟️</div>
                <h2>Không có vé đang giữ</h2>
                <p>Các lượt giữ vé của bạn đã hết hạn.</p>
                <a class="commerce-button" href="/Event">
                    Khám phá sự kiện
                </a>
            </section>
        `;
    }

    function expireBookingCard(card) {
        if (card.dataset.expired === "true") {
            return;
        }

        card.dataset.expired = "true";

        const countdown = card.querySelector(".booking-countdown");
        const actions = card.querySelector(".booking-actions");
        const status = card.querySelector(".commerce-status");

        if (countdown) {
            countdown.textContent = "Đã hết hạn";
            countdown.classList.add("expired-label");
        }

        if (status) {
            status.textContent = "Đã hết hạn";
            status.classList.remove("status-active");
            status.classList.add("status-expired");
        }

        actions?.remove();

        card.classList.add("booking-expired");

        updateBookingBadge();

        // Xóa card sau một khoảng ngắn để người dùng thấy trạng thái thay đổi
        window.setTimeout(() => {
            card.remove();
            showEmptyBookingState();
        }, 1500);
    }

    function updateBookingCountdowns() {
        document.querySelectorAll(".booking-hold").forEach(card => {
            if (card.dataset.expired === "true") {
                return;
            }

            const output = card.querySelector(".booking-countdown");
            const expiresValue = card.dataset.expires;

            if (!output || !expiresValue) {
                return;
            }

            const expires = new Date(expiresValue).getTime();
            const remaining = expires - Date.now();

            if (Number.isNaN(expires) || remaining <= 0) {
                expireBookingCard(card);
                return;
            }

            const totalSeconds = Math.floor(remaining / 1000);

            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;

            output.textContent =
                `Còn ${minutes}:${seconds.toString().padStart(2, "0")}`;
        });
    }

    updateBookingCountdowns();

    const bookingTimer = window.setInterval(
        updateBookingCountdowns,
        1000
    );
</script>