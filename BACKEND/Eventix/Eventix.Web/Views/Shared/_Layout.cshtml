<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Eventix</title>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-container">

            <a class="brand"
               asp-controller="Home"
               asp-action="Index">
                Eventix
            </a>

            <form class="header-search"
                  asp-controller="Event"
                  asp-action="Index"
                  method="get">
                <input name="Search"
                       type="text"
                       placeholder="Tìm kiếm sự kiện..." />

                <button type="submit">Search</button>
            </form>

            <nav class="menu">
                <a asp-controller="Event" asp-action="Index">
                    Sự kiện
                </a>

                <a asp-controller="Category" asp-action="Index">
                    Danh mục
                </a>
            </nav>

            <div class="auth-actions">
                @if (Context.Request.Cookies["token"] != null)
                {
                    <a class="user-profile" asp-controller="User" asp-action="Profile">
                        <img src="@(Context.Request.Cookies["avatarUrl"] ?? "/images/default-avatar.png")"
                             alt="User avatar"
                             class="user-avatar" />

                        <span>
                            @(Context.Request.Cookies["userName"] ?? "My Account")
                        </span>
                    </a>

                    <a asp-controller="User"
                       asp-action="EditProfile">
                        Hồ sơ
                    </a>

                    <form asp-controller="Auth"
                          asp-action="Logout"
                          method="post">
                        <button type="submit">
                            Đăng xuất
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Auth"
                       asp-action="Login">
                        Đăng nhập
                    </a>

                    <a class="register-btn"
                       asp-controller="Auth"
                       asp-action="Register">
                        Đăng ký
                    </a>
                }
            </div>

        </div>
    </header>

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>