@{
    var roles = (Context.Request.Cookies["roles"] ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries);

    var isOrganizer = roles.Any(r =>
        r.Equals("Organizer", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Eventix</title>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/event-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/event.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/organizer.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-container">

            <a class="brand"
               asp-controller="Home"
               asp-action="Index">
                Eventix
            </a>

            <form class="header-search"
                  asp-controller="Event"
                  asp-action="Index"
                  method="get">
                <input name="Search"
                       type="text"
                       placeholder="Tìm kiếm sự kiện..." />

                <button type="submit">Search</button>
            </form>

            <nav class="menu">
                <a asp-controller="Event" asp-action="Index">
                    Sự kiện
                </a>

                <a asp-controller="Category" asp-action="Index">
                    Danh mục
                </a>
            </nav>

            <div class="auth-actions">
                @if (Context.Request.Cookies["token"] != null)
                {
                    @if (isOrganizer)
                    {
                        <a asp-controller="Organizer"
                           asp-action="Dashboard">
                            Sự kiện của tôi
                        </a>
                    }

                    <a class="user-profile" asp-controller="User" asp-action="Profile">
                        <img src="@(Context.Request.Cookies["avatarUrl"] ?? "/images/default-avatar.png")"
                             alt="User avatar"
                             class="user-avatar" />

                        <span>
                            @(Context.Request.Cookies["userName"] ?? "My Account")
                        </span>
                    </a>

                    <a asp-controller="User" asp-action="EditProfile">Hồ sơ</a>

                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Auth"
                       asp-action="Login">
                        Đăng nhập
                    </a>

                    <a class="register-btn"
                       asp-controller="Auth"
                       asp-action="Register">
                        Đăng ký
                    </a>
                }
            </div>

        </div>
    </header>

    @RenderBody()

    @if (Context.Request.Cookies["token"] != null && isOrganizer)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

        <script>
            const eventConnection = new signalR.HubConnectionBuilder()
                .withUrl("https://localhost:7162/hubs/events")
                .withAutomaticReconnect()
                .build();

            eventConnection.on("EventStatusChanged", function (data) {
                console.log("Event status changed:", data);

                const message = `${data.title}: ${data.oldStatus} → ${data.newStatus}`;

                const box = document.createElement("div");
                box.className = "realtime-toast";
                box.innerText = message;

                document.body.appendChild(box);

                setTimeout(() => {
                    box.remove();
                }, 4000);
            });

            eventConnection.start()
                .catch(err => console.error(err));
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>