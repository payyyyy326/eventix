@{
    Layout = "_Layout";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string ctrl, string act = "")
        => string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase)
        && (string.IsNullOrEmpty(act) || string.Equals(action, act, StringComparison.OrdinalIgnoreCase));
}

<div class="organizer-layout">

    <aside class="organizer-sidebar">

        <h2>Organizer</h2>

        <nav>

            <a asp-controller="Organizer" asp-action="Dashboard"
               class="@(IsActive("Organizer", "Dashboard") ? "active" : "")">
                Dashboard
            </a>

            <a asp-controller="Organizer" asp-action="Events"
               class="@(IsActive("Organizer", "Events") || IsActive("Organizer", "ManageEvent") ? "active" : "")">
                Quản lí sự kiện
            </a>

            <a asp-controller="EventWizard" asp-action="Step1"
               class="@(IsActive("EventWizard") ? "active" : "")">
                Tạo sự kiện
            </a>

            <a asp-controller="Organizer" asp-action="Profile"
               class="@(IsActive("Organizer", "Profile") ? "active" : "")">
                Hồ sơ tổ chức
            </a>

        </nav>

    </aside>

    <section class="organizer-content">
        @RenderBody()
    </section>

</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
