@model Eventix.Web.Models.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_Layout";
}

<section class="category-strip">
    <a asp-controller="Event"
       asp-action="Index"
       class="category-chip active">
        Tất cả
    </a>

    @foreach (var category in Model.Categories)
    {
        <a asp-controller="Event"
           asp-action="Index"
           asp-route-CategoryId="@category.Id"
           class="category-chip">
            @category.Name
        </a>
    }
</section>

<section class="featured-section">

    <div class="section-header">
        <span>Sắp diễn ra</span>
        <h2>Sự kiện sắp diễn ra</h2>
        <p>Đừng bỏ lỡ những sự kiện nổi bật sắp tới.</p>
    </div>

    <div class="featured-slider">
        @foreach (var item in Model.UpcomingEvents)
        {
            <article class="featured-card">
                <img src="@MediaUrl.Img(item.ImageUrl)"
                     alt="@item.Title" />

                <div class="featured-overlay">
                    <div class="featured-info">

                        <span class="event-category">
                            @item.CategoryName
                        </span>

                        <h3>@item.Title</h3>

                        <p>
                            @item.StartTime.ToString("dd/MM/yyyy")
                        </p>

                        <a class="featured-btn"
                           asp-controller="Event"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                            Xem chi tiết
                        </a>

                    </div>
                </div>
            </article>
        }
    </div>
</section>

<section class="home-section">

    <div class="section-header">
        <span>Xu hướng</span>
        <h2>Sự kiện được xem nhiều nhất</h2>
        <p>Những sự kiện phổ biến dựa trên sự quan tâm của người dùng.</p>
    </div>

    <div class="slider-wrapper">

        <button class="slider-btn prev"
                onclick="scrollSlider('trendingSlider', -1)">
            &#10094;
        </button>

        <div class="event-slider" id="trendingSlider">

            @foreach (var item in Model.TrendingEvents)
            {
                <a class="event-card"
                   asp-controller="Event"
                   asp-action="Details"
                   asp-route-id="@item.Id">

                    <img src="@MediaUrl.Img(item.ImageUrl)"
                         alt="@item.Title" />

                    <div class="event-card-body">
                        <span>@item.CategoryName</span>

                        <h3>@item.Title</h3>

                        <p>
                            @item.StartTime.ToString("dd/MM/yyyy")
                        </p>

                        @if (item.MinPrice.HasValue)
                        {
                            <p class="event-price">
                                Từ @item.MinPrice.Value.ToString("#,##0") VND
                            </p>
                        }
                        else
                        {
                            <p class="event-price">
                                Liên hệ ban tổ chức
                            </p>
                        }
                    </div>
                </a>
            }

        </div>

        <button class="slider-btn next"
                onclick="scrollSlider('trendingSlider', 1)">
            &#10095;
        </button>

    </div>

</section>

<section class="home-section">

    <div class="section-header">
        <span>Nổi bật</span>
        <h2>Sự kiện nổi bật</h2>
        <p>Những sự kiện nổi bật được đội ngũ của chúng tôi lựa chọn.</p>
    </div>

    <div class="slider-wrapper">

        <button class="slider-btn prev"
                onclick="scrollSlider('featuredSlider', -1)">
            &#10094;
        </button>

        <div class="event-slider" id="featuredSlider">

            @foreach (var item in Model.FeaturedEvents)
            {
                <a class="event-card"
                   asp-controller="Event"
                   asp-action="Details"
                   asp-route-id="@item.Id">

                    <img src="@MediaUrl.Img(item.ImageUrl)"
                         alt="@item.Title" />

                    <div class="event-card-body">
                        <span>@item.CategoryName</span>

                        <h3>@item.Title</h3>

                        <p>
                            @item.StartTime.ToString("dd/MM/yyyy")
                        </p>

                        @if (item.MinPrice.HasValue)
                        {
                            <p class="event-price">
                                Từ @item.MinPrice.Value.ToString("#,##0") VND
                            </p>
                        }
                        else
                        {
                            <p class="event-price">
                                Liên hệ ban tổ chức
                            </p>
                        }
                    </div>
                </a>
            }

        </div>

        <button class="slider-btn next"
                onclick="scrollSlider('featuredSlider', 1)">
            &#10095;
        </button>

    </div>

</section>

<section class="home-section">

    <div class="section-header section-header-row">
        <div>
            <span>Sự kiện</span>
            <h2>Khám phá sự kiện</h2>
            <p>Khám phá thêm nhiều sự kiện thuộc các danh mục khác nhau.</p>
        </div>

        <a class="view-all-btn"
           asp-controller="Event"
           asp-action="Index">
            Xem tất cả
        </a>
    </div>

    <div class="event-grid">
        @foreach (var item in Model.Events.Take(8))
        {
            <a class="event-card"
               asp-controller="Event"
               asp-action="Details"
               asp-route-id="@item.Id">

                <img src="@MediaUrl.Img(item.ImageUrl)"
                     alt="@item.Title" />

                <div class="event-card-body">
                    <span>@item.CategoryName</span>

                    <h3>@item.Title</h3>

                    <p>
                        @item.StartTime.ToString("dd/MM/yyyy")
                    </p>

                    @if (item.MinPrice.HasValue)
                    {
                        <p class="event-price">
                            Từ @item.MinPrice.Value.ToString("#,##0") VND
                        </p>
                    }
                    else
                    {
                        <p class="event-price">
                            Liên hệ ban tổ chức
                        </p>
                    }
                </div>
            </a>
        }
    </div>

</section>

<script>
    function scrollSlider(id, direction) {
        const slider = document.getElementById(id);

        slider.scrollBy({
            left: direction * 320,
            behavior: 'smooth'
        });

        setTimeout(() => updateButtons(id), 300);
    }

    function updateButtons(id) {
        const slider = document.getElementById(id);

        const wrapper = slider.parentElement;
        const prevBtn = wrapper.querySelector('.prev');
        const nextBtn = wrapper.querySelector('.next');

        // Đang ở đầu danh sách
        if (slider.scrollLeft <= 5) {
            prevBtn.style.display = 'none';
        } else {
            prevBtn.style.display = 'flex';
        }

        // Đang ở cuối danh sách
        if (
            slider.scrollLeft + slider.clientWidth >=
            slider.scrollWidth - 5
        ) {
            nextBtn.style.display = 'none';
        } else {
            nextBtn.style.display = 'flex';
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.event-slider').forEach(slider => {

            updateButtons(slider.id);

            slider.addEventListener('scroll', () => {
                updateButtons(slider.id);
            });

        });
    });
</script>
```
