@model Eventix.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<section class="category-strip">
    <a asp-controller="Event"
       asp-action="Index"
       class="category-chip active">
        T?t c?
    </a>

    @foreach (var category in Model.Categories)
    {
        <a asp-controller="Event"
           asp-action="Index"
           asp-route-CategoryId="@category.Id"
           class="category-chip">
            @category.Name
        </a>
    }
</section>

<section class="featured-section">

    <div class="section-header">
        <span>Upcoming</span>
        <h2>Upcoming Events</h2>
        <p>Don't miss the next big events.</p>
    </div>

    <div class="featured-slider">
        @foreach (var item in Model.UpcomingEvents)
        {
            <article class="featured-card">
                <img src="@MediaUrl.Img(item.ImageUrl)"
                     alt="@item.Title" />

                <div class="featured-overlay">
                    <div class="featured-info">

                        <span class="event-category">
                            @item.CategoryName
                        </span>

                        <h3>@item.Title</h3>

                        <p>
                            @item.StartTime.ToString("dd/MM/yyyy")
                        </p>

                        <a class="featured-btn"
                           asp-controller="Event"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                            Xem chi ti?t
                        </a>

                    </div>
                </div>
            </article>
        }
    </div>
</section>


<section class="home-section">

    <div class="section-header">
        <span>Trending</span>
        <h2>Most Viewed Events</h2>
        <p>Popular events based on audience interest.</p>
    </div>

    <div class="slider-wrapper">

        <button class="slider-btn prev" onclick="scrollSlider('trendingSlider', -1)">
            ?
        </button>

        <div class="event-slider" id="trendingSlider">

            @foreach (var item in Model.TrendingEvents)
            {
                <a class="event-card"
                   asp-controller="Event"
                   asp-action="Details"
                   asp-route-id="@item.Id">
                    <img src="@MediaUrl.Img(item.ImageUrl)" alt="@item.Title" />

                    <div class="event-card-body">
                        <span>@item.CategoryName</span>
                        <h3>@item.Title</h3>
                        <p>@item.StartTime.ToString("dd/MM/yyyy")</p>

                        <p class="event-price">
                            From @item.MinPrice?.ToString("N0") VND
                        </p>
                    </div>
                </a>
            }

        </div>

        <button class="slider-btn next" onclick="scrollSlider('trendingSlider', 1)">
            ?
        </button>

    </div>

</section>

<section class="home-section">

    <div class="section-header">
        <span>Featured</span>
        <h2>Featured Events</h2>
        <p>Highlighted events selected by our team.</p>
    </div>

    <div class="slider-wrapper">

        <button class="slider-btn prev" onclick="scrollSlider('featuredSlider', -1)">
            ?
        </button>

        <div class="event-slider" id="featuredSlider">

            @foreach (var item in Model.FeaturedEvents)
            {
                <a class="event-card"
                   asp-controller="Event"
                   asp-action="Details"
                   asp-route-id="@item.Id">
                    <img src="@MediaUrl.Img(item.ImageUrl)" alt="@item.Title" />

                    <div class="event-card-body">
                        <span>@item.CategoryName</span>
                        <h3>@item.Title</h3>
                        <p>@item.StartTime.ToString("dd/MM/yyyy")</p>

                        @if (item.MinPrice.HasValue)
                        {
                            <p class="event-price">
                                From @item.MinPrice.Value.ToString("N0") d
                            </p>
                        }
                    </div>
                </a>
            }

        </div>

        <button class="slider-btn next" onclick="scrollSlider('featuredSlider', 1)">
            ?
        </button>

    </div>

</section>
<section class="home-section">

    <div class="section-header section-header-row">
        <div>
            <span>Events</span>
            <h2>Explore Events</h2>
            <p>Discover more events across all categories.</p>
        </div>

        <a class="view-all-btn"
           asp-controller="Event"
           asp-action="Index">
            View all
        </a>
    </div>

    <div class="event-grid">
        @foreach (var item in Model.Events.Take(8))
        {
            <a class="event-card"
               asp-controller="Event"
               asp-action="Details"
               asp-route-id="@item.Id">

                <img src="@MediaUrl.Img(item.ImageUrl)"
                     alt="@item.Title" />

                <div class="event-card-body">
                    <span>@item.CategoryName</span>

                    <h3>@item.Title</h3>

                    <p>@item.StartTime.ToString("dd/MM/yyyy")</p>

                    @if (item.MinPrice.HasValue)
                    {
                        <p class="event-price">
                            From @item.MinPrice.Value.ToString("N0") VND
                        </p>
                    }
                    else
                    {
                        <p class="event-price">
                            Contact organizer
                        </p>
                    }
                </div>
            </a>
        }
    </div>

</section>

<script>
    function scrollSlider(id, direction) {
        const slider = document.getElementById(id);

        slider.scrollBy({
            left: direction * 320,
            behavior: 'smooth'
        });

        setTimeout(() => updateButtons(id), 300);
    }

    function updateButtons(id) {
        const slider = document.getElementById(id);

        const wrapper = slider.parentElement;
        const prevBtn = wrapper.querySelector('.prev');
        const nextBtn = wrapper.querySelector('.next');

        // Ðang ? d?u
        if (slider.scrollLeft <= 5) {
            prevBtn.style.display = 'none';
        } else {
            prevBtn.style.display = 'flex';
        }

        // Ðang ? cu?i
        if (
            slider.scrollLeft + slider.clientWidth >=
            slider.scrollWidth - 5
        ) {
            nextBtn.style.display = 'none';
        } else {
            nextBtn.style.display = 'flex';
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.event-slider').forEach(slider => {

            updateButtons(slider.id);

            slider.addEventListener('scroll', () => {
                updateButtons(slider.id);
            });

        });
    });
</script>