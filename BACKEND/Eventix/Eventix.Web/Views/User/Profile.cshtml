@model Eventix.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ";
    Layout = "_Layout";
    var showEdit = ViewBag.ShowEdit as bool? ?? false;
}

<section class="profile-page">
    <div class="profile-card">

        <div class="profile-top">
            <div class="profile-avatar-wrap">
                <img src="@(Model.Profile.AvatarUrl ?? "/images/default-avatar.png")"
                     class="profile-avatar"
                     alt="Avatar" />
                <label class="avatar-change-btn" title="Đổi ảnh đại diện">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
                        <path d="M2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4H2zm.5 2a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1zm9 2.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0z"/>
                    </svg>
                    <form id="avatar-form"
                          asp-controller="User"
                          asp-action="UploadAvatar"
                          method="post"
                          enctype="multipart/form-data">
                        <input type="file" name="avatar" accept="image/*"
                               onchange="document.getElementById('avatar-form').submit()" />
                    </form>
                </label>
            </div>
            <div class="profile-top-info">
                <h1>@Model.Profile.FullName</h1>
                <p>@Model.Profile.Email</p>
                <button type="button" class="profile-edit-trigger" onclick="openEditModal()">
                    ✏️ Chỉnh sửa hồ sơ
                </button>
            </div>
        </div>

        <div class="profile-info">
            <div class="profile-info-item">
                <span>Số điện thoại</span>
                <strong>@(string.IsNullOrEmpty(Model.Profile.PhoneNumber) ? "Chưa cập nhật" : Model.Profile.PhoneNumber)</strong>
            </div>
            <div class="profile-info-item">
                <span>Trạng thái</span>
                <strong>@Model.Profile.Status</strong>
            </div>
            <div class="profile-info-item">
                <span>Xác minh email</span>
                <strong class="@(Model.Profile.EmailVerified ? "verified" : "unverified")">
                    @(Model.Profile.EmailVerified ? "✓ Đã xác minh" : "✗ Chưa xác minh")
                </strong>
            </div>
            <div class="profile-info-item">
                <span>Ngày tham gia</span>
                <strong>@Model.Profile.CreatedAt.ToString("dd/MM/yyyy")</strong>
            </div>
        </div>

    </div>
</section>

<div class="edit-modal-backdrop" id="edit-modal-backdrop" onclick="closeEditModal(event)">
    <div class="edit-modal" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">

        <div class="edit-modal-header">
            <h2 id="edit-modal-title">Chỉnh sửa hồ sơ</h2>
            <button type="button" class="edit-modal-close" onclick="closeEditModal(null)" aria-label="Đóng">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                </svg>
            </button>
        </div>

        <form asp-controller="User" asp-action="EditProfile" method="post" class="edit-modal-form">

            @if (!ViewData.ModelState.IsValid && showEdit)
            {
                <div class="edit-modal-errors">
                    @foreach (var entry in ViewData.ModelState.Values)
                    {
                        foreach (var error in entry.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    }
                </div>
            }

            <div class="edit-modal-avatar-row">
                <img src="@(Model.Profile.AvatarUrl ?? "/images/default-avatar.png")"
                     class="edit-modal-avatar"
                     alt="Avatar" />
                <div>
                    <p class="edit-modal-name">@Model.Profile.FullName</p>
                    <p class="edit-modal-email">@Model.Profile.Email</p>
                </div>
            </div>

            <div class="edit-modal-divider"></div>

            <div class="edit-modal-field">
                <label asp-for="EditRequest.FullName">Họ và tên</label>
                <input asp-for="EditRequest.FullName" placeholder="Nhập họ và tên..." />
                @if (showEdit)
                {
                    <span asp-validation-for="EditRequest.FullName" class="field-error"></span>
                }
            </div>

            <div class="edit-modal-field">
                <label asp-for="EditRequest.PhoneNumber">Số điện thoại</label>
                <input asp-for="EditRequest.PhoneNumber" placeholder="Nhập số điện thoại..." />
                @if (showEdit)
                {
                    <span asp-validation-for="EditRequest.PhoneNumber" class="field-error"></span>
                }
            </div>

            <div class="edit-modal-actions">
                <button type="button" class="edit-modal-cancel" onclick="closeEditModal(null)">Huỷ</button>
                <button type="submit" class="edit-modal-submit">Lưu thay đổi</button>
            </div>

        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="profile-toast profile-toast--success" id="profile-toast">
        ✓ @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="profile-toast profile-toast--error" id="profile-toast">
        ✗ @TempData["Error"]
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openEditModal() {
            document.getElementById('edit-modal-backdrop').classList.add('is-open');
            document.body.style.overflow = 'hidden';
        }

        function closeEditModal(e) {
            if (e && e.target !== document.getElementById('edit-modal-backdrop')) return;
            document.getElementById('edit-modal-backdrop').classList.remove('is-open');
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeEditModal(null);
        });

        @if (showEdit)
        {
            <text>openEditModal();</text>
        }

        const toast = document.getElementById('profile-toast');
        if (toast) {
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(12px)';
                setTimeout(() => toast.remove(), 400);
            }, 3000);
        }
    </script>
}
