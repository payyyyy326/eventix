@model Eventix.Share.Organizer.OrganizerProfileResponse
@{
    ViewData["Title"] = "Trạng thái đăng ký Organizer";
    Layout = "_Layout";

    var statusClass = Model.Status?.ToLowerInvariant() switch
    {
        "approved"  => "badge-green",
        "rejected"  => "badge-red",
        "suspended" => "badge-red",
        _           => "badge-yellow"
    };
    var statusLabel = Model.Status?.ToLowerInvariant() switch
    {
        "approved"  => "✓ Đã duyệt",
        "rejected"  => "✗ Bị từ chối",
        "suspended" => "⚠ Tạm ngưng",
        _           => "⏳ Chờ duyệt"
    };
    var statusDesc = Model.Status?.ToLowerInvariant() switch
    {
        "approved"  => "Chúc mừng! Tài khoản của bạn đã được cấp quyền Organizer. Hãy đăng nhập lại để áp dụng.",
        "rejected"  => "Đơn đăng ký của bạn đã bị từ chối. Vui lòng liên hệ Admin để biết thêm chi tiết.",
        "suspended" => "Tài khoản Organizer của bạn đang bị tạm ngưng. Vui lòng liên hệ Admin.",
        _           => "Đơn đăng ký đang chờ Admin xét duyệt. Thường mất 1–3 ngày làm việc."
    };
}

<section class="profile-page">
    <div class="profile-card" style="max-width:600px;">

        <div style="margin-bottom:24px;">
            <h1 style="font-size:24px;font-weight:700;color:#f0f0ff;margin:0 0 8px;">
                Trạng thái đăng ký Organizer
            </h1>
            <p style="color:#9fa3c0;font-size:14px;margin:0;">
                Theo dõi quá trình xét duyệt đơn đăng ký của bạn.
            </p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="profile-toast profile-toast--success" style="position:static;margin-bottom:16px;opacity:1;transform:none;">
                ✓ @TempData["Success"]
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.3);border-radius:10px;padding:12px 16px;margin-bottom:16px;color:#a5b4fc;font-size:14px;">
                ℹ️ @TempData["Info"]
            </div>
        }

        @* Status banner *@
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;margin-bottom:20px;display:flex;align-items:center;gap:20px;">
            <div style="width:56px;height:56px;border-radius:50%;background:rgba(130,100,255,0.15);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">
                @(Model.Status?.ToLower() == "approved" ? "🎉" :
                  Model.Status?.ToLower() == "rejected" ? "❌" : "⏳")
            </div>
            <div>
                <span class="badge @statusClass" style="font-size:14px;padding:5px 14px;margin-bottom:8px;display:inline-block;">
                    @statusLabel
                </span>
                <p style="margin:0;color:#9fa3c0;font-size:13px;line-height:1.6;">@statusDesc</p>
            </div>
        </div>

        @* Thông tin tổ chức *@
        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:20px;margin-bottom:20px;">
            <h3 style="margin:0 0 16px;font-size:15px;font-weight:700;color:#c4c8e8;">Thông tin đã đăng ký</h3>
            <div style="display:grid;gap:12px;">
                <div style="display:flex;justify-content:space-between;font-size:13px;">
                    <span style="color:#888aaa;">Tên tổ chức</span>
                    <strong style="color:#e2e5f0;">@Model.OrganizationName</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ContactEmail))
                {
                    <div style="display:flex;justify-content:space-between;font-size:13px;">
                        <span style="color:#888aaa;">Email liên hệ</span>
                        <strong style="color:#e2e5f0;">@Model.ContactEmail</strong>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                {
                    <div style="display:flex;justify-content:space-between;font-size:13px;">
                        <span style="color:#888aaa;">Số điện thoại</span>
                        <strong style="color:#e2e5f0;">@Model.ContactPhone</strong>
                    </div>
                }
                <div style="display:flex;justify-content:space-between;font-size:13px;">
                    <span style="color:#888aaa;">Ngày nộp đơn</span>
                    <strong style="color:#e2e5f0;">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
                @if (Model.ApprovedAt.HasValue)
                {
                    <div style="display:flex;justify-content:space-between;font-size:13px;">
                        <span style="color:#888aaa;">Ngày xét duyệt</span>
                        <strong style="color:#e2e5f0;">@Model.ApprovedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                }
            </div>
        </div>

        @* Buttons *@
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <a asp-controller="User" asp-action="Profile"
               style="padding:10px 20px;border-radius:10px;border:1px solid rgba(255,255,255,0.14);background:rgba(255,255,255,0.06);color:#c4c8e8;text-decoration:none;font-weight:600;font-size:14px;display:inline-flex;align-items:center;">
                ← Về trang cá nhân
            </a>

            @if (Model.Status?.ToLower() == "approved")
            {
                <a asp-controller="Organizer" asp-action="Dashboard"
                   style="padding:10px 24px;border-radius:10px;background:linear-gradient(135deg,#6d4aff,#9b59ff);color:#fff;text-decoration:none;font-weight:700;font-size:14px;display:inline-flex;align-items:center;gap:8px;">
                    🚀 Vào Organizer Dashboard
                </a>
            }
            @if (Model.Status?.ToLower() == "rejected")
            {
                <a asp-controller="User" asp-action="RegisterOrganizer"
                   style="padding:10px 24px;border-radius:10px;background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.35);color:#f87171;text-decoration:none;font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:8px;">
                    🔄 Gửi lại đơn
                </a>
            }
        </div>

    </div>
</section>
