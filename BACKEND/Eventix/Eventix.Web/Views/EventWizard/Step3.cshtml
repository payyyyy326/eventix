@using Eventix.Web.Models.EventWizard
@model EventTicketTypesViewModel

@{
    ViewData["Title"] = "Tạo sự kiện - Bước 3";
    Layout = "_OrganizerLayout";

    var ticketTypes = Model.TicketTypes ?? new();

    var totalTickets   = ticketTypes.Sum(t => t.Quantity);
    var seatedTickets  = ticketTypes.Count(t => t.IsSeatRequired);
    var generalTickets = ticketTypes.Count(t => !t.IsSeatRequired);
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <a class="wizard-back-link"
               asp-controller="EventWizard"
               asp-action="Step2">
                ← Quay lại Địa điểm
            </a>

            <div class="wizard-title">
                <span>Tạo sự kiện</span>
                <h1>Bước 3: Loại vé</h1>
                <p>
                    Tạo các loại vé và thiết lập giá.
                    Vé có ghế ngồi sẽ tự động tạo ghế khi sự kiện được công bố.
                </p>
            </div>

            @await Html.PartialAsync("_WizardProgress")
        </div>

        <div class="wizard-panel">

            <div class="wizard-grid-3 mb-4">
                <div class="wizard-stat">
                    <span>Loại vé</span>
                    <strong>@ticketTypes.Count</strong>
                </div>
                <div class="wizard-stat">
                    <span>Tổng số vé</span>
                    <strong>@totalTickets</strong>
                </div>
                <div class="wizard-stat">
                    <span>Có ghế / Đứng</span>
                    <strong>@seatedTickets / @generalTickets</strong>
                </div>
            </div>

            <div class="wizard-card mb-4">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h3>@(Model.Venue?.Name ?? "Địa điểm đã chọn")</h3>
                        <p>@(Model.Venue?.Address ?? "Chưa có địa chỉ")</p>
                    </div>
                </div>
                <div class="wizard-meta">
                    <span class="wizard-pill neutral">
                        Số vé đã tạo: @totalTickets.ToString("#,##0")
                    </span>
                </div>
            </div>

            <div class="wizard-card mb-4">
                <h3>Thêm loại vé</h3>
                <p>
                    Chọn Vào tự do hoặc Có ghế ngồi.
                    Vé có ghế ngồi sẽ tự động tạo ghế bằng số lượng vé.
                </p>

                <form asp-controller="EventWizard"
                      asp-action="AddTicketType"
                      method="post"
                      class="mt-4"
                      id="addTicketTypeForm">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="wizard-card ticket-form-section mb-3">
                        <div class="ticket-form-heading">
                            <h4>Thông tin cơ bản</h4>
                            <p>Tên, loại và số lượng vé.</p>
                        </div>

                        <div class="wizard-grid-2 mt-3">
                            <div class="form-group">
                                <label asp-for="NewTicketType.Name">Tên loại vé</label>
                                <input asp-for="NewTicketType.Name"
                                       class="form-control"
                                       placeholder="VIP, Thường, Đứng, Early Bird..."
                                       autocomplete="off" />
                                <span asp-validation-for="NewTicketType.Name" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label>Loại vé</label>
                                <div class="d-flex gap-3 mt-2">
                                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                                        <input asp-for="NewTicketType.IsSeatRequired"
                                               type="radio"
                                               value="false"
                                               id="radioStanding"
                                               checked="checked" />
                                        <span>Vào tự do</span>
                                    </label>
                                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                                        <input asp-for="NewTicketType.IsSeatRequired"
                                               type="radio"
                                               value="true"
                                               id="radioSeated" />
                                        <span>Có ghế ngồi</span>
                                    </label>
                                </div>
                                <small class="text-muted mt-1">
                                    Vé có ghế ngồi sẽ tự động tạo ghế bằng số lượng bạn nhập.
                                </small>
                            </div>
                        </div>

                        <div class="wizard-grid-2 mt-3">
                            <div class="form-group">
                                <label asp-for="NewTicketType.Quantity">Số lượng</label>
                                <input asp-for="NewTicketType.Quantity"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       placeholder="100"
                                       id="ticketQuantityInput" />
                                <span asp-validation-for="NewTicketType.Quantity" class="text-danger"></span>
                                <small class="text-muted" id="zoneCapacityHint"></small>
                            </div>

                            <div class="form-group">
                                <label asp-for="NewTicketType.Price">Giá vé</label>
                                <div class="ticket-price-input">
                                    <input asp-for="NewTicketType.Price"
                                           type="number"
                                           min="0"
                                           step="1000"
                                           class="form-control"
                                           placeholder="500,000" />
                                    <span>VND</span>
                                </div>
                                <span asp-validation-for="NewTicketType.Price" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="wizard-card ticket-form-section mb-3">
                        <div class="ticket-form-heading">
                            <h4>Thời gian bán vé</h4>
                            <p>Xác định khoảng thời gian khách hàng có thể mua vé này.</p>
                        </div>

                        <div class="wizard-grid-2 mt-3">
                            <div class="form-group">
                                <label asp-for="NewTicketType.SaleStartTime">Bắt đầu bán</label>
                                <input name="_saleStartLocal"
                                       id="saleStartInput"
                                       type="datetime-local"
                                       class="form-control"
                                       value="@(Model.NewTicketType.SaleStartTime == default ? "" : Model.NewTicketType.SaleStartTime.ToString("yyyy-MM-ddTHH:mm"))" />
                                <input type="hidden" name="NewTicketType.SaleStartTime" id="saleStartUtc" />
                                <span asp-validation-for="NewTicketType.SaleStartTime" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NewTicketType.SaleEndTime">Kết thúc bán</label>
                                <input name="_saleEndLocal"
                                       id="saleEndInput"
                                       type="datetime-local"
                                       class="form-control"
                                       value="@(Model.NewTicketType.SaleEndTime == default ? "" : Model.NewTicketType.SaleEndTime.ToString("yyyy-MM-ddTHH:mm"))" />
                                <input type="hidden" name="NewTicketType.SaleEndTime" id="saleEndUtc" />
                                <span asp-validation-for="NewTicketType.SaleEndTime" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="wizard-card ticket-form-section mb-4">
                        <div class="ticket-form-heading">
                            <h4>Chi tiết vé</h4>
                            <p>Thêm mô tả và xem cấu hình ghế ngồi.</p>
                        </div>

                        <div class="form-group mt-3">
                            <label asp-for="NewTicketType.Description">Mô tả</label>
                            <textarea asp-for="NewTicketType.Description"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Mô tả quyền lợi, điều kiện vào cổng...">
                            </textarea>
                            <span asp-validation-for="NewTicketType.Description" class="text-danger"></span>
                        </div>

                        <div class="ticket-seat-status mt-3" id="ticketSeatStatus">
                            <input asp-for="NewTicketType.IsSeatRequired"
                                   type="checkbox"
                                   id="seatRequiredCheckbox"
                                   hidden />
                            <div>
                                <span class="wizard-pill neutral" id="seatTypeBadge">Chọn loại vé</span>
                                <p id="seatTypeDescription">
                                    Cấu hình ghế ngồi sẽ được xác định theo loại vé bạn chọn.
                                </p>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="wizard-btn-primary">
                        + Thêm loại vé
                    </button>
                </form>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <h3 class="text-white mb-1">Danh sách loại vé</h3>
                        <p class="text-muted mb-0">Xem lại tất cả loại vé đã tạo cho sự kiện này.</p>
                    </div>
                    <span class="wizard-pill info">@ticketTypes.Count loại vé</span>
                </div>

                @if (!ticketTypes.Any())
                {
                    <div class="organizer-empty">
                        <h2>Chưa có loại vé nào</h2>
                        <p>Thêm ít nhất một loại vé trước khi tiếp tục.</p>
                    </div>
                }
                else
                {
                    <div class="ticket-type-grid">
                        @for (int i = 0; i < ticketTypes.Count; i++)
                        {
                            var ticket = ticketTypes[i];
                            var priceLabel = ticket.Price <= 0
                                ? "Miễn phí"
                                : $"{ticket.Price:#,##0} VND";

                            <article class="ticket-type-card" id="ticket-card-@i">
                                <div class="ticket-type-card-header">
                                    <div>
                                        <h4>@ticket.Name</h4>
                                        <div class="wizard-meta">
                                            <span class="wizard-pill @(ticket.IsSeatRequired ? "" : "info")">
                                                @(ticket.IsSeatRequired ? "Có ghế ngồi" : "Vào tự do")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="ticket-type-price">
                                        <strong>@priceLabel</strong>
                                        <span>mỗi vé</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(ticket.Description))
                                {
                                    <p class="ticket-type-description">@ticket.Description</p>
                                }

                                <div class="ticket-type-details">
                                    <div>
                                        <span>Số lượng</span>
                                        <strong>@ticket.Quantity.ToString("#,##0")</strong>
                                    </div>
                                    <div>
                                        <span>Loại</span>
                                        <strong>@(ticket.IsSeatRequired ? "Có ghế" : "Đứng")</strong>
                                    </div>
                                    <div>
                                        <span>Bắt đầu bán</span>
                                        <strong>@ticket.SaleStartTime.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                    <div>
                                        <span>Kết thúc bán</span>
                                        <strong>@ticket.SaleEndTime.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                </div>

                                <div class="ticket-card-actions mt-3" style="display:flex;gap:8px;border-top:1px solid rgba(255,255,255,0.07);padding-top:12px;">
                                    <button type="button"
                                            class="wizard-btn-secondary"
                                            style="padding:6px 16px;font-size:0.83rem;"
                                            onclick="openEditModal(@i,
                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ticket.Name)),
                                                @ticket.Price,
                                                @ticket.Quantity,
                                                @(ticket.IsSeatRequired ? "true" : "false"),
                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ticket.SaleStartTime.ToString("yyyy-MM-ddTHH:mm:ss") + "Z")),
                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ticket.SaleEndTime.ToString("yyyy-MM-ddTHH:mm:ss") + "Z")),
                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ticket.Description ?? "")))">
                                        ✏️ Sửa
                                    </button>
                                    <button type="button"
                                            style="padding:6px 16px;font-size:0.83rem;background:rgba(239,68,68,0.14);color:#f87171;border:1px solid rgba(239,68,68,0.3);border-radius:8px;cursor:pointer;font-weight:600;"
                                            onclick="deleteTicket(@i, '@ticket.Name')">
                                        🗑 Xóa
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>

            <div class="wizard-actions">
                <a asp-controller="EventWizard"
                   asp-action="Step2"
                   class="wizard-btn-secondary">
                    ← Quay lại
                </a>

                <form asp-controller="EventWizard"
                      asp-action="Step3Continue"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="wizard-btn-primary"
                            disabled="@(!ticketTypes.Any())">
                        Tiếp theo: Xem trước ghế →
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @* ── Edit ticket modal ────────────────────────────────────────────── *@
    <div id="editTicketModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:1000;align-items:center;justify-content:center;">
        <div style="background:#1a1a35;border:1px solid rgba(255,255,255,0.12);border-radius:20px;padding:28px 32px;width:min(560px,94vw);max-height:90vh;overflow-y:auto;">
            <h3 style="margin:0 0 18px;color:#f0f0ff;font-size:18px;">Chỉnh sửa loại vé</h3>
            <div id="editTicketError" style="display:none;color:#f87171;margin-bottom:12px;padding:10px 14px;background:rgba(239,68,68,0.1);border-radius:8px;font-size:14px;"></div>

            <input type="hidden" id="editIndex" />

            <div class="wizard-grid-2 mb-3">
                <div class="form-group">
                    <label>Tên loại vé <span style="color:#f87171">*</span></label>
                    <input id="et-name" class="form-control" placeholder="VIP, Thường..." />
                </div>
                <div class="form-group">
                    <label>Loại vé</label>
                    <div style="display:flex;gap:16px;margin-top:10px;">
                        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                            <input type="radio" name="et-type" id="et-standing" value="false" /> Vào tự do
                        </label>
                        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                            <input type="radio" name="et-type" id="et-seated" value="true" /> Có ghế ngồi
                        </label>
                    </div>
                </div>
            </div>

            <div class="wizard-grid-2 mb-3">
                <div class="form-group">
                    <label>Giá vé (VND)</label>
                    <input id="et-price" type="number" min="0" step="1000" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Số lượng <span style="color:#f87171">*</span></label>
                    <input id="et-qty" type="number" min="1" class="form-control" />
                </div>
            </div>

            <div class="wizard-grid-2 mb-3">
                <div class="form-group">
                    <label>Bắt đầu bán <span style="color:#f87171">*</span></label>
                    <input id="et-sale-start" type="datetime-local" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Kết thúc bán <span style="color:#f87171">*</span></label>
                    <input id="et-sale-end" type="datetime-local" class="form-control" />
                </div>
            </div>

            <div class="form-group mb-4">
                <label>Mô tả</label>
                <textarea id="et-desc" rows="3" class="form-control" placeholder="Quyền lợi, điều kiện..."></textarea>
            </div>

            <div style="display:flex;gap:10px;justify-content:flex-end;">
                <button type="button" onclick="saveEditTicket()"
                        style="padding:10px 22px;background:linear-gradient(135deg,#6d4aff,#9b59ff);color:#fff;border:none;border-radius:10px;font-weight:700;cursor:pointer;">
                    Lưu thay đổi
                </button>
                <button type="button" onclick="closeEditModal()"
                        style="padding:10px 18px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.14);color:#c4c8e8;border-radius:10px;font-weight:600;cursor:pointer;">
                    Huỷ
                </button>
            </div>
        </div>
    </div>

    <script>
        // ── Datetime helpers ────────────────────────────────────────────────
        function toLocalInput(isoStr) {
            if (!isoStr) return '';
            const d = new Date(isoStr);
            const pad = n => String(n).padStart(2, '0');
            return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
        }
        function toLocalDatetimeValue(date) {
            const pad = n => String(n).padStart(2, '0');
            return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
        }

        // ── Add-ticket form: seat radio badge update ────────────────────────
        document.addEventListener("DOMContentLoaded", function () {
            const radioStanding = document.getElementById("radioStanding");
            const radioSeated   = document.getElementById("radioSeated");
            const badge         = document.getElementById("seatTypeBadge");
            const desc          = document.getElementById("seatTypeDescription");

            function updateBadge() {
                const isSeated = radioSeated?.checked;
                if (badge) {
                    badge.textContent = isSeated ? "Có ghế ngồi" : "Vào tự do";
                    badge.className   = isSeated ? "wizard-pill" : "wizard-pill info";
                }
                if (desc) {
                    desc.textContent = isSeated
                        ? "Ghế sẽ được tự động tạo bằng số lượng bạn nhập."
                        : "Khách hàng chọn số lượng vé, không cần chỉ định ghế cụ thể.";
                }
            }

            radioStanding?.addEventListener("change", updateBadge);
            radioSeated?.addEventListener("change", updateBadge);
            updateBadge();

            const now    = new Date();
            const nowStr = toLocalDatetimeValue(now);
            const saleStart = document.getElementById('saleStartInput');
            const saleEnd   = document.getElementById('saleEndInput');

            if (saleStart) {
                saleStart.setAttribute('min', nowStr);
                if (!saleStart.value) {
                    const d = new Date(now);
                    d.setHours(d.getHours() + 1, 0, 0, 0);
                    saleStart.value = toLocalDatetimeValue(d);
                }
                saleStart.addEventListener('change', function () {
                    if (saleEnd) saleEnd.setAttribute('min', this.value);
                    if (saleEnd?.value && saleEnd.value <= this.value) saleEnd.value = '';
                });
            }

            if (saleEnd) {
                saleEnd.setAttribute('min', nowStr);
                if (!saleEnd.value) {
                    const d = new Date(now);
                    d.setDate(d.getDate() + 7);
                    d.setMinutes(0, 0, 0);
                    saleEnd.value = toLocalDatetimeValue(d);
                }
            }

            document.getElementById('addTicketTypeForm')?.addEventListener('submit', function () {
                const startVal = saleStart?.value;
                const endVal   = saleEnd?.value;
                if (startVal) document.getElementById('saleStartUtc').value = new Date(startVal).toISOString();
                if (endVal)   document.getElementById('saleEndUtc').value   = new Date(endVal).toISOString();
            });
        });

        // ── Delete ticket ───────────────────────────────────────────────────
        async function deleteTicket(index, name) {
            if (!confirm(`Xóa loại vé "${name}"?`)) return;

            const resp = await fetch('@Url.Action("RemoveTicketType", "EventWizard")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: JSON.stringify(index)
            });
            const data = await resp.json();

            if (data.success) {
                showToast('success', data.message || 'Đã xóa loại vé.');
                setTimeout(() => location.reload(), 700);
            } else {
                showToast('error', data.message || 'Không thể xóa.');
            }
        }

        // ── Edit modal ──────────────────────────────────────────────────────
        function openEditModal(index, name, price, qty, isSeated, saleStartIso, saleEndIso, desc) {
            document.getElementById('editIndex').value         = index;
            document.getElementById('et-name').value          = name;
            document.getElementById('et-price').value         = price;
            document.getElementById('et-qty').value           = qty;
            document.getElementById('et-desc').value          = desc || '';
            document.getElementById('et-sale-start').value    = toLocalInput(saleStartIso);
            document.getElementById('et-sale-end').value      = toLocalInput(saleEndIso);
            document.getElementById(isSeated ? 'et-seated' : 'et-standing').checked = true;
            document.getElementById('editTicketError').style.display = 'none';
            document.getElementById('editTicketModal').style.display = 'flex';
        }

        function closeEditModal() {
            document.getElementById('editTicketModal').style.display = 'none';
        }

        async function saveEditTicket() {
            const index = parseInt(document.getElementById('editIndex').value);
            const isSeated = document.getElementById('et-seated').checked;

            const startLocal = document.getElementById('et-sale-start').value;
            const endLocal   = document.getElementById('et-sale-end').value;

            const ticket = {
                Name:          document.getElementById('et-name').value.trim(),
                Price:         parseFloat(document.getElementById('et-price').value) || 0,
                Quantity:      parseInt(document.getElementById('et-qty').value) || 0,
                IsSeatRequired: isSeated,
                SaleStartTime: startLocal ? new Date(startLocal).toISOString() : null,
                SaleEndTime:   endLocal   ? new Date(endLocal).toISOString()   : null,
                Description:   document.getElementById('et-desc').value.trim()
            };

            const errDiv = document.getElementById('editTicketError');

            const resp = await fetch('@Url.Action("UpdateTicketType", "EventWizard")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: JSON.stringify({ index, ticket })
            });
            const data = await resp.json();

            if (data.success) {
                closeEditModal();
                showToast('success', 'Đã cập nhật loại vé.');
                setTimeout(() => location.reload(), 700);
            } else {
                errDiv.textContent = data.message || 'Không thể cập nhật.';
                errDiv.style.display = 'block';
            }
        }

        // Đóng modal khi click backdrop
        document.getElementById('editTicketModal')?.addEventListener('click', function(e) {
            if (e.target === this) closeEditModal();
        });
    </script>
}