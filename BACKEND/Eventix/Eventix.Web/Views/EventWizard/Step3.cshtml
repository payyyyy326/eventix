@using Eventix.Web.Models.EventWizard
@model EventZonesViewModel

@{
    ViewData["Title"] = "Create Event - Step 3";
    Layout = "_OrganizerLayout";

    var zones = Model.Zones ?? new List<Eventix.Share.VenueZone.VenueZoneResponse>();

    var totalCapacity = zones.Sum(z => z.Capacity);
    var seatedZones = zones.Count(z => z.HasSeats);
    var generalZones = zones.Count(z => !z.HasSeats);
    var venueCapacity = Model.Venue?.Capacity ?? 0;

    var capacityPercent = venueCapacity <= 0
        ? 0
        : Math.Min(100, (int)Math.Round((double)totalCapacity / venueCapacity * 100));
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <a class="wizard-back-link"
               asp-controller="EventWizard"
               asp-action="Step2">
                ← Back to Venue
            </a>

            <div class="wizard-title">
                <span>Create Event</span>
                <h1>Step 3: Venue Zones</h1>
                <p>
                    Create areas such as VIP, Gold, Standing, Workshop,
                    or Online Pass.
                </p>
            </div>

            @await Html.PartialAsync("_WizardProgress")
        </div>

        <div class="wizard-panel">

            <div class="wizard-grid-3 mb-4">
                <div class="wizard-stat">
                    <span>Total Zones</span>
                    <strong>@zones.Count</strong>
                </div>

                <div class="wizard-stat">
                    <span>Current Capacity</span>
                    <strong>@totalCapacity / @venueCapacity</strong>
                </div>

                <div class="wizard-stat">
                    <span>Seated / General</span>
                    <strong>@seatedZones / @generalZones</strong>
                </div>
            </div>

            <div class="wizard-card mb-4">
                <h3>@(Model.Venue?.Name ?? "Selected Venue")</h3>
                <p>@(Model.Venue?.Address ?? "No address")</p>

                <div class="wizard-meta">
                    <span class="wizard-pill">
                        City: @(Model.Venue?.City ?? "N/A")
                    </span>

                    <span class="wizard-pill">
                        Venue Capacity: @venueCapacity
                    </span>
                </div>

                <div class="wizard-progress-bar mt-3">
                    <div class="wizard-progress-fill"
                         style="width: @capacityPercent%">
                    </div>
                </div>

                <small class="text-muted">
                    @capacityPercent% of venue capacity is currently assigned.
                    Seated-zone capacity will be updated after seats are generated or imported.
                </small>
            </div>

            <div class="wizard-card mb-4">
                <h3>Add New Zone</h3>
                <p>
                    For seated zones, capacity will be calculated automatically
                    from generated or imported seats.
                </p>

                <form asp-controller="EventWizard"
                      asp-action="CreateZone"
                      method="post"
                      class="mt-3"
                      id="createZoneForm">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="wizard-grid-2">
                        <div class="form-group mb-3">
                            <label asp-for="NewZone.Name">Zone Name</label>

                            <input asp-for="NewZone.Name"
                                   class="form-control"
                                   placeholder="VIP, Gold, Standing..."
                                   autocomplete="off" />

                            <span asp-validation-for="NewZone.Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-group mb-3"
                             id="zoneCapacityBox">

                            <label asp-for="NewZone.Capacity">
                                Capacity
                            </label>

                            <input asp-for="NewZone.Capacity"
                                   id="zoneCapacityInput"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Example: 500" />

                            <span asp-validation-for="NewZone.Capacity"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Required only for zones without assigned seats.
                            </small>
                        </div>
                    </div>

                    <div class="wizard-grid-2">
                        <div class="form-group mb-3">
                            <label asp-for="NewZone.Color">Color</label>

                            <input asp-for="NewZone.Color"
                                   type="color"
                                   class="form-control form-control-color" />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="NewZone.SortOrder">
                                Sort Order
                            </label>

                            <input asp-for="NewZone.SortOrder"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="1" />
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label class="d-flex align-items-center gap-2">
                            <input asp-for="NewZone.HasSeats"
                                   id="hasSeatsCheckbox"
                                   type="checkbox" />

                            This zone has assigned seats
                        </label>

                        <small class="text-muted">
                            Enable this for VIP, Gold, cinema-style, or numbered-seat areas.
                            Disable it for Standing, General Admission, Workshop, or Online Pass.
                        </small>
                    </div>

                    <div id="seatedZoneNotice"
                         class="wizard-card mb-4"
                         style="display: none;">

                        <strong>Capacity is calculated automatically</strong>

                        <p class="text-muted mb-0">
                            After creating this zone, generate or import its seats
                            in Step 5. The number of seats will become the zone capacity.
                        </p>
                    </div>

                    <button type="submit"
                            class="wizard-btn-primary">
                        + Add Zone
                    </button>
                </form>
            </div>

            <div class="mb-4">
                <h3 class="mb-3 text-white">Zone Overview</h3>

                @if (!zones.Any())
                {
                    <div class="organizer-empty">
                        <h2>No zones yet</h2>
                        <p>
                            Create at least one venue zone before continuing.
                        </p>
                    </div>
                }
                else
                {
                    <div class="wizard-grid-3">
                        @foreach (var zone in zones
                                            .OrderBy(z => z.SortOrder)
                                            .ThenBy(z => z.Name))
                        {
                            var zonePercent = venueCapacity <= 0
                            ? 0
                            : Math.Min(
                            100,
                            (int)Math.Round(
                            (double)zone.Capacity / venueCapacity * 100
                            )
                            );

                            <div class="wizard-section-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h4>@zone.Name</h4>

                                        <span class="wizard-pill">
                                            @(zone.HasSeats
                                                                                ? "Assigned Seating"
                                                                                : "General Admission")
                                </span>
                            </div>

                                    <div style="
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 999px;
                                                background: @(string.IsNullOrWhiteSpace(zone.Color)
                                                                             ? "#60A5FA"
                                                                             : zone.Color);">
                            </div>
                        </div>

                        @if (zone.HasSeats)
                                {
                                    <strong>@zone.SeatCount</strong>
                                    <p class="text-muted mb-0">
                                        seats imported or generated
                                    </p>

                                    @if (zone.SeatCount == 0)
                                    {
                                        <div class="wizard-meta mt-3">
                                            <span class="wizard-pill">
                                                Waiting for seat assignment
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="wizard-meta mt-3">
                                            <span class="wizard-pill">
                                                Capacity: @zone.Capacity
                                            </span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <strong>@zone.Capacity</strong>
                                    <p class="text-muted mb-0">
                                        general admission capacity
                                    </p>
                                }

                                <div class="wizard-progress-bar mt-3">
                                    <div class="wizard-progress-fill"
                                         style="width: @zonePercent%">
                                    </div>
                                </div>

                                <small class="text-muted">
                                    @zonePercent% of venue capacity
                                </small>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="wizard-actions">
                <a asp-controller="EventWizard"
                   asp-action="Step2"
                   class="wizard-btn-secondary">
                    ← Back
                </a>

                <form asp-controller="EventWizard"
                      asp-action="Step3Continue"
                      method="post">

                    <button type="submit"
                            class="wizard-btn-primary"
                            disabled="@(!zones.Any())">
                        Continue →
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const hasSeatsCheckbox =
                document.getElementById("hasSeatsCheckbox");

            const capacityBox =
                document.getElementById("zoneCapacityBox");

            const capacityInput =
                document.getElementById("zoneCapacityInput");

            const seatedZoneNotice =
                document.getElementById("seatedZoneNotice");

            const createZoneForm =
                document.getElementById("createZoneForm");

            if (!hasSeatsCheckbox ||
                !capacityBox ||
                !capacityInput) {
                return;
            }

            function updateCapacityField() {
                const hasSeats = hasSeatsCheckbox.checked;

                capacityBox.style.display =
                    hasSeats ? "none" : "block";

                if (seatedZoneNotice) {
                    seatedZoneNotice.style.display =
                        hasSeats ? "block" : "none";
                }

                if (hasSeats) {
                    capacityInput.value = "0";
                    capacityInput.required = false;
                    capacityInput.removeAttribute("min");
                } else {
                    if (Number(capacityInput.value) <= 0) {
                        capacityInput.value = "";
                    }

                    capacityInput.required = true;
                    capacityInput.setAttribute("min", "1");
                }
            }

            hasSeatsCheckbox.addEventListener(
                "change",
                updateCapacityField
            );

            createZoneForm?.addEventListener(
                "submit",
                function () {
                    if (hasSeatsCheckbox.checked) {
                        capacityInput.value = "0";
                    }
                }
            );

            updateCapacityField();
        });
    </script>
}