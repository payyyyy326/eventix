@using Eventix.Web.Models.EventWizard
@model EventTicketTypesViewModel

@{
    ViewData["Title"] = "Create Event - Step 3";
    Layout = "_OrganizerLayout";

    var ticketTypes = Model.TicketTypes ?? new();

    var totalTickets  = ticketTypes.Sum(t => t.Quantity);
    var seatedTickets  = ticketTypes.Count(t => t.IsSeatRequired);
    var generalTickets = ticketTypes.Count(t => !t.IsSeatRequired);
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <a class="wizard-back-link"
               asp-controller="EventWizard"
               asp-action="Step2">
                ← Back to Venue
            </a>

            <div class="wizard-title">
                <span>Create Event</span>
                <h1>Step 3: Ticket Types</h1>
                <p>
                    Create ticket types and set prices.
                    Seated tickets will auto-generate seats when the event is published.
                </p>
            </div>

            @await Html.PartialAsync("_WizardProgress")
        </div>

        <div class="wizard-panel">

            <div class="wizard-grid-3 mb-4">
                <div class="wizard-stat">
                    <span>Ticket Types</span>
                    <strong>@ticketTypes.Count</strong>
                </div>

                <div class="wizard-stat">
                    <span>Total Tickets</span>
                    <strong>@totalTickets</strong>
                </div>

                <div class="wizard-stat">
                    <span>Seated / General</span>
                    <strong>@seatedTickets / @generalTickets</strong>
                </div>
            </div>

            <div class="wizard-card mb-4">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h3>@(Model.Venue?.Name ?? "Selected Venue")</h3>
                        <p>@(Model.Venue?.Address ?? "No address")</p>
                    </div>
                </div>

                <div class="wizard-meta">
                    <span class="wizard-pill neutral">
                        Tickets Created: @totalTickets.ToString("N0")
                    </span>
                </div>
            </div>

            <div class="wizard-card mb-4">
                <h3>Add Ticket Type</h3>
                <p>
                    Choose Standing (General Admission) or Seated.
                    Seated tickets will auto-generate seats equal to the quantity.
                </p>

                <form asp-controller="EventWizard"
                      asp-action="AddTicketType"
                      method="post"
                      class="mt-4"
                      id="addTicketTypeForm">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="wizard-card ticket-form-section mb-3">
                        <div class="ticket-form-heading">
                            <h4>Basic Information</h4>
                            <p>Name, venue zone and ticket quantity.</p>
                        </div>

                        <div class="wizard-grid-2 mt-3">
                            <div class="form-group">
                                <label asp-for="NewTicketType.Name">
                                    Ticket Name
                                </label>

                                <input asp-for="NewTicketType.Name"
                                       class="form-control"
                                       placeholder="VIP Early Bird, Standard, Standing..."
                                       autocomplete="off" />

                                <span asp-validation-for="NewTicketType.Name"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="form-group">
                                <label>Ticket Type</label>
                                <div class="d-flex gap-3 mt-2">
                                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                                        <input asp-for="NewTicketType.IsSeatRequired"
                                               type="radio"
                                               value="false"
                                               id="radioStanding"
                                               checked="checked" />
                                        <span>🧍 Standing (General Admission)</span>
                                    </label>
                                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                                        <input asp-for="NewTicketType.IsSeatRequired"
                                               type="radio"
                                               value="true"
                                               id="radioSeated" />
                                        <span>💺 Seated (Assigned Seating)</span>
                                    </label>
                                </div>
                                <small class="text-muted mt-1">
                                    Seated tickets will auto-generate seats equal to the quantity you enter.
                                </small>
                            </div>

                        </div>

                        <div class="wizard-grid-2 mt-3">
                            <div class="form-group">
                                <label asp-for="NewTicketType.Quantity">
                                    Quantity
                                </label>

                                <input asp-for="NewTicketType.Quantity"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       placeholder="100"
                                       id="ticketQuantityInput" />

                                <span asp-validation-for="NewTicketType.Quantity"
                                      class="text-danger">
                                </span>

                                <small class="text-muted"
                                       id="zoneCapacityHint">
                                    Select a zone to see its remaining capacity.
                                </small>
                            </div>

                            <div class="form-group">
                                <label asp-for="NewTicketType.Price">
                                    Price
                                </label>

                                <div class="ticket-price-input">
                                    <input asp-for="NewTicketType.Price"
                                           type="number"
                                           min="0"
                                           step="1000"
                                           class="form-control"
                                           placeholder="500000" />

                                    <span>VND</span>
                                </div>

                                <span asp-validation-for="NewTicketType.Price"
                                      class="text-danger">
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="wizard-card ticket-form-section mb-3">
                        <div class="ticket-form-heading">
                            <h4>Sales Period</h4>
                            <p>
                                Define when customers can purchase this ticket.
                            </p>
                        </div>

                        <div class="wizard-grid-2 mt-3">
                            <div class="form-group">
                                <label asp-for="NewTicketType.SaleStartTime">
                                    Sale Start
                                </label>

                                <input name="_saleStartLocal"
                                       id="saleStartInput"
                                       type="datetime-local"
                                       class="form-control"
                                       value="@(Model.NewTicketType.SaleStartTime == default ? "" : Model.NewTicketType.SaleStartTime.ToString("yyyy-MM-ddTHH:mm"))" />

                                <input type="hidden"
                                       name="NewTicketType.SaleStartTime"
                                       id="saleStartUtc" />

                                <span asp-validation-for="NewTicketType.SaleStartTime"
                                      class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NewTicketType.SaleEndTime">
                                    Sale End
                                </label>

                                <input name="_saleEndLocal"
                                       id="saleEndInput"
                                       type="datetime-local"
                                       class="form-control"
                                       value="@(Model.NewTicketType.SaleEndTime == default ? "" : Model.NewTicketType.SaleEndTime.ToString("yyyy-MM-ddTHH:mm"))" />

                                <input type="hidden"
                                       name="NewTicketType.SaleEndTime"
                                       id="saleEndUtc" />

                                <span asp-validation-for="NewTicketType.SaleEndTime"
                                      class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="wizard-card ticket-form-section mb-4">
                        <div class="ticket-form-heading">
                            <h4>Ticket Details</h4>
                            <p>
                                Add an optional description and review
                                the seating configuration.
                            </p>
                        </div>

                        <div class="form-group mt-3">
                            <label asp-for="NewTicketType.Description">
                                Description
                            </label>

                            <textarea asp-for="NewTicketType.Description"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Describe benefits, access rules or ticket conditions...">
                            </textarea>

                            <span asp-validation-for="NewTicketType.Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="ticket-seat-status mt-3"
                             id="ticketSeatStatus">

                            <input asp-for="NewTicketType.IsSeatRequired"
                                   type="checkbox"
                                   id="seatRequiredCheckbox"
                                   hidden />

                            <div>
                                <span class="wizard-pill neutral"
                                      id="seatTypeBadge">
                                    Select a zone
                                </span>

                                <p id="seatTypeDescription">
                                    Seating configuration will be determined
                                    by the selected zone.
                                </p>
                            </div>
                        </div>
                    </div>

                    <button type="submit"
                            class="wizard-btn-primary">
                        + Add Ticket Type
                    </button>
                </form>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <h3 class="text-white mb-1">
                            Ticket Type Overview
                        </h3>

                        <p class="text-muted mb-0">
                            Review all ticket types created for this event.
                        </p>
                    </div>

                    <span class="wizard-pill info">
                        @ticketTypes.Count total
                    </span>
                </div>

                @if (!ticketTypes.Any())
                {
                    <div class="organizer-empty">
                        <h2>No ticket types yet</h2>
                        <p>
                            Add at least one ticket type before continuing.
                        </p>
                    </div>
                }
                else
                {
                    <div class="ticket-type-grid">
                        @foreach (var ticket in ticketTypes
                                            .OrderBy(t => t.Price)
                                            .ThenBy(t => t.Name))
                        {
                            var priceLabel = ticket.Price <= 0
                            ? "Free"
                            : $"{ticket.Price:N0} VND";

                            <article class="ticket-type-card">
                                <div class="ticket-type-card-header">
                                    <div>
                                        <h4>@ticket.Name</h4>

                                        <div class="wizard-meta">
                                            <span class="wizard-pill
                                                        @(ticket.IsSeatRequired ? "" : "info")">

                                                @(ticket.IsSeatRequired
                                                                                        ? "Assigned Seating"
                                                                                        : "General Admission")
                                    </span>
                                        </div>
                                    </div>

                                    <div class="ticket-type-price">
                                        <strong>@priceLabel</strong>
                                        <span>per ticket</span>
                                    </div>
                                </div>

                        @if (!string.IsNullOrWhiteSpace(ticket.Description))
                                {
                                    <p class="ticket-type-description">
                                        @ticket.Description
                                    </p>
                                }

                                <div class="ticket-type-details">
                                    <div>
                                        <span>Quantity</span>
                                        <strong>@ticket.Quantity.ToString("N0")</strong>
                                    </div>

                                    <div>
                                        <span>Type</span>
                                        <strong>@(ticket.IsSeatRequired ? "Seated" : "Standing")</strong>
                                    </div>

                                    <div>
                                        <span>Sale Start</span>
                                        <strong>
                                            @ticket.SaleStartTime.ToString("dd/MM/yyyy HH:mm")
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Sale End</span>
                                        <strong>
                                            @ticket.SaleEndTime.ToString("dd/MM/yyyy HH:mm")
                                        </strong>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>

            <div class="wizard-actions">
                <a asp-controller="EventWizard"
                   asp-action="Step2"
                   class="wizard-btn-secondary">
                    ← Back
                </a>

                <form asp-controller="EventWizard"
                      asp-action="Step4Continue"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="wizard-btn-primary"
                            disabled="@(!ticketTypes.Any())">
                        Continue to Seats →
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ── Seat type badge ───────────────────────────────────────────────
            const radioStanding = document.getElementById("radioStanding");
            const radioSeated   = document.getElementById("radioSeated");
            const badge         = document.getElementById("seatTypeBadge");
            const desc          = document.getElementById("seatTypeDescription");

            function updateBadge() {
                const isSeated = radioSeated?.checked;
                if (badge) {
                    badge.textContent = isSeated ? "Assigned Seating" : "General Admission";
                    badge.className   = isSeated ? "wizard-pill" : "wizard-pill info";
                }
                if (desc) {
                    desc.textContent = isSeated
                        ? "Seats will be auto-generated equal to the quantity you enter."
                        : "Customers choose quantity. No individual seat assignment required.";
                }
            }

            radioStanding?.addEventListener("change", updateBadge);
            radioSeated?.addEventListener("change", updateBadge);
            updateBadge();

            // ── Datetime: min = now, default = today ──────────────────────────
            function toLocalDatetimeValue(date) {
                const pad = n => String(n).padStart(2, '0');
                return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
            }

            const now       = new Date();
            const nowStr    = toLocalDatetimeValue(now);
            const saleStart = document.getElementById('saleStartInput');
            const saleEnd   = document.getElementById('saleEndInput');

            if (saleStart) {
                saleStart.setAttribute('min', nowStr);
                if (!saleStart.value) {
                    const d = new Date(now);
                    d.setHours(d.getHours() + 1, 0, 0, 0);
                    saleStart.value = toLocalDatetimeValue(d);
                }
                saleStart.addEventListener('change', function () {
                    if (saleEnd) saleEnd.setAttribute('min', this.value);
                    if (saleEnd?.value && saleEnd.value <= this.value) saleEnd.value = '';
                });
            }

            if (saleEnd) {
                saleEnd.setAttribute('min', nowStr);
                if (!saleEnd.value) {
                    const d = new Date(now);
                    d.setDate(d.getDate() + 7);
                    d.setMinutes(0, 0, 0);
                    saleEnd.value = toLocalDatetimeValue(d);
                }
            }

            // Convert local → UTC trước khi submit
            document.getElementById('addTicketTypeForm')?.addEventListener('submit', function () {
                const startVal = saleStart?.value;
                const endVal   = saleEnd?.value;
                if (startVal) document.getElementById('saleStartUtc').value = new Date(startVal).toISOString();
                if (endVal)   document.getElementById('saleEndUtc').value   = new Date(endVal).toISOString();
            });
        });
    </script>
}