@using Eventix.Web.Models.EventWizard
@model EventSeatAssignmentViewModel

@{
    ViewData["Title"] = "Tạo sự kiện - Bước 4";
    Layout = "_OrganizerLayout";

    var seatedTypes   = Model.TicketTypes.Where(t => t.IsSeatRequired).ToList();
    var standingTypes = Model.TicketTypes.Where(t => !t.IsSeatRequired).ToList();
    var totalSeats    = seatedTypes.Sum(t => t.Quantity);
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <a class="wizard-back-link"
               asp-controller="EventWizard"
               asp-action="Step3">
                ← Quay lại Loại vé
            </a>

            <div class="wizard-title">
                <span>Tạo sự kiện</span>
                <h1>Bước 4: Xem trước ghế ngồi</h1>
                <p>
                    Xem trước cách ghế ngồi sẽ được tạo tự động cho từng loại vé.
                    Mỗi vé có ghế ngồi sẽ tạo một ghế tương ứng khi công bố sự kiện.
                </p>
            </div>

            @await Html.PartialAsync("_WizardProgress")
        </div>

        <div class="wizard-panel">

            <div class="wizard-grid-3 mb-4">
                <div class="wizard-stat">
                    <span>Tổng ghế ngồi</span>
                    <strong>@totalSeats.ToString("#,##0")</strong>
                </div>
                <div class="wizard-stat">
                    <span>Loại vé có ghế</span>
                    <strong>@seatedTypes.Count</strong>
                </div>
                <div class="wizard-stat">
                    <span>Loại vé vào tự do</span>
                    <strong>@standingTypes.Count</strong>
                </div>
            </div>

            @if (seatedTypes.Any())
            {
                <div class="wizard-card mb-4">
                    <h3>Vé có ghế ngồi</h3>
                    <p>Các loại vé dưới đây sẽ tự động tạo ghế khi sự kiện được công bố.</p>

                    <div class="ticket-type-grid mt-3">
                        @foreach (var ticket in seatedTypes)
                        {
                            var priceLabel = ticket.Price <= 0 ? "Miễn phí" : $"{ticket.Price:#,##0} VND";
                            <article class="ticket-type-card">
                                <div class="ticket-type-card-header">
                                    <div>
                                        <h4>@ticket.Name</h4>
                                        <div class="wizard-meta">
                                            <span class="wizard-pill">Có ghế ngồi</span>
                                        </div>
                                    </div>
                                    <div class="ticket-type-price">
                                        <strong>@priceLabel</strong>
                                        <span>mỗi vé</span>
                                    </div>
                                </div>
                                <div class="ticket-type-details">
                                    <div>
                                        <span>Số ghế sẽ tạo</span>
                                        <strong>@ticket.Quantity.ToString("#,##0")</strong>
                                    </div>
                                    <div>
                                        <span>Bắt đầu bán</span>
                                        <strong>@ticket.SaleStartTime.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                    <div>
                                        <span>Kết thúc bán</span>
                                        <strong>@ticket.SaleEndTime.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }

            @if (standingTypes.Any())
            {
                <div class="wizard-card mb-4">
                    <h3>Vé vào tự do</h3>
                    <p>Các loại vé dưới đây không yêu cầu chỉ định ghế ngồi.</p>

                    <div class="ticket-type-grid mt-3">
                        @foreach (var ticket in standingTypes)
                        {
                            var priceLabel = ticket.Price <= 0 ? "Miễn phí" : $"{ticket.Price:#,##0} VND";
                            <article class="ticket-type-card">
                                <div class="ticket-type-card-header">
                                    <div>
                                        <h4>@ticket.Name</h4>
                                        <div class="wizard-meta">
                                            <span class="wizard-pill info">Vào tự do</span>
                                        </div>
                                    </div>
                                    <div class="ticket-type-price">
                                        <strong>@priceLabel</strong>
                                        <span>mỗi vé</span>
                                    </div>
                                </div>
                                <div class="ticket-type-details">
                                    <div>
                                        <span>Số lượng</span>
                                        <strong>@ticket.Quantity.ToString("#,##0")</strong>
                                    </div>
                                    <div>
                                        <span>Bắt đầu bán</span>
                                        <strong>@ticket.SaleStartTime.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                    <div>
                                        <span>Kết thúc bán</span>
                                        <strong>@ticket.SaleEndTime.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }

            @if (!seatedTypes.Any() && !standingTypes.Any())
            {
                <div class="organizer-empty">
                    <h2>Chưa có loại vé nào</h2>
                    <p>Quay lại bước trước để thêm loại vé.</p>
                </div>
            }

            <div class="wizard-actions">
                <a asp-controller="EventWizard"
                   asp-action="Step3"
                   class="wizard-btn-secondary">
                    ← Quay lại
                </a>

                <form asp-controller="EventWizard"
                      asp-action="Step4Continue"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="wizard-btn-primary">
                        Tiếp theo: Sơ đồ địa điểm →
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>