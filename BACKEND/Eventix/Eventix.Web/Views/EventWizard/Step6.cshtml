@using Eventix.Web.Models.EventWizard
@model EventReviewViewModel

@{
    ViewData["Title"] = "Tạo sự kiện - Bước 6";
    Layout = "_OrganizerLayout";

    var eventData   = Model.EventInfo;
    var venue       = Model.Venue;
    var ticketTypes = Model.TicketTypes ?? new();

    var categoryName = eventData?.Categories?
        .FirstOrDefault(x => x.Id == eventData.CategoryId)?.Name ?? "N/A";
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <div class="wizard-title">
                <span>Tạo sự kiện</span>
                <h1>Bước 6: Xem lại & Công bố</h1>
                <p>Kiểm tra lại toàn bộ thông tin, chỉnh sửa nếu cần, rồi công bố sự kiện.</p>
            </div>
            @await Html.PartialAsync("_WizardProgress")
        </div>

        <div class="wizard-panel">

            <div class="wizard-grid-3 mb-4">
                <div class="wizard-stat">
                    <span>Loại vé</span>
                    <strong id="statTicketCount">@ticketTypes.Count</strong>
                </div>
                <div class="wizard-stat">
                    <span>Tổng số vé</span>
                    <strong id="statTotalQty">@Model.TotalTicketQuantity.ToString("#,##0")</strong>
                </div>
                <div class="wizard-stat">
                    <span>Sức chứa địa điểm</span>
                    <strong>@(venue?.Capacity.ToString("#,##0") ?? "0")</strong>
                </div>
            </div>

            <!-- Thông tin sự kiện (chỉnh sửa inline) -->
            <section class="wizard-review-section" id="eventInfoSection">
                <div class="wizard-review-header">
                    <div>
                        <h3>Thông tin sự kiện</h3>
                        <p>Nhấn <strong>Sửa</strong> để thay đổi thông tin sự kiện.</p>
                    </div>
                    <button type="button" class="wizard-btn-secondary" onclick="toggleEventInfoEdit()">
                        ✏️ Sửa
                    </button>
                </div>

                <div id="eventInfoReadView">
                    @if (eventData == null)
                    {
                        <div class="organizer-empty">
                            <h2>Không có thông tin sự kiện</h2>
                        </div>
                    }
                    else
                    {
                        <div class="wizard-review-grid">
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Tên sự kiện</span>
                                <div class="wizard-review-value" id="rv-title">@eventData.Title</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Danh mục</span>
                                <div class="wizard-review-value" id="rv-category">@categoryName</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Bắt đầu</span>
                                <div class="wizard-review-value" id="rv-start">@eventData.StartTime.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Kết thúc</span>
                                <div class="wizard-review-value" id="rv-end">@eventData.EndTime.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Mô tả ngắn</span>
                                <div class="wizard-review-value" id="rv-summary">@(string.IsNullOrWhiteSpace(eventData.Summary) ? "—" : eventData.Summary)</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Thời lượng</span>
                                <div class="wizard-review-value" id="rv-duration">@($"{(eventData.EndTime - eventData.StartTime).TotalHours:0.#} giờ")</div>
                            </div>
                        </div>
                        <div class="wizard-review-item mt-3">
                            <span class="wizard-review-label">Mô tả chi tiết</span>
                            <div class="wizard-review-value" id="rv-description">@(string.IsNullOrWhiteSpace(eventData.Description) ? "—" : eventData.Description)</div>
                        </div>
                    }
                </div>

                <div id="eventInfoEditForm" style="display:none;" class="mt-3">
                    <div id="eventInfoError" class="text-danger mb-3" style="display:none;"></div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Tên sự kiện <span class="text-danger">*</span></label>
                            <input id="ei-title" class="form-control" value="@eventData?.Title" />
                        </div>
                        <div class="form-group">
                            <label>Danh mục <span class="text-danger">*</span></label>
                            <select id="ei-category" class="form-control">
                                @foreach (var cat in (eventData?.Categories ?? new()))
                                {
                                    if (cat.Id == eventData?.CategoryId)
                                    { <option value="@cat.Id" selected="selected">@cat.Name</option> }
                                    else
                                    { <option value="@cat.Id">@cat.Name</option> }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Thời gian bắt đầu <span class="text-danger">*</span></label>
                            <input id="ei-start" type="datetime-local" class="form-control"
                                   value="@eventData?.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="form-group">
                            <label>Thời gian kết thúc <span class="text-danger">*</span></label>
                            <input id="ei-end" type="datetime-local" class="form-control"
                                   value="@eventData?.EndTime.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label>Mô tả ngắn</label>
                        <input id="ei-summary" class="form-control" value="@eventData?.Summary" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Mô tả chi tiết</label>
                        <textarea id="ei-description" rows="4" class="form-control">@eventData?.Description</textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="wizard-btn-primary" onclick="saveEventInfo()">💾 Lưu</button>
                        <button type="button" class="wizard-btn-secondary" onclick="cancelEventInfoEdit()">Huỷ</button>
                    </div>
                </div>
            </section>
            <!-- Địa điểm (chỉ hiển thị) -->
            <section class="wizard-review-section">
                <div class="wizard-review-header">
                    <div>
                        <h3>Địa điểm</h3>
                        <p>Để thay đổi địa điểm, <a asp-controller="EventWizard" asp-action="Step2">quay lại Bước 2</a>.</p>
                    </div>
                    <a asp-controller="EventWizard" asp-action="Step5" class="wizard-btn-secondary"
                       title="Chỉnh sửa sơ đồ chỗ ngồi" style="text-decoration:none;">
                        🗺️ Sửa map
                    </a>
                </div>
                @if (venue == null)
                {
                    <div class="organizer-empty"><h2>Chưa có địa điểm</h2></div>
                }
                else
                {
                    <div class="wizard-review-grid">
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Tên địa điểm</span>
                            <div class="wizard-review-value">@venue.Name</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Sức chứa</span>
                            <div class="wizard-review-value">@venue.Capacity.ToString("#,##0")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Địa chỉ</span>
                            <div class="wizard-review-value">@(venue.Address ?? "—")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Thành phố</span>
                            <div class="wizard-review-value">@(venue.City ?? "—")</div>
                        </div>
                    </div>
                }
            </section>

            <!-- Loại vé (thêm / xoá inline) -->
            <section class="wizard-review-section" id="ticketTypesSection">
                <div class="wizard-review-header">
                    <div>
                        <h3>Loại vé</h3>
                        <p>Thêm/xoá tại đây, hoặc <a asp-controller="EventWizard" asp-action="Step3">quay Bước 3</a> để chỉnh sửa đầy đủ.</p>
                    </div>
                    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                        <a asp-controller="EventWizard" asp-action="Step3" class="wizard-btn-secondary"
                           title="Quay lại Bước 3 để sửa loại vé" style="text-decoration:none;font-size:0.83rem;">
                            🎫 Sửa loại vé
                        </a>
                        <button type="button" class="wizard-btn-secondary" onclick="toggleAddTicket()">
                            ➕ Thêm vé
                        </button>
                    </div>
                </div>

                <div id="ticketListContainer">
                    <div class="table-responsive">
                        <table id="ticketTable">
                            <thead>
                                <tr>
                                    <th>Tên</th>
                                    <th>Loại</th>
                                    <th>Giá</th>
                                    <th>SL</th>
                                    <th>Bắt đầu bán</th>
                                    <th>Kết thúc bán</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="ticketTableBody">
                                @for (int i = 0; i < ticketTypes.Count; i++)
                                {
                                    var t = ticketTypes[i];
                                    var priceLabel = t.Price <= 0 ? "Miễn phí" : $"{t.Price:#,##0} VND";
                                    <tr id="ticket-row-@i" data-index="@i">
                                        <td><strong>@t.Name</strong></td>
                                        <td>@(t.IsSeatRequired ? "Có ghế" : "Tự do")</td>
                                        <td>@priceLabel</td>
                                        <td>@t.Quantity.ToString("#,##0")</td>
                                        <td>@t.SaleStartTime.ToString("dd/MM HH:mm")</td>
                                        <td>@t.SaleEndTime.ToString("dd/MM HH:mm")</td>
                                        <td style="display:flex;gap:6px;">
                                            <button type="button"
                                                    style="background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.3);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;"
                                                    onclick="editTicket(@i)">✏️ Sửa</button>
                                            <button type="button"
                                                    class="ticket-action"
                                                    style="background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;"
                                                    onclick="removeTicket(@i)">🗑 Xoá</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="noTicketsMsg" style="display:@(ticketTypes.Any() ? "none" : "block");"
                         class="organizer-empty">
                        <h2>Chưa có loại vé nào</h2>
                        <p>Thêm ít nhất một loại vé trước khi công bố.</p>
                    </div>
                </div>

                <!-- Form thêm vé mới -->
                <div id="addTicketForm" class="wizard-card mt-4" style="display:none;">
                    <h4 class="mb-3">Loại vé mới</h4>
                    <div id="addTicketError" class="text-danger mb-3" style="display:none;"></div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Tên <span class="text-danger">*</span></label>
                            <input id="nt-name" class="form-control" placeholder="VIP, Đứng, Early Bird..." />
                        </div>
                        <div class="form-group">
                            <label>Loại vé</label>
                            <div class="d-flex gap-3 mt-2">
                                <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                                    <input type="radio" name="nt-type" id="nt-standing" value="false" checked />
                                    Vào tự do
                                </label>
                                <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                                    <input type="radio" name="nt-type" id="nt-seated" value="true" />
                                    Có ghế ngồi
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Giá vé (VND)</label>
                            <input id="nt-price" type="number" min="0" step="1000" class="form-control" placeholder="0 = Miễn phí" value="0" />
                        </div>
                        <div class="form-group">
                            <label>Số lượng <span class="text-danger">*</span></label>
                            <input id="nt-qty" type="number" min="1" class="form-control" placeholder="100" />
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Bắt đầu bán <span class="text-danger">*</span></label>
                            <input id="nt-sale-start" type="datetime-local" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Kết thúc bán <span class="text-danger">*</span></label>
                            <input id="nt-sale-end" type="datetime-local" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label>Mô tả</label>
                        <textarea id="nt-desc" rows="2" class="form-control" placeholder="Tuỳ chọn..."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="wizard-btn-primary" onclick="submitAddTicket()">➕ Thêm</button>
                        <button type="button" class="wizard-btn-secondary" onclick="toggleAddTicket()">Huỷ</button>
                    </div>
                </div>

                <!-- Form sửa vé -->
                <div id="editTicketForm" class="wizard-card mt-4" style="display:none;">
                    <h4 class="mb-1">Sửa loại vé</h4>
                    <p class="text-muted mb-3" id="editTicketSubtitle"></p>
                    <input type="hidden" id="et-index" value="-1" />
                    <div id="editTicketError" class="text-danger mb-3" style="display:none;"></div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Tên <span class="text-danger">*</span></label>
                            <input id="et-name" class="form-control" />
                            <span id="err-et-name" class="text-danger" style="display:none;"></span>
                        </div>
                        <div class="form-group">
                            <label>Loại vé</label>
                            <div class="d-flex gap-3 mt-2">
                                <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                                    <input type="radio" name="et-type" id="et-standing" value="false" checked />
                                    Vào tự do
                                </label>
                                <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                                    <input type="radio" name="et-type" id="et-seated" value="true" />
                                    Có ghế ngồi
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Giá vé (VND)</label>
                            <input id="et-price" type="number" min="0" step="1000" class="form-control" value="0" />
                            <span id="err-et-price" class="text-danger" style="display:none;"></span>
                        </div>
                        <div class="form-group">
                            <label>Số lượng <span class="text-danger">*</span></label>
                            <input id="et-qty" type="number" min="1" class="form-control" />
                            <span id="err-et-qty" class="text-danger" style="display:none;"></span>
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Bắt đầu bán <span class="text-danger">*</span></label>
                            <input id="et-sale-start" type="datetime-local" class="form-control" />
                            <span id="err-et-sale-start" class="text-danger" style="display:none;"></span>
                        </div>
                        <div class="form-group">
                            <label>Kết thúc bán <span class="text-danger">*</span></label>
                            <input id="et-sale-end" type="datetime-local" class="form-control" />
                            <span id="err-et-sale-end" class="text-danger" style="display:none;"></span>
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label>Mô tả</label>
                        <textarea id="et-desc" rows="2" class="form-control"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="wizard-btn-primary" onclick="submitEditTicket()">💾 Lưu thay đổi</button>
                        <button type="button" class="wizard-btn-secondary" onclick="closeEditTicket()">Huỷ</button>
                    </div>
                </div>
            </section>
            <!-- Địa điểm -->
            <section class="wizard-review-section">
                <div class="wizard-review-header">
                    <div>
                        <h3>Địa điểm</h3>
                        <p>Để thay đổi, <a asp-controller="EventWizard" asp-action="Step2">quay lại Bước 2</a>.</p>
                    </div>
                </div>
                @if (venue == null)
                {
                    <div class="organizer-empty"><h2>Chưa có địa điểm</h2></div>
                }
                else
                {
                    <div class="wizard-review-grid">
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Tên địa điểm</span>
                            <div class="wizard-review-value">@venue.Name</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Sức chứa</span>
                            <div class="wizard-review-value">@venue.Capacity.ToString("#,##0")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Địa chỉ</span>
                            <div class="wizard-review-value">@(venue.Address ?? "—")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Thành phố</span>
                            <div class="wizard-review-value">@(venue.City ?? "—")</div>
                        </div>
                    </div>
                }
            </section>

           
            <!-- Cảnh báo chưa đủ điều kiện công bố -->
            <div id="publishWarning" class="publish-warning mb-4" style="display:@(!Model.CanPublish ? "block" : "none");">
                <strong>Sự kiện chưa thể công bố</strong>
                <ul>
                    @if (Model.EventInfo == null) { <li>Thiếu thông tin sự kiện.</li> }
                    @if (Model.Venue == null) { <li>Chưa chọn địa điểm.</li> }
                    @if (!Model.HasTicketTypes) { <li id="warnNoTickets">Cần ít nhất một loại vé.</li> }
                </ul>
            </div>

            <div class="wizard-actions" style="flex-direction:column;align-items:stretch;gap:16px;">
                <form asp-controller="EventWizard"
                      asp-action="Publish"
                      method="post"
                      id="publishEventForm">
                    @Html.AntiForgeryToken()

                    <div class="publish-schedule-box">
                        <div class="publish-schedule-header">
                            <strong>📅 Ngày công bố</strong>
                            <p>Chọn thời điểm sự kiện hiển thị công khai với khách hàng.</p>
                        </div>
                        <div class="publish-schedule-row">
                            <label>
                                <input type="radio" name="publishMode" value="now" checked
                                       onchange="document.getElementById('publishedAtWrap').style.display='none'" />
                                Công bố ngay
                            </label>
                            <label>
                                <input type="radio" name="publishMode" value="scheduled"
                                       onchange="document.getElementById('publishedAtWrap').style.display='block'" />
                                Đặt lịch công bố
                            </label>
                        </div>
                        <div id="publishedAtWrap" style="display:none;margin-top:12px;">
                            <input type="datetime-local"
                                   name="PublishedAt"
                                   id="publishedAtInput"
                                   class="form-control"
                                   style="max-width:320px;" />
                            <p style="margin:6px 0 0;font-size:13px;color:#9ca3af;">
                                Sự kiện sẽ hiển thị công khai vào thời điểm này.
                            </p>
                        </div>
                    </div>

                    <button type="submit"
                            class="wizard-btn-primary"
                            id="publishEventButton"
                            @(!Model.CanPublish ? "disabled" : "")>
                        🚀 Công bố sự kiện
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>
@section Scripts {
<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

function toLocalDatetimeValue(date) {
    const pad = n => String(n).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
}

const _now    = new Date();
const _nowStr = toLocalDatetimeValue(_now);

document.addEventListener('DOMContentLoaded', function () {
    const eiStart = document.getElementById('ei-start');
    const eiEnd   = document.getElementById('ei-end');
    if (eiStart) {
        eiStart.setAttribute('min', _nowStr);
        eiStart.addEventListener('change', function () {
            if (eiEnd) eiEnd.setAttribute('min', this.value);
            if (eiEnd?.value && eiEnd.value <= this.value) eiEnd.value = '';
        });
    }
    if (eiEnd) eiEnd.setAttribute('min', _nowStr);

    const ntStart = document.getElementById('nt-sale-start');
    const ntEnd   = document.getElementById('nt-sale-end');
    if (ntStart) {
        ntStart.setAttribute('min', _nowStr);
        const d = new Date(_now); d.setHours(d.getHours()+1, 0, 0, 0);
        ntStart.value = toLocalDatetimeValue(d);
        ntStart.addEventListener('change', function () {
            if (ntEnd) ntEnd.setAttribute('min', this.value);
            if (ntEnd?.value && ntEnd.value <= this.value) ntEnd.value = '';
        });
    }
    if (ntEnd) {
        ntEnd.setAttribute('min', _nowStr);
        const d = new Date(_now); d.setDate(d.getDate()+7); d.setMinutes(0,0,0);
        ntEnd.value = toLocalDatetimeValue(d);
    }

    const publishedAtInput = document.getElementById('publishedAtInput');
    if (publishedAtInput) {
        const minPublish = new Date(_now);
        minPublish.setMinutes(minPublish.getMinutes() + 5, 0, 0);
        publishedAtInput.setAttribute('min', toLocalDatetimeValue(minPublish));
    }
});

function postJson(url, data) {
    return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify(data)
    }).then(r => r.json());
}

function postForm(url, formData) {
    formData.append('__RequestVerificationToken', token);
    return fetch(url, { method: 'POST', body: formData }).then(r => r.json());
}

function showError(id, msg) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.style.display = msg ? 'block' : 'none';
}

let tickets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TicketTypes));

function toggleEventInfoEdit() {
    const read = document.getElementById('eventInfoReadView');
    const form = document.getElementById('eventInfoEditForm');
    const isHidden = form.style.display === 'none';
    read.style.display = isHidden ? 'none' : 'block';
    form.style.display = isHidden ? 'block' : 'none';
    showError('eventInfoError', '');
}

function cancelEventInfoEdit() {
    document.getElementById('eventInfoReadView').style.display = 'block';
    document.getElementById('eventInfoEditForm').style.display = 'none';
    showError('eventInfoError', '');
}

async function saveEventInfo() {
    showError('eventInfoError', '');
    const title   = document.getElementById('ei-title').value.trim();
    const catId   = document.getElementById('ei-category').value;
    const catName = document.getElementById('ei-category').selectedOptions[0]?.text ?? '';
    const start   = document.getElementById('ei-start').value;
    const end     = document.getElementById('ei-end').value;
    const summary = document.getElementById('ei-summary').value.trim();
    const desc    = document.getElementById('ei-description').value.trim();

    if (!title)  { showError('eventInfoError', 'Tên sự kiện là bắt buộc.'); return; }
    if (!catId)  { showError('eventInfoError', 'Vui lòng chọn danh mục.'); return; }
    if (!start)  { showError('eventInfoError', 'Thời gian bắt đầu là bắt buộc.'); return; }
    if (!end)    { showError('eventInfoError', 'Thời gian kết thúc là bắt buộc.'); return; }
    if (new Date(start) <= new Date()) { showError('eventInfoError', 'Thời gian bắt đầu phải ở tương lai.'); return; }
    if (new Date(end) <= new Date(start)) { showError('eventInfoError', 'Thời gian kết thúc phải sau bắt đầu.'); return; }

    const fd = new FormData();
    fd.append('Title', title); fd.append('CategoryId', catId);
    fd.append('StartTime', new Date(start).toISOString());
    fd.append('EndTime', new Date(end).toISOString());
    fd.append('Summary', summary); fd.append('Description', desc);

    const result = await postForm('/EventWizard/UpdateEventInfo', fd);
    if (!result.success) { showError('eventInfoError', result.message); return; }

    document.getElementById('rv-title').textContent    = title;
    document.getElementById('rv-category').textContent = catName;
    document.getElementById('rv-summary').textContent  = summary || '—';
    document.getElementById('rv-description').textContent = desc || '—';

    const startDate = new Date(start), endDate = new Date(end);
    const fmt = d => d.toLocaleDateString('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric'})
                   + ' ' + d.toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'});
    document.getElementById('rv-start').textContent = fmt(startDate);
    document.getElementById('rv-end').textContent   = fmt(endDate);
    document.getElementById('rv-duration').textContent = `${((endDate-startDate)/3600000).toFixed(1)} giờ`;
    cancelEventInfoEdit();
}

function renderTicketTable() {
    const tbody = document.getElementById('ticketTableBody');
    const noMsg = document.getElementById('noTicketsMsg');
    if (!tickets.length) { tbody.innerHTML = ''; noMsg.style.display = 'block'; setPublishable(false); return; }
    noMsg.style.display = 'none';
    tbody.innerHTML = tickets.map((t, i) => {
        const priceLabel = t.Price <= 0 ? 'Miễn phí' : `${Number(t.Price).toLocaleString('en-US')} VND`;
        const typeLabel  = t.IsSeatRequired ? 'Có ghế' : 'Tự do';
        const fmtDate = s => {
            const d = new Date(s);
            return d.toLocaleDateString('vi-VN', {day:'2-digit',month:'2-digit'})
                 + ' ' + d.toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'});
        };
        return `<tr id="ticket-row-${i}" data-index="${i}">
            <td><strong>${t.Name}</strong></td>
            <td>${typeLabel}</td><td>${priceLabel}</td>
            <td>${Number(t.Quantity).toLocaleString('en-US')}</td>
            <td>${fmtDate(t.SaleStartTime)}</td><td>${fmtDate(t.SaleEndTime)}</td>
            <td style="display:flex;gap:6px;">
                <button type="button" style="background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.3);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;" onclick="editTicket(${i})">✏️ Sửa</button>
                <button type="button" style="background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;" onclick="removeTicket(${i})">🗑 Xoá</button>
            </td></tr>`;
    }).join('');
    document.getElementById('statTicketCount').textContent = tickets.length;
    const total = tickets.reduce((s, t) => s + Number(t.Quantity), 0);
    document.getElementById('statTotalQty').textContent = total.toLocaleString('en-US');
    setPublishable(tickets.length > 0);
}

function _etErr(id, msg) { const el = document.getElementById(id); if (!el) return; el.textContent = msg; el.style.display = msg ? 'inline' : 'none'; }
function _clearEtErrors() { ['err-et-name','err-et-price','err-et-qty','err-et-sale-start','err-et-sale-end','editTicketError'].forEach(id => _etErr(id, '')); }

function editTicket(index) {
    closeEditTicket();
    const t = tickets[index]; if (!t) return;
    document.getElementById('et-index').value = index;
    document.getElementById('et-name').value  = t.Name;
    document.getElementById('et-price').value = t.Price;
    document.getElementById('et-qty').value   = t.Quantity;
    document.getElementById('et-desc').value  = t.Description || '';
    document.getElementById('editTicketSubtitle').textContent = `Đang sửa: ${t.Name}`;
    const isSeated = t.IsSeatRequired === true;
    document.getElementById('et-seated').checked   = isSeated;
    document.getElementById('et-standing').checked = !isSeated;
    const toLocal = s => { const d = new Date(s); const pad = n => String(n).padStart(2,'0'); return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`; };
    document.getElementById('et-sale-start').value = toLocal(t.SaleStartTime);
    document.getElementById('et-sale-end').value   = toLocal(t.SaleEndTime);
    document.getElementById('et-sale-start').setAttribute('min', _nowStr);
    document.getElementById('et-sale-end').setAttribute('min', _nowStr);
    document.getElementById('addTicketForm').style.display = 'none';
    document.getElementById('editTicketForm').style.display = 'block';
    document.getElementById('editTicketForm').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function closeEditTicket() { document.getElementById('editTicketForm').style.display = 'none'; _clearEtErrors(); }

async function submitEditTicket() {
    _clearEtErrors();
    const index = parseInt(document.getElementById('et-index').value);
    const name  = document.getElementById('et-name').value.trim();
    const price = parseFloat(document.getElementById('et-price').value) || 0;
    const qty   = parseInt(document.getElementById('et-qty').value);
    const saleStart = document.getElementById('et-sale-start').value;
    const saleEnd   = document.getElementById('et-sale-end').value;
    const desc      = document.getElementById('et-desc').value.trim();
    const isSeated  = document.querySelector('input[name="et-type"]:checked')?.value === 'true';

    let hasErr = false;
    if (!name)                 { _etErr('err-et-name', 'Tên vé là bắt buộc.'); hasErr = true; }
    if (!qty || qty < 1)       { _etErr('err-et-qty', 'Số lượng ít nhất là 1.'); hasErr = true; }
    if (price < 0)             { _etErr('err-et-price', 'Giá không được âm.'); hasErr = true; }
    if (!saleStart)            { _etErr('err-et-sale-start', 'Bắt buộc chọn ngày bắt đầu bán.'); hasErr = true; }
    else if (new Date(saleStart) <= new Date()) { _etErr('err-et-sale-start', 'Phải ở tương lai.'); hasErr = true; }
    if (!saleEnd)              { _etErr('err-et-sale-end', 'Bắt buộc chọn ngày kết thúc bán.'); hasErr = true; }
    else if (saleStart && new Date(saleEnd) <= new Date(saleStart)) { _etErr('err-et-sale-end', 'Phải sau ngày bắt đầu bán.'); hasErr = true; }
    if (hasErr) return;

    const payload = { Index: index, Ticket: { Name: name, IsSeatRequired: isSeated, Price: price, Quantity: qty, SaleStartTime: new Date(saleStart).toISOString(), SaleEndTime: new Date(saleEnd).toISOString(), Description: desc } };
    const result = await postJson('/EventWizard/UpdateTicketTypeFromReview', payload);
    if (!result.success) {
        const fieldMap = { 'Name':'err-et-name','Quantity':'err-et-qty','Price':'err-et-price','SaleStartTime':'err-et-sale-start','SaleEndTime':'err-et-sale-end' };
        if (result.field && fieldMap[result.field]) _etErr(fieldMap[result.field], result.message);
        else _etErr('editTicketError', result.message);
        return;
    }
    tickets[index] = payload.Ticket;
    renderTicketTable(); closeEditTicket();
}

function setPublishable(ok) {
    const btn = document.getElementById('publishEventButton');
    const warn = document.getElementById('warnNoTickets');
    if (btn) btn.disabled = !ok;
    if (warn) warn.style.display = ok ? 'none' : 'list-item';
    const box = document.getElementById('publishWarning');
    if (box) box.style.display = ok ? 'none' : 'block';
}

function toggleAddTicket() {
    const form = document.getElementById('addTicketForm');
    form.style.display = form.style.display === 'none' ? 'block' : 'none';
    showError('addTicketError', '');
}

async function removeTicket(index) {
    if (tickets.length <= 1) { alert('Cần ít nhất một loại vé.'); return; }
    if (!confirm(`Xoá "${tickets[index].Name}"?`)) return;
    const result = await postJson('/EventWizard/RemoveTicketTypeFromReview', index);
    if (!result.success) { alert(result.message); return; }
    tickets.splice(index, 1); renderTicketTable();
}

async function submitAddTicket() {
    showError('addTicketError', '');
    const name      = document.getElementById('nt-name').value.trim();
    const isSeated  = document.querySelector('input[name="nt-type"]:checked')?.value === 'true';
    const price     = parseFloat(document.getElementById('nt-price').value) || 0;
    const qty       = parseInt(document.getElementById('nt-qty').value);
    const saleStart = document.getElementById('nt-sale-start').value;
    const saleEnd   = document.getElementById('nt-sale-end').value;
    const desc      = document.getElementById('nt-desc').value.trim();

    if (!name)           { showError('addTicketError', 'Tên vé là bắt buộc.'); return; }
    if (!qty || qty < 1) { showError('addTicketError', 'Số lượng ít nhất là 1.'); return; }
    if (!saleStart)      { showError('addTicketError', 'Bắt buộc chọn ngày bắt đầu bán.'); return; }
    if (!saleEnd)        { showError('addTicketError', 'Bắt buộc chọn ngày kết thúc bán.'); return; }
    if (new Date(saleStart) <= new Date()) { showError('addTicketError', 'Ngày bắt đầu bán phải ở tương lai.'); return; }
    if (new Date(saleEnd) <= new Date(saleStart)) { showError('addTicketError', 'Ngày kết thúc bán phải sau ngày bắt đầu.'); return; }

    const payload = { Name: name, IsSeatRequired: isSeated, Price: price, Quantity: qty, SaleStartTime: new Date(saleStart).toISOString(), SaleEndTime: new Date(saleEnd).toISOString(), Description: desc };
    const result = await postJson('/EventWizard/AddTicketTypeFromReview', payload);
    if (!result.success) { showError('addTicketError', result.message); return; }
    tickets.push(payload); renderTicketTable();
    ['nt-name','nt-qty','nt-sale-start','nt-sale-end','nt-desc'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('nt-price').value = '0';
    document.getElementById('nt-standing').checked = true;
    toggleAddTicket();
}

document.getElementById('publishEventForm')?.addEventListener('submit', function (e) {
    const isScheduled = document.querySelector('input[name="publishMode"]:checked')?.value === 'scheduled';
    const publishedAt = document.getElementById('publishedAtInput')?.value;
    if (isScheduled) {
        if (!publishedAt) { e.preventDefault(); alert('Vui lòng chọn thời điểm công bố.'); return; }
        if (new Date(publishedAt) <= new Date()) { e.preventDefault(); alert('Thời điểm công bố phải ở tương lai.'); return; }
        const fmtDate = d => d.toLocaleDateString('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric'}) + ' ' + d.toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'});
        if (!confirm(`Đặt lịch công bố sự kiện vào ${fmtDate(new Date(publishedAt))}?`)) { e.preventDefault(); return; }
    } else {
        if (!confirm('Công bố sự kiện ngay bây giờ? Sự kiện sẽ hiển thị công khai với khách hàng.')) { e.preventDefault(); return; }
    }
    const btn = document.getElementById('publishEventButton');
    if (btn) { btn.disabled = true; btn.textContent = isScheduled ? 'Đang lưu lịch...' : 'Đang công bố...'; }
});
</script>
}