@using Eventix.Web.Models.EventWizard
@model EventReviewViewModel

@{
    ViewData["Title"] = "Tạo sự kiện - Bước 6";
    Layout = "_OrganizerLayout";

    var eventData   = Model.EventInfo;
    var venue       = Model.Venue;
    var ticketTypes = Model.TicketTypes ?? new();

    var categoryName = eventData?.Categories?
        .FirstOrDefault(x => x.Id == eventData.CategoryId)?.Name ?? "N/A";
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <div class="wizard-title">
                <span>Tạo sự kiện</span>
                <h1>Bước 6: Xem lại & Công bố</h1>
                <p>Kiểm tra lại toàn bộ thông tin, chỉnh sửa nếu cần, rồi công bố sự kiện.</p>
            </div>
            @await Html.PartialAsync("_WizardProgress")
        </div>

        <div class="wizard-panel">

            <div class="wizard-grid-3 mb-4">
                <div class="wizard-stat">
                    <span>Loại vé</span>
                    <strong id="statTicketCount">@ticketTypes.Count</strong>
                </div>
                <div class="wizard-stat">
                    <span>Tổng số vé</span>
                    <strong id="statTotalQty">@Model.TotalTicketQuantity.ToString("#,##0")</strong>
                </div>
                <div class="wizard-stat">
                    <span>Sức chứa địa điểm</span>
                    <strong>@(venue?.Capacity.ToString("#,##0") ?? "0")</strong>
                </div>
            </div>

            <!-- Thông tin sự kiện (chỉnh sửa inline) -->
            <section class="wizard-review-section" id="eventInfoSection">
                <div class="wizard-review-header">
                    <div>
                        <h3>Thông tin sự kiện</h3>
                        <p>Nhấn <strong>Sửa</strong> để thay đổi thông tin sự kiện.</p>
                    </div>
                    <button type="button" class="wizard-btn-secondary" onclick="toggleEventInfoEdit()">
                         Sửa
                    </button>
                </div>

                <div id="eventInfoReadView">
                    @if (eventData == null)
                    {
                        <div class="organizer-empty">
                            <h2>Không có thông tin sự kiện</h2>
                        </div>
                    }
                    else
                    {
                        <div class="wizard-review-grid">
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Tên sự kiện</span>
                                <div class="wizard-review-value" id="rv-title">@eventData.Title</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Danh mục</span>
                                <div class="wizard-review-value" id="rv-category">@categoryName</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Bắt đầu</span>
                                <div class="wizard-review-value" id="rv-start">@eventData.StartTime.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Kết thúc</span>
                                <div class="wizard-review-value" id="rv-end">@eventData.EndTime.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Mô tả ngắn</span>
                                <div class="wizard-review-value" id="rv-summary">@(string.IsNullOrWhiteSpace(eventData.Summary) ? "—" : eventData.Summary)</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Thời lượng</span>
                                <div class="wizard-review-value" id="rv-duration">@($"{(eventData.EndTime - eventData.StartTime).TotalHours:0.#} giờ")</div>
                            </div>
                        </div>
                        <div class="wizard-review-item mt-3">
                            <span class="wizard-review-label">Mô tả chi tiết</span>
                            <div class="wizard-review-value" id="rv-description">@(string.IsNullOrWhiteSpace(eventData.Description) ? "—" : eventData.Description)</div>
                        </div>
                    }
                </div>

                <div id="eventInfoEditForm" style="display:none;" class="mt-3">
                    <div id="eventInfoError" class="text-danger mb-3" style="display:none;"></div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Tên sự kiện <span class="text-danger">*</span></label>
                            <input id="ei-title" class="form-control" value="@eventData?.Title" />
                        </div>
                        <div class="form-group">
                            <label>Danh mục <span class="text-danger">*</span></label>
                            <select id="ei-category" class="form-control">
                                @foreach (var cat in (eventData?.Categories ?? new()))
                                {
                                    if (cat.Id == eventData?.CategoryId)
                                    { <option value="@cat.Id" selected="selected">@cat.Name</option> }
                                    else
                                    { <option value="@cat.Id">@cat.Name</option> }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Thời gian bắt đầu <span class="text-danger">*</span></label>
                            <input id="ei-start" type="datetime-local" class="form-control"
                                   value="@eventData?.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="form-group">
                            <label>Thời gian kết thúc <span class="text-danger">*</span></label>
                            <input id="ei-end" type="datetime-local" class="form-control"
                                   value="@eventData?.EndTime.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label>Mô tả ngắn</label>
                        <input id="ei-summary" class="form-control" value="@eventData?.Summary" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Mô tả chi tiết</label>
                        <textarea id="ei-description" rows="4" class="form-control">@eventData?.Description</textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="wizard-btn-primary" onclick="saveEventInfo()">💾 Lưu</button>
                        <button type="button" class="wizard-btn-secondary" onclick="cancelEventInfoEdit()">Huỷ</button>
                    </div>
                </div>
            </section>
            <!-- Địa điểm (chỉ hiển thị) -->
            <section class="wizard-review-section">
                <div class="wizard-review-header">
                    <div>
                        <h3>Địa điểm</h3>
                        <p>Để thay đổi địa điểm, <a asp-controller="EventWizard" asp-action="Step2">quay lại Bước 2</a>.</p>
                    </div>
                    <a asp-controller="EventWizard" asp-action="Step5" class="wizard-btn-secondary"
                       title="Chỉnh sửa sơ đồ chỗ ngồi" style="text-decoration:none;">
                         Sửa map
                    </a>
                </div>
                @if (venue == null)
                {
                    <div class="organizer-empty"><h2>Chưa có địa điểm</h2></div>
                }
                else
                {
                    <div class="wizard-review-grid">
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Tên địa điểm</span>
                            <div class="wizard-review-value">@venue.Name</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Sức chứa</span>
                            <div class="wizard-review-value">@venue.Capacity.ToString("#,##0")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Địa chỉ</span>
                            <div class="wizard-review-value">@(venue.Address ?? "—")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Thành phố</span>
                            <div class="wizard-review-value">@(venue.City ?? "—")</div>
                        </div>
                    </div>
                }
            </section>

            <!-- Loại vé (chỉ xem, mọi thay đổi về Bước 3) -->
            <section class="wizard-review-section" id="ticketTypesSection">
                <div class="wizard-review-header">
                    <div>
                        <h3>Loại vé</h3>
                        <p>Muốn thêm, sửa hoặc xóa loại vé, hãy <a asp-controller="EventWizard" asp-action="Step3">quay lại Bước 3</a>.</p>
                    </div>
                    <a asp-controller="EventWizard" asp-action="Step3"
                       class="wizard-btn-secondary"
                       style="text-decoration:none;font-size:0.83rem;">
                         Quản lý loại vé
                    </a>
                </div>

                @if (!ticketTypes.Any())
                {
                    <div class="organizer-empty">
                        <h2>Chưa có loại vé nào</h2>
                        <p><a asp-controller="EventWizard" asp-action="Step3">Quay lại Bước 3</a> để thêm loại vé.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive mt-3">
                        <table id="ticketTable">
                            <thead>
                                <tr>
                                    <th>Tên</th>
                                    <th>Loại</th>
                                    <th>Giá</th>
                                    <th>SL</th>
                                    <th>Bắt đầu bán</th>
                                    <th>Kết thúc bán</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in ticketTypes)
                                {
                                    var priceLabel = t.Price <= 0 ? "Miễn phí" : $"{t.Price:#,##0} VND";
                                    <tr>
                                        <td><strong>@t.Name</strong></td>
                                        <td>@(t.IsSeatRequired ? "Có ghế" : "Tự do")</td>
                                        <td>@priceLabel</td>
                                        <td>@t.Quantity.ToString("#,##0")</td>
                                        <td>@t.SaleStartTime.ToString("dd/MM HH:mm")</td>
                                        <td>@t.SaleEndTime.ToString("dd/MM HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
            <!-- Địa điểm -->
            <section class="wizard-review-section">
                <div class="wizard-review-header">
                    <div>
                        <h3>Địa điểm</h3>
                        <p>Để thay đổi, <a asp-controller="EventWizard" asp-action="Step2">quay lại Bước 2</a>.</p>
                    </div>
                </div>
                @if (venue == null)
                {
                    <div class="organizer-empty"><h2>Chưa có địa điểm</h2></div>
                }
                else
                {
                    <div class="wizard-review-grid">
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Tên địa điểm</span>
                            <div class="wizard-review-value">@venue.Name</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Sức chứa</span>
                            <div class="wizard-review-value">@venue.Capacity.ToString("#,##0")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Địa chỉ</span>
                            <div class="wizard-review-value">@(venue.Address ?? "—")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Thành phố</span>
                            <div class="wizard-review-value">@(venue.City ?? "—")</div>
                        </div>
                    </div>
                }
            </section>

           
            <!-- Cảnh báo chưa đủ điều kiện công bố -->
            <div id="publishWarning" class="publish-warning mb-4" style="display:@(!Model.CanPublish ? "block" : "none");">
                <strong>Sự kiện chưa thể công bố</strong>
                <ul>
                    @if (Model.EventInfo == null) { <li>Thiếu thông tin sự kiện.</li> }
                    @if (Model.Venue == null) { <li>Chưa chọn địa điểm.</li> }
                    @if (!Model.HasTicketTypes) { <li id="warnNoTickets">Cần ít nhất một loại vé.</li> }
                </ul>
            </div>

            <div class="wizard-actions" style="flex-direction:column;align-items:stretch;gap:16px;">
                <form asp-controller="EventWizard"
                      asp-action="Publish"
                      method="post"
                      id="publishEventForm">
                    @Html.AntiForgeryToken()

                    <div class="publish-schedule-box">
                        <div class="publish-schedule-header">
                            <strong> Ngày công bố</strong>
                            <p>Chọn thời điểm sự kiện hiển thị công khai với khách hàng.</p>
                        </div>
                        <div class="publish-schedule-row">
                            <label>
                                <input type="radio" name="publishMode" value="now" checked
                                       onchange="document.getElementById('publishedAtWrap').style.display='none'" />
                                Công bố ngay
                            </label>
                            <label>
                                <input type="radio" name="publishMode" value="scheduled"
                                       onchange="document.getElementById('publishedAtWrap').style.display='block'" />
                                Đặt lịch công bố
                            </label>
                        </div>
                        <div id="publishedAtWrap" style="display:none;margin-top:12px;">
                            <input type="datetime-local"
                                   name="PublishedAt"
                                   id="publishedAtInput"
                                   class="form-control"
                                   style="max-width:320px;" />
                            <p style="margin:6px 0 0;font-size:13px;color:#9ca3af;">
                                Sự kiện sẽ hiển thị công khai vào thời điểm này.
                            </p>
                        </div>
                    </div>

                    <button type="submit"
                            class="wizard-btn-primary"
                            id="publishEventButton"
                            @(!Model.CanPublish ? "disabled" : "")>
                         Công bố sự kiện
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>
@section Scripts {
<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

function toLocalDatetimeValue(date) {
    const pad = n => String(n).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
}

const _now    = new Date();
const _nowStr = toLocalDatetimeValue(_now);

document.addEventListener('DOMContentLoaded', function () {
    const eiStart = document.getElementById('ei-start');
    const eiEnd   = document.getElementById('ei-end');
    if (eiStart) {
        eiStart.setAttribute('min', _nowStr);
        eiStart.addEventListener('change', function () {
            if (eiEnd) eiEnd.setAttribute('min', this.value);
            if (eiEnd?.value && eiEnd.value <= this.value) eiEnd.value = '';
        });
    }
    if (eiEnd) eiEnd.setAttribute('min', _nowStr);

    const ntStart = document.getElementById('nt-sale-start');
    const ntEnd   = document.getElementById('nt-sale-end');
    if (ntStart) {
        ntStart.setAttribute('min', _nowStr);
        const d = new Date(_now); d.setHours(d.getHours()+1, 0, 0, 0);
        ntStart.value = toLocalDatetimeValue(d);
        ntStart.addEventListener('change', function () {
            if (ntEnd) ntEnd.setAttribute('min', this.value);
            if (ntEnd?.value && ntEnd.value <= this.value) ntEnd.value = '';
        });
    }
    if (ntEnd) {
        ntEnd.setAttribute('min', _nowStr);
        const d = new Date(_now); d.setDate(d.getDate()+7); d.setMinutes(0,0,0);
        ntEnd.value = toLocalDatetimeValue(d);
    }

    const publishedAtInput = document.getElementById('publishedAtInput');
    if (publishedAtInput) {
        const minPublish = new Date(_now);
        minPublish.setMinutes(minPublish.getMinutes() + 5, 0, 0);
        publishedAtInput.setAttribute('min', toLocalDatetimeValue(minPublish));
    }
});

function postForm(url, formData) {
    formData.append('__RequestVerificationToken', token);
    return fetch(url, { method: 'POST', body: formData }).then(r => r.json());
}

function showError(id, msg) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.style.display = msg ? 'block' : 'none';
}

function toggleEventInfoEdit() {
    const read = document.getElementById('eventInfoReadView');
    const form = document.getElementById('eventInfoEditForm');
    const isHidden = form.style.display === 'none';
    read.style.display = isHidden ? 'none' : 'block';
    form.style.display = isHidden ? 'block' : 'none';
    showError('eventInfoError', '');
}

function cancelEventInfoEdit() {
    document.getElementById('eventInfoReadView').style.display = 'block';
    document.getElementById('eventInfoEditForm').style.display = 'none';
    showError('eventInfoError', '');
}

async function saveEventInfo() {
    showError('eventInfoError', '');
    const title   = document.getElementById('ei-title').value.trim();
    const catId   = document.getElementById('ei-category').value;
    const catName = document.getElementById('ei-category').selectedOptions[0]?.text ?? '';
    const start   = document.getElementById('ei-start').value;
    const end     = document.getElementById('ei-end').value;
    const summary = document.getElementById('ei-summary').value.trim();
    const desc    = document.getElementById('ei-description').value.trim();

    if (!title)  { showError('eventInfoError', 'Tên sự kiện là bắt buộc.'); return; }
    if (!catId)  { showError('eventInfoError', 'Vui lòng chọn danh mục.'); return; }
    if (!start)  { showError('eventInfoError', 'Thời gian bắt đầu là bắt buộc.'); return; }
    if (!end)    { showError('eventInfoError', 'Thời gian kết thúc là bắt buộc.'); return; }
    if (new Date(start) <= new Date()) { showError('eventInfoError', 'Thời gian bắt đầu phải ở tương lai.'); return; }
    if (new Date(end) <= new Date(start)) { showError('eventInfoError', 'Thời gian kết thúc phải sau bắt đầu.'); return; }

    const fd = new FormData();
    fd.append('Title', title); fd.append('CategoryId', catId);
    fd.append('StartTime', new Date(start).toISOString());
    fd.append('EndTime', new Date(end).toISOString());
    fd.append('Summary', summary); fd.append('Description', desc);

    const result = await postForm('/EventWizard/UpdateEventInfo', fd);
    if (!result.success) { showError('eventInfoError', result.message); return; }

    document.getElementById('rv-title').textContent    = title;
    document.getElementById('rv-category').textContent = catName;
    document.getElementById('rv-summary').textContent  = summary || '—';
    document.getElementById('rv-description').textContent = desc || '—';

    const startDate = new Date(start), endDate = new Date(end);
    const fmt = d => d.toLocaleDateString('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric'})
                   + ' ' + d.toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'});
    document.getElementById('rv-start').textContent = fmt(startDate);
    document.getElementById('rv-end').textContent   = fmt(endDate);
    document.getElementById('rv-duration').textContent = `${((endDate-startDate)/3600000).toFixed(1)} giờ`;
    cancelEventInfoEdit();
}

function setPublishable(ok) {
    const btn = document.getElementById('publishEventButton');
    const warn = document.getElementById('warnNoTickets');
    if (btn) btn.disabled = !ok;
    if (warn) warn.style.display = ok ? 'none' : 'list-item';
    const box = document.getElementById('publishWarning');
    if (box) box.style.display = ok ? 'none' : 'block';
}

document.getElementById('publishEventForm')?.addEventListener('submit', function (e) {
    const isScheduled = document.querySelector('input[name="publishMode"]:checked')?.value === 'scheduled';
    const publishedAt = document.getElementById('publishedAtInput')?.value;
    if (isScheduled) {
        if (!publishedAt) { e.preventDefault(); alert('Vui lòng chọn thời điểm công bố.'); return; }
        if (new Date(publishedAt) <= new Date()) { e.preventDefault(); alert('Thời điểm công bố phải ở tương lai.'); return; }
        const fmtDate = d => d.toLocaleDateString('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric'}) + ' ' + d.toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'});
        if (!confirm(`Đặt lịch công bố sự kiện vào ${fmtDate(new Date(publishedAt))}?`)) { e.preventDefault(); return; }
    } else {
        if (!confirm('Công bố sự kiện ngay bây giờ? Sự kiện sẽ hiển thị công khai với khách hàng.')) { e.preventDefault(); return; }
    }
    const btn = document.getElementById('publishEventButton');
    if (btn) { btn.disabled = true; btn.textContent = isScheduled ? 'Đang lưu lịch...' : 'Đang công bố...'; }
});
</script>
}