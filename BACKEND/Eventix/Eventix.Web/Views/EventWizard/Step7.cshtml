@using Eventix.Web.Models.EventWizard
@model EventReviewViewModel

@{
    ViewData["Title"] = "Create Event - Review & Publish";
    Layout = "_OrganizerLayout";

    var eventData   = Model.EventInfo;
    var venue       = Model.Venue;
    var ticketTypes = Model.TicketTypes ?? new();

    var categoryName = eventData?.Categories?
        .FirstOrDefault(x => x.Id == eventData.CategoryId)?.Name ?? "N/A";
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <div class="wizard-title">
                <span>Create Event</span>
                <h1>Step 6: Review & Publish</h1>
                <p>Edit any details directly below, then publish when ready.</p>
            </div>
            @await Html.PartialAsync("_WizardProgress")
        </div>

        <div class="wizard-panel">

            <div class="wizard-grid-3 mb-4">
                <div class="wizard-stat">
                    <span>Ticket Types</span>
                    <strong id="statTicketCount">@ticketTypes.Count</strong>
                </div>
                <div class="wizard-stat">
                    <span>Total Tickets</span>
                    <strong id="statTotalQty">@Model.TotalTicketQuantity.ToString("N0")</strong>
                </div>
                <div class="wizard-stat">
                    <span>Venue Capacity</span>
                    <strong>@(venue?.Capacity.ToString("N0") ?? "0")</strong>
                </div>
            </div>

            <!-- ── Event Information (inline edit) ── -->
            <section class="wizard-review-section" id="eventInfoSection">
                <div class="wizard-review-header">
                    <div>
                        <h3>Event Information</h3>
                        <p>Click <strong>Edit</strong> to change event details.</p>
                    </div>
                    <button type="button" class="wizard-btn-secondary" onclick="toggleEventInfoEdit()">
                        ✏️ Edit
                    </button>
                </div>

                <!-- Read view -->
                <div id="eventInfoReadView">
                    @if (eventData == null)
                    {
                        <div class="organizer-empty">
                            <h2>Event information unavailable</h2>
                        </div>
                    }
                    else
                    {
                        <div class="wizard-review-grid">
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Title</span>
                                <div class="wizard-review-value" id="rv-title">@eventData.Title</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Category</span>
                                <div class="wizard-review-value" id="rv-category">@categoryName</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Start Time</span>
                                <div class="wizard-review-value" id="rv-start">@eventData.StartTime.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">End Time</span>
                                <div class="wizard-review-value" id="rv-end">@eventData.EndTime.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Summary</span>
                                <div class="wizard-review-value" id="rv-summary">@(string.IsNullOrWhiteSpace(eventData.Summary) ? "—" : eventData.Summary)</div>
                            </div>
                            <div class="wizard-review-item">
                                <span class="wizard-review-label">Duration</span>
                                <div class="wizard-review-value" id="rv-duration">@($"{(eventData.EndTime - eventData.StartTime).TotalHours:0.#} hours")</div>
                            </div>
                        </div>
                        <div class="wizard-review-item mt-3">
                            <span class="wizard-review-label">Description</span>
                            <div class="wizard-review-value" id="rv-description">@(string.IsNullOrWhiteSpace(eventData.Description) ? "—" : eventData.Description)</div>
                        </div>
                    }
                </div>

                <!-- Edit form (hidden by default) -->
                <div id="eventInfoEditForm" style="display:none;" class="mt-3">
                    <div id="eventInfoError" class="text-danger mb-3" style="display:none;"></div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Title <span class="text-danger">*</span></label>
                            <input id="ei-title" class="form-control" value="@eventData?.Title" />
                        </div>
                        <div class="form-group">
                            <label>Category <span class="text-danger">*</span></label>
                            <select id="ei-category" class="form-control">
                                @foreach (var cat in (eventData?.Categories ?? new()))
                                {
                                    if (cat.Id == eventData?.CategoryId)
                                    {
                                        <option value="@cat.Id" selected="selected">@cat.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Start Time <span class="text-danger">*</span></label>
                            <input id="ei-start" type="datetime-local" class="form-control"
                                   value="@eventData?.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="form-group">
                            <label>End Time <span class="text-danger">*</span></label>
                            <input id="ei-end" type="datetime-local" class="form-control"
                                   value="@eventData?.EndTime.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label>Summary</label>
                        <input id="ei-summary" class="form-control" value="@eventData?.Summary" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Description</label>
                        <textarea id="ei-description" rows="4" class="form-control">@eventData?.Description</textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="wizard-btn-primary" onclick="saveEventInfo()">💾 Save</button>
                        <button type="button" class="wizard-btn-secondary" onclick="cancelEventInfoEdit()">Cancel</button>
                    </div>
                </div>
            </section>

            <!-- ── Venue (display only) ── -->
            <section class="wizard-review-section">
                <div class="wizard-review-header">
                    <div>
                        <h3>Venue</h3>
                        <p>To change venue, <a asp-controller="EventWizard" asp-action="Step2">go back to Step 2</a>.</p>
                    </div>
                </div>
                @if (venue == null)
                {
                    <div class="organizer-empty"><h2>Venue unavailable</h2></div>
                }
                else
                {
                    <div class="wizard-review-grid">
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Name</span>
                            <div class="wizard-review-value">@venue.Name</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Capacity</span>
                            <div class="wizard-review-value">@venue.Capacity.ToString("N0")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">Address</span>
                            <div class="wizard-review-value">@(venue.Address ?? "—")</div>
                        </div>
                        <div class="wizard-review-item">
                            <span class="wizard-review-label">City</span>
                            <div class="wizard-review-value">@(venue.City ?? "—")</div>
                        </div>
                    </div>
                }
            </section>


            <!-- ── Ticket Types (inline add / remove) ── -->
            <section class="wizard-review-section" id="ticketTypesSection">
                <div class="wizard-review-header">
                    <div>
                        <h3>Ticket Types</h3>
                        <p>Add or remove ticket types directly.</p>
                    </div>
                    <button type="button" class="wizard-btn-secondary" onclick="toggleAddTicket()">
                        ➕ Add Ticket
                    </button>
                </div>

                <!-- Ticket list (rendered by JS) -->
                <div id="ticketListContainer">
                    <div class="table-responsive">
                        <table id="ticketTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Price</th>
                                    <th>Qty</th>
                                    <th>Sale Start</th>
                                    <th>Sale End</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="ticketTableBody">
                                @for (int i = 0; i < ticketTypes.Count; i++)
                                {
                                    var t = ticketTypes[i];
                                    var priceLabel = t.Price <= 0 ? "Free" : $"{t.Price:N0} VND";
                                    <tr id="ticket-row-@i" data-index="@i">
                                        <td><strong>@t.Name</strong></td>
                                        <td>@(t.IsSeatRequired ? "💺 Seated" : "🧍 Standing")</td>
                                        <td>@priceLabel</td>
                                        <td>@t.Quantity.ToString("N0")</td>
                                        <td>@t.SaleStartTime.ToString("dd/MM HH:mm")</td>
                                        <td>@t.SaleEndTime.ToString("dd/MM HH:mm")</td>
                                        <td style="display:flex;gap:6px;">
                                            <button type="button"
                                                    style="background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.3);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;"
                                                    onclick="editTicket(@i)">
                                                ✏️ Edit
                                            </button>
                                            <button type="button"
                                                    class="ticket-action"
                                                    style="background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;"
                                                    onclick="removeTicket(@i)">
                                                🗑 Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="noTicketsMsg" style="display:@(ticketTypes.Any() ? "none" : "block");"
                         class="organizer-empty">
                        <h2>No ticket types</h2>
                        <p>Add at least one ticket type before publishing.</p>
                    </div>
                </div>

                <!-- Add ticket form (hidden by default) -->
                <div id="addTicketForm" class="wizard-card mt-4" style="display:none;">
                    <h4 class="mb-3">New Ticket Type</h4>
                    <div id="addTicketError" class="text-danger mb-3" style="display:none;"></div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Name <span class="text-danger">*</span></label>
                            <input id="nt-name" class="form-control" placeholder="VIP, Standing, Early Bird..." />
                        </div>
                        <div class="form-group">
                            <label>Admission Type</label>
                            <div class="d-flex gap-3 mt-2">
                                <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                                    <input type="radio" name="nt-type" id="nt-standing" value="false" checked />
                                    🧍 Standing
                                </label>
                                <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                                    <input type="radio" name="nt-type" id="nt-seated" value="true" />
                                    💺 Seated
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Price (VND)</label>
                            <input id="nt-price" type="number" min="0" step="1000" class="form-control" placeholder="0 = Free" value="0" />
                        </div>
                        <div class="form-group">
                            <label>Quantity <span class="text-danger">*</span></label>
                            <input id="nt-qty" type="number" min="1" class="form-control" placeholder="100" />
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Sale Start <span class="text-danger">*</span></label>
                            <input id="nt-sale-start" type="datetime-local" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Sale End <span class="text-danger">*</span></label>
                            <input id="nt-sale-end" type="datetime-local" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label>Description</label>
                        <textarea id="nt-desc" rows="2" class="form-control" placeholder="Optional..."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="wizard-btn-primary" onclick="submitAddTicket()">➕ Add</button>
                        <button type="button" class="wizard-btn-secondary" onclick="toggleAddTicket()">Cancel</button>
                    </div>
                </div>

                <!-- Edit ticket form (hidden by default) -->
                <div id="editTicketForm" class="wizard-card mt-4" style="display:none;">
                    <h4 class="mb-1">Edit Ticket Type</h4>
                    <p class="text-muted mb-3" id="editTicketSubtitle"></p>
                    <input type="hidden" id="et-index" value="-1" />
                    <div id="editTicketError" class="text-danger mb-3" style="display:none;"></div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Name <span class="text-danger">*</span></label>
                            <input id="et-name" class="form-control" />
                            <span id="err-et-name" class="text-danger" style="display:none;"></span>
                        </div>
                        <div class="form-group">
                            <label>Admission Type</label>
                            <div class="d-flex gap-3 mt-2">
                                <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                                    <input type="radio" name="et-type" id="et-standing" value="false" checked />
                                    🧍 Standing
                                </label>
                                <label style="cursor:pointer;display:flex;align-items:center;gap:6px;">
                                    <input type="radio" name="et-type" id="et-seated" value="true" />
                                    💺 Seated
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Price (VND)</label>
                            <input id="et-price" type="number" min="0" step="1000" class="form-control" value="0" />
                            <span id="err-et-price" class="text-danger" style="display:none;"></span>
                        </div>
                        <div class="form-group">
                            <label>Quantity <span class="text-danger">*</span></label>
                            <input id="et-qty" type="number" min="1" class="form-control" />
                            <span id="err-et-qty" class="text-danger" style="display:none;"></span>
                        </div>
                    </div>
                    <div class="wizard-grid-2 mb-3">
                        <div class="form-group">
                            <label>Sale Start <span class="text-danger">*</span></label>
                            <input id="et-sale-start" type="datetime-local" class="form-control" />
                            <span id="err-et-sale-start" class="text-danger" style="display:none;"></span>
                        </div>
                        <div class="form-group">
                            <label>Sale End <span class="text-danger">*</span></label>
                            <input id="et-sale-end" type="datetime-local" class="form-control" />
                            <span id="err-et-sale-end" class="text-danger" style="display:none;"></span>
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label>Description</label>
                        <textarea id="et-desc" rows="2" class="form-control"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="wizard-btn-primary" onclick="submitEditTicket()">💾 Save Changes</button>
                        <button type="button" class="wizard-btn-secondary" onclick="closeEditTicket()">Cancel</button>
                    </div>
                </div>
            </section>


            <!-- ── Publish warning ── -->
            <div id="publishWarning" class="publish-warning mb-4" style="display:@(!Model.CanPublish ? "block" : "none");">
                <strong>Event cannot be published yet</strong>
                <ul>
                    @if (Model.EventInfo == null)
                    {
                        <li>Event information is missing.</li>
                    }
                    @if (Model.Venue == null)
                    {
                        <li>A venue has not been selected.</li>
                    }
                    @if (!Model.HasTicketTypes)
                    {
                        <li id="warnNoTickets">Create at least one ticket type.</li>
                    }
                </ul>
            </div>

            <div class="wizard-actions">
                <form asp-controller="EventWizard"
                      asp-action="Publish"
                      method="post"
                      id="publishEventForm">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="wizard-btn-primary"
                            id="publishEventButton"
                            @(!Model.CanPublish ? "disabled" : "")>
                        🚀 Publish Event
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
<script>
// ── helpers ───────────────────────────────────────────────────────────────────
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

function toLocalDatetimeValue(date) {
    const pad = n => String(n).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
}

const _now    = new Date();
const _nowStr = toLocalDatetimeValue(_now);

document.addEventListener('DOMContentLoaded', function () {
    // Datetime inputs: event info edit form
    const eiStart = document.getElementById('ei-start');
    const eiEnd   = document.getElementById('ei-end');
    if (eiStart) {
        eiStart.setAttribute('min', _nowStr);
        eiStart.addEventListener('change', function () {
            if (eiEnd) eiEnd.setAttribute('min', this.value);
            if (eiEnd?.value && eiEnd.value <= this.value) eiEnd.value = '';
        });
    }
    if (eiEnd) eiEnd.setAttribute('min', _nowStr);

    // Datetime inputs: add ticket form
    const ntStart = document.getElementById('nt-sale-start');
    const ntEnd   = document.getElementById('nt-sale-end');
    if (ntStart) {
        ntStart.setAttribute('min', _nowStr);
        const d = new Date(_now); d.setHours(d.getHours()+1, 0, 0, 0);
        ntStart.value = toLocalDatetimeValue(d);
        ntStart.addEventListener('change', function () {
            if (ntEnd) ntEnd.setAttribute('min', this.value);
            if (ntEnd?.value && ntEnd.value <= this.value) ntEnd.value = '';
        });
    }
    if (ntEnd) {
        ntEnd.setAttribute('min', _nowStr);
        const d = new Date(_now); d.setDate(d.getDate()+7); d.setMinutes(0,0,0);
        ntEnd.value = toLocalDatetimeValue(d);
    }
});

function postJson(url, data) {
    return fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify(data)
    }).then(r => r.json());
}

function postForm(url, formData) {
    formData.append('__RequestVerificationToken', token);
    return fetch(url, { method: 'POST', body: formData }).then(r => r.json());
}

function showError(id, msg) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.style.display = msg ? 'block' : 'none';
}

// Keep a JS copy of tickets so we can re-render without reload
let tickets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TicketTypes));

// ── Event Info edit ───────────────────────────────────────────────────────────
function toggleEventInfoEdit() {
    const read = document.getElementById('eventInfoReadView');
    const form = document.getElementById('eventInfoEditForm');
    const isHidden = form.style.display === 'none';
    read.style.display = isHidden ? 'none' : 'block';
    form.style.display = isHidden ? 'block' : 'none';
    showError('eventInfoError', '');
}

function cancelEventInfoEdit() {
    document.getElementById('eventInfoReadView').style.display = 'block';
    document.getElementById('eventInfoEditForm').style.display = 'none';
    showError('eventInfoError', '');
}

async function saveEventInfo() {
    showError('eventInfoError', '');

    const title    = document.getElementById('ei-title').value.trim();
    const catId    = document.getElementById('ei-category').value;
    const catName  = document.getElementById('ei-category').selectedOptions[0]?.text ?? '';
    const start    = document.getElementById('ei-start').value;
    const end      = document.getElementById('ei-end').value;
    const summary  = document.getElementById('ei-summary').value.trim();
    const desc     = document.getElementById('ei-description').value.trim();

    if (!title)  { showError('eventInfoError', 'Title is required.'); return; }
    if (!catId)  { showError('eventInfoError', 'Category is required.'); return; }
    if (!start)  { showError('eventInfoError', 'Start time is required.'); return; }
    if (!end)    { showError('eventInfoError', 'End time is required.'); return; }
    if (new Date(start) <= new Date()) { showError('eventInfoError', 'Start time must be in the future.'); return; }
    if (new Date(end) <= new Date(start)) { showError('eventInfoError', 'End time must be after start time.'); return; }

    const fd = new FormData();
    fd.append('Title', title);
    fd.append('CategoryId', catId);
    fd.append('StartTime', new Date(start).toISOString());
    fd.append('EndTime',   new Date(end).toISOString());
    fd.append('Summary', summary);
    fd.append('Description', desc);

    const result = await postForm('/EventWizard/UpdateEventInfo', fd);

    if (!result.success) { showError('eventInfoError', result.message); return; }

    // Update read view
    document.getElementById('rv-title').textContent    = title;
    document.getElementById('rv-category').textContent = catName;
    document.getElementById('rv-summary').textContent  = summary || '—';
    document.getElementById('rv-description').textContent = desc || '—';

    const startDate = new Date(start);
    const endDate   = new Date(end);
    const fmt = d => d.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric' })
                   + ' ' + d.toLocaleTimeString('vi-VN', { hour:'2-digit', minute:'2-digit' });
    document.getElementById('rv-start').textContent = fmt(startDate);
    document.getElementById('rv-end').textContent   = fmt(endDate);
    const hours = ((endDate - startDate) / 3600000).toFixed(1);
    document.getElementById('rv-duration').textContent = `${hours} hours`;

    cancelEventInfoEdit();
}

// ── Ticket Types ──────────────────────────────────────────────────────────────
function renderTicketTable() {
    const tbody = document.getElementById('ticketTableBody');
    const noMsg = document.getElementById('noTicketsMsg');

    if (!tickets.length) {
        tbody.innerHTML = '';
        noMsg.style.display = 'block';
        setPublishable(false);
        return;
    }

    noMsg.style.display = 'none';
    tbody.innerHTML = tickets.map((t, i) => {
        const priceLabel = t.Price <= 0 ? 'Free' : `${Number(t.Price).toLocaleString('vi-VN')} VND`;
        const typeLabel  = t.IsSeatRequired ? '💺 Seated' : '🧍 Standing';
        const fmtDate = s => {
            const d = new Date(s);
            return d.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit' })
                 + ' ' + d.toLocaleTimeString('vi-VN', { hour:'2-digit', minute:'2-digit' });
        };
        return `<tr id="ticket-row-${i}" data-index="${i}">
            <td><strong>${t.Name}</strong></td>
            <td>${typeLabel}</td>
            <td>${priceLabel}</td>
            <td>${Number(t.Quantity).toLocaleString('vi-VN')}</td>
            <td>${fmtDate(t.SaleStartTime)}</td>
            <td>${fmtDate(t.SaleEndTime)}</td>
            <td style="display:flex;gap:6px;">
                <button type="button"
                    style="background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.3);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;"
                    onclick="editTicket(${i})">✏️ Edit</button>
                <button type="button"
                    style="background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:0.8rem;"
                    onclick="removeTicket(${i})">🗑 Remove</button>
            </td>
        </tr>`;
    }).join('');

    document.getElementById('statTicketCount').textContent = tickets.length;
    const total = tickets.reduce((s, t) => s + Number(t.Quantity), 0);
    document.getElementById('statTotalQty').textContent = total.toLocaleString('vi-VN');
    setPublishable(tickets.length > 0);
}

// ── Edit ticket inline ────────────────────────────────────────────────────────
function _etErr(id, msg) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.style.display = msg ? 'inline' : 'none';
}
function _clearEtErrors() {
    ['err-et-name','err-et-price','err-et-qty','err-et-sale-start','err-et-sale-end','editTicketError']
        .forEach(id => _etErr(id, ''));
}

function editTicket(index) {
    closeEditTicket();

    const t = tickets[index];
    if (!t) return;

    document.getElementById('et-index').value          = index;
    document.getElementById('et-name').value           = t.Name;
    document.getElementById('et-price').value          = t.Price;
    document.getElementById('et-qty').value            = t.Quantity;
    document.getElementById('et-desc').value           = t.Description || '';
    document.getElementById('editTicketSubtitle').textContent = `Editing: ${t.Name}`;

    // Admission type
    const isSeated = t.IsSeatRequired === true;
    document.getElementById('et-seated').checked   = isSeated;
    document.getElementById('et-standing').checked = !isSeated;

    // Datetime
    const toLocal = s => {
        const d = new Date(s);
        const pad = n => String(n).padStart(2,'0');
        return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    };
    document.getElementById('et-sale-start').value = toLocal(t.SaleStartTime);
    document.getElementById('et-sale-end').value   = toLocal(t.SaleEndTime);

    // Set min = now
    const nowStr = toLocalDatetimeValue(_now);
    document.getElementById('et-sale-start').setAttribute('min', nowStr);
    document.getElementById('et-sale-end').setAttribute('min', nowStr);

    // Close add form if open
    document.getElementById('addTicketForm').style.display = 'none';

    document.getElementById('editTicketForm').style.display = 'block';
    document.getElementById('editTicketForm').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function closeEditTicket() {
    document.getElementById('editTicketForm').style.display = 'none';
    _clearEtErrors();
}

async function submitEditTicket() {
    _clearEtErrors();

    const index    = parseInt(document.getElementById('et-index').value);
    const name     = document.getElementById('et-name').value.trim();
    const price    = parseFloat(document.getElementById('et-price').value) || 0;
    const qty      = parseInt(document.getElementById('et-qty').value);
    const saleStart = document.getElementById('et-sale-start').value;
    const saleEnd   = document.getElementById('et-sale-end').value;
    const desc      = document.getElementById('et-desc').value.trim();
    const isSeated  = document.querySelector('input[name="et-type"]:checked')?.value === 'true';

    // Client-side validate để hiện lỗi tức thì dưới từng trường
    let hasErr = false;
    if (!name)                    { _etErr('err-et-name', 'Ticket name is required.'); hasErr = true; }
    if (!qty || qty < 1)          { _etErr('err-et-qty', 'Quantity must be at least 1.'); hasErr = true; }
    if (price < 0)                { _etErr('err-et-price', 'Price cannot be negative.'); hasErr = true; }
    if (!saleStart)               { _etErr('err-et-sale-start', 'Sale start time is required.'); hasErr = true; }
    else if (new Date(saleStart) <= new Date()) { _etErr('err-et-sale-start', 'Sale start must be in the future.'); hasErr = true; }
    if (!saleEnd)                 { _etErr('err-et-sale-end', 'Sale end time is required.'); hasErr = true; }
    else if (saleStart && new Date(saleEnd) <= new Date(saleStart)) { _etErr('err-et-sale-end', 'Sale end must be after sale start.'); hasErr = true; }
    if (hasErr) return;

    const payload = {
        Index: index,
        Ticket: {
            Name: name,
            IsSeatRequired: isSeated,
            Price: price,
            Quantity: qty,
            SaleStartTime: new Date(saleStart).toISOString(),
            SaleEndTime:   new Date(saleEnd).toISOString(),
            Description: desc
        }
    };

    const result = await postJson('/EventWizard/UpdateTicketTypeFromReview', payload);

    if (!result.success) {
        // Map field name từ server về error span
        const fieldMap = {
            'Name': 'err-et-name',
            'Quantity': 'err-et-qty',
            'Price': 'err-et-price',
            'SaleStartTime': 'err-et-sale-start',
            'SaleEndTime': 'err-et-sale-end'
        };
        if (result.field && fieldMap[result.field]) {
            _etErr(fieldMap[result.field], result.message);
        } else {
            _etErr('editTicketError', result.message);
        }
        return;
    }

    // Cập nhật local array
    tickets[index] = payload.Ticket;
    renderTicketTable();
    closeEditTicket();
}

function setPublishable(ok) {
    const btn = document.getElementById('publishEventButton');
    const warn = document.getElementById('warnNoTickets');
    if (btn) btn.disabled = !ok;
    if (warn) warn.style.display = ok ? 'none' : 'list-item';
    const box = document.getElementById('publishWarning');
    if (box) box.style.display = ok ? 'none' : 'block';
}

function toggleAddTicket() {
    const form = document.getElementById('addTicketForm');
    form.style.display = form.style.display === 'none' ? 'block' : 'none';
    showError('addTicketError', '');
}

async function removeTicket(index) {
    if (tickets.length <= 1) {
        alert('At least one ticket type is required.');
        return;
    }
    if (!confirm(`Remove "${tickets[index].Name}"?`)) return;

    const result = await postJson('/EventWizard/RemoveTicketTypeFromReview', index);

    if (!result.success) { alert(result.message); return; }

    tickets.splice(index, 1);
    renderTicketTable();
}

async function submitAddTicket() {
    showError('addTicketError', '');

    const name      = document.getElementById('nt-name').value.trim();
    const isSeated  = document.querySelector('input[name="nt-type"]:checked')?.value === 'true';
    const price     = parseFloat(document.getElementById('nt-price').value) || 0;
    const qty       = parseInt(document.getElementById('nt-qty').value);
    const saleStart = document.getElementById('nt-sale-start').value;
    const saleEnd   = document.getElementById('nt-sale-end').value;
    const desc      = document.getElementById('nt-desc').value.trim();

    if (!name)       { showError('addTicketError', 'Ticket name is required.'); return; }
    if (!qty || qty < 1) { showError('addTicketError', 'Quantity must be at least 1.'); return; }
    if (!saleStart)  { showError('addTicketError', 'Sale start time is required.'); return; }
    if (!saleEnd)    { showError('addTicketError', 'Sale end time is required.'); return; }
    if (new Date(saleStart) <= new Date()) { showError('addTicketError', 'Sale start must be in the future.'); return; }
    if (new Date(saleEnd) <= new Date(saleStart)) { showError('addTicketError', 'Sale end must be after sale start.'); return; }

    const payload = {
        Name: name,
        IsSeatRequired: isSeated,
        Price: price,
        Quantity: qty,
        SaleStartTime: new Date(saleStart).toISOString(),
        SaleEndTime:   new Date(saleEnd).toISOString(),
        Description: desc
    };

    const result = await postJson('/EventWizard/AddTicketTypeFromReview', payload);

    if (!result.success) { showError('addTicketError', result.message); return; }

    tickets.push(payload);
    renderTicketTable();

    // Reset form
    document.getElementById('nt-name').value = '';
    document.getElementById('nt-price').value = '0';
    document.getElementById('nt-qty').value = '';
    document.getElementById('nt-sale-start').value = '';
    document.getElementById('nt-sale-end').value = '';
    document.getElementById('nt-desc').value = '';
    document.getElementById('nt-standing').checked = true;
    toggleAddTicket();
}

// ── Publish confirm ───────────────────────────────────────────────────────────
document.getElementById('publishEventForm')?.addEventListener('submit', function (e) {
    if (!confirm('Publish this event now? It will become visible to customers.')) {
        e.preventDefault();
        return;
    }
    const btn = document.getElementById('publishEventButton');
    if (btn) { btn.disabled = true; btn.textContent = 'Publishing...'; }
});
</script>
}
