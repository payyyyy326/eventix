@using Eventix.Web.Models.EventWizard
@model EventSeatAssignmentViewModel

@{
    ViewData["Title"] = "Create Event - Step 4";
    Layout = "_OrganizerLayout";

    var seatedTypes  = Model.TicketTypes.Where(t => t.IsSeatRequired).ToList();
    var standingTypes = Model.TicketTypes.Where(t => !t.IsSeatRequired).ToList();
    var totalSeats   = seatedTypes.Sum(t => t.Quantity);
}

<section class="organizer-page">
    <div class="wizard-shell">

        <div class="wizard-top">
            <a class="wizard-back-link"
               asp-controller="EventWizard"
               asp-action="Step4">
                ← Back to Ticket Types
            </a>

            <div class="wizard-title">
                <span>Create Event</span>
                <h1>Step 4: Seat Preview</h1>
                <p>
                    Review how seats will be auto-generated for each ticket type.
                    Seated tickets generate one seat per ticket quantity when published.
                </p>
            </div>

            @await Html.PartialAsync("_WizardProgress")
        </div>

        <div class="wizard-panel">

            <div class="wizard-grid-3 mb-4">
                <div class="wizard-stat">
                    <span>Total Ticket Types</span>
                    <strong>@Model.TicketTypes.Count</strong>
                </div>

                <div class="wizard-stat">
                    <span>Seated Sections</span>
                    <strong>@seatedTypes.Count</strong>
                </div>

                <div class="wizard-stat">
                    <span>Seats to Generate</span>
                    <strong>@totalSeats</strong>
                </div>
            </div>

            <div class="wizard-card mb-4">
                <h3>@(Model.Venue?.Name ?? "Selected Venue")</h3>
                <p>@(Model.Venue?.Address ?? "No address")</p>

                <div class="wizard-meta">
                    <span class="wizard-pill">
                        City: @(Model.Venue?.City ?? "N/A")
                    </span>
                    <span class="wizard-pill">
                        Venue Capacity: @(Model.Venue?.Capacity ?? 0)
                    </span>
                </div>
            </div>

            @if (seatedTypes.Any())
            {
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <h3 class="text-white mb-0">💺 Seated Ticket Types</h3>
                        <span class="wizard-pill">Seats auto-generated on publish</span>
                    </div>

                    <div class="ticket-admin-list">
                        @foreach (var ticket in seatedTypes)
                        {
                            var priceLabel = ticket.Price <= 0 ? "Free" : $"{ticket.Price:N0} VND";

                            <div class="ticket-admin-card">
                                <div class="ticket-main">
                                    <div class="ticket-title-row">
                                        <h3>@ticket.Name</h3>
                                        <span class="ticket-status active">Auto-Generate</span>
                                    </div>

                                    <p class="text-muted">
                                        @ticket.Quantity seats will be generated in a grid layout
                                        (Section: <strong>@ticket.Name</strong>).
                                    </p>

                                    <div class="ticket-admin-meta">
                                        <span>Type: Assigned Seating</span>
                                        <span>Price: @priceLabel</span>
                                        <span>Quantity: @ticket.Quantity</span>
                                    </div>
                                </div>

                                <div class="ticket-admin-side">
                                    <strong>@ticket.Quantity</strong>
                                    <span>seats</span>
                                    <span class="wizard-pill mt-2" style="text-align:center;">
                                        On Publish
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (standingTypes.Any())
            {
                <div class="mb-4">
                    <h3 class="text-white mb-3">🧍 General Admission Ticket Types</h3>

                    <div class="ticket-admin-list">
                        @foreach (var ticket in standingTypes)
                        {
                            var priceLabel = ticket.Price <= 0 ? "Free" : $"{ticket.Price:N0} VND";

                            <div class="ticket-admin-card">
                                <div class="ticket-main">
                                    <div class="ticket-title-row">
                                        <h3>@ticket.Name</h3>
                                        <span class="ticket-status" style="background:rgba(59,130,246,0.15);color:#60A5FA;">
                                            No Seats
                                        </span>
                                    </div>

                                    <p class="text-muted">
                                        General admission — no individual seat assignment required.
                                    </p>

                                    <div class="ticket-admin-meta">
                                        <span>Type: General Admission</span>
                                        <span>Price: @priceLabel</span>
                                        <span>Quantity: @ticket.Quantity</span>
                                    </div>
                                </div>

                                <div class="ticket-admin-side">
                                    <strong>Skipped</strong>
                                    <span>no seats needed</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (!Model.TicketTypes.Any())
            {
                <div class="organizer-empty mb-4">
                    <h2>No ticket types found</h2>
                    <p>Please go back and add at least one ticket type.</p>
                </div>
            }

            <div class="wizard-card mb-4" style="border-left: 3px solid #10B981;">
                <div class="d-flex align-items-start gap-3">
                    <span style="font-size:1.5rem;">ℹ️</span>
                    <div>
                        <h4 style="color:#10B981;">Automatic Seat Generation</h4>
                        <p class="text-muted mb-0">
                            When you publish the event, the system will automatically generate
                            <strong>@totalSeats seat(s)</strong> across <strong>@seatedTypes.Count section(s)</strong>.
                            Each section name will match the ticket type name, making it easy to identify on the venue map.
                        </p>
                    </div>
                </div>
            </div>

            <div class="wizard-actions">
                <a asp-controller="EventWizard"
                   asp-action="Step4"
                   class="wizard-btn-secondary">
                    ← Back
                </a>

                <form asp-controller="EventWizard"
                      asp-action="Step5Continue"
                      method="post">

                    <button type="submit"
                            class="wizard-btn-primary"
                            @(!Model.CanContinue ? "disabled" : "")>
                        Continue to Map →
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>
